{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kainnne-gemini",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://wikinb.kainnne.com,https://kainnne.github.io,http://localhost:4321",
    "OWNER_EMAIL": "ryanzhu@kainnne.com",
    "EMAIL_FROM": "Kainnne × Gemini <login@auth.kainnne.com>",
    "EMAIL_REPLY_TO": "ryanzhu@kainnne.com",
    "WIKI_SEARCH_URL": "https://wikinb.kainnne.com/search/",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "MAX_CHAT_TURNS": "5",
    "DAILY_TOKEN_LIMIT": "60000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wikinb-guest-ai",
      "database_id": "54ba9cb8-d32d-4259-a626-284b93d53283"
    }
  ]
}
