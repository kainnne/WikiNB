{
  "name": "wikinb",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "preview": "astro preview",
    "test": "node scripts/test-nav-auth-visibility.mjs && node scripts/test-gemini-budget.mjs && node scripts/test-kaine-chat-policy.mjs",
    "wiki:check": "node scripts/validate-wiki-links.mjs",
    "knowledge:scan": "node scripts/project-knowledge-scan.mjs",
    "knowledge:baseline": "node scripts/project-knowledge-scan.mjs --write-state",
    "bridge:install": "npm install --prefix bridge",
    "bridge": "npm run start --prefix bridge",
    "bridge:dev": "npm run dev --prefix bridge"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/iansui": "^5.2.8",
    "astro": "^5.7.10",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "marked": "^15.0.7",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
