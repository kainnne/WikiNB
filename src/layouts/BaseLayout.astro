---
import '../styles/global.css';
import Header from '../components/Header.astro';
import bridgeConfig from '../../config/sites.json';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  visitorNav?: boolean;
  publicSection?: 'wiki' | 'gemini' | 'login';
}

const {
  title,
  description = '一個由 Kaine 設計的個人知識系統。',
  pageClass = '',
  visitorNav = false,
  publicSection = 'wiki',
} = Astro.props;
const fullTitle = title === 'Kainnne' || title === 'WikiNB' ? title : `${title} · WikiNB`;
const bridgeJson = JSON.stringify({
  url: bridgeConfig.bridge.url,
  productionUrl: bridgeConfig.bridge.productionUrl,
  guestAiUrl: bridgeConfig.bridge.guestAiUrl,
});
---

<!doctype html>
<html lang="zh-Hant" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.85em' x='15' font-size='72' font-family='sans-serif' fill='%23ec407a'>K</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@600;700&family=Nunito:wght@400;600;700&family=Quicksand:wght@500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <title>{fullTitle}</title>
    <script id="bridge-config" type="application/json" set:html={bridgeJson}></script>
  </head>
  <body
    class:list={[
      'bg-blobs',
      pageClass,
      visitorNav && 'visitor-nav home-page home-guest',
    ]}
  >
    <Header visitorNav={visitorNav} publicSection={publicSection} />
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-24 md:px-8">
      <slot />
    </main>
  </body>
</html>
