---
import '../styles/global.css';
import Header from '../components/Header.astro';
import bridgeConfig from '../../config/sites.json';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  visitorNav?: boolean;
  publicSection?: 'wiki' | 'gemini' | 'login';
}

const {
  title,
  description = '一個由 Kaine 設計的個人知識系統。',
  pageClass = '',
  visitorNav = false,
  publicSection = 'wiki',
} = Astro.props;
const fullTitle = title === 'Kainnne' || title === 'WikiNB' ? title : `${title} · WikiNB`;
const brandImage = 'https://kainnne.com/brand/kainnne-mark.png';
const pageUrl = new URL(Astro.url.pathname, 'https://wikinb.kainnne.com').href;
const bridgeJson = JSON.stringify({
  url: bridgeConfig.bridge.url,
  productionUrl: bridgeConfig.bridge.productionUrl,
  guestAiUrl: bridgeConfig.bridge.guestAiUrl,
});
---

<!doctype html>
<html lang="zh-Hant" translate="no" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <meta name="googlebot" content="notranslate" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={brandImage} />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content="Kainnne flowing ribbon K brand mark" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={brandImage} />
    <link rel="icon" type="image/png" href={brandImage} />
    <link rel="apple-touch-icon" href={brandImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@600;700&family=Nunito:wght@400;600;700&family=Quicksand:wght@500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <title>{fullTitle}</title>
    <script id="bridge-config" type="application/json" set:html={bridgeJson}></script>
  </head>
  <body
    class:list={[
      'bg-blobs',
      pageClass,
      visitorNav && 'visitor-nav home-page home-guest',
    ]}
  >
    <Header visitorNav={visitorNav} publicSection={publicSection} />
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-24 md:px-8">
      <slot />
    </main>
  </body>
</html>
