---
import sites from '../../config/sites.json';

const base = import.meta.env.BASE_URL;
const meUrl = sites.sites.me.url;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/40 bg-white/40 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 py-3 md:px-8">
    <a href={base} class="group shrink-0">
      <span class="font-display text-xl font-bold bg-gradient-to-r from-pink-500 to-lavender-400 bg-clip-text text-transparent transition-opacity group-hover:opacity-80">
        Kainnne
      </span>
    </a>

    <nav class="flex max-w-[75%] flex-wrap items-center justify-end gap-1 md:max-w-none md:gap-2">
      <a href={`${base}search`} class="nav-wikinb">WikiNB</a>
      <a
        id="nav-about"
        href={meUrl}
        class="nav-about"
        target="_blank"
        rel="noopener noreferrer"
      >
        About Me
      </a>
      <a
        id="nav-github"
        href="https://github.com/zx50416"
        class="nav-github"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a id="nav-add-note" href={`${base}add-note`} class="nav-chroma hidden">
        <span class="nav-chroma-label">+ md.</span>
      </a>
      <a id="nav-codex" href={`${base}codex`} class="nav-chroma hidden">
        <span class="nav-chroma-label">Codex</span>
      </a>
      <a id="nav-login" href={`${base}login`} class="nav-link">登入</a>
      <button id="nav-logout" type="button" class="nav-link hidden">登出</button>
    </nav>
  </div>
</header>

<script>
  import { mountNavAuth } from '../scripts/bridge-client.js';
  mountNavAuth();
</script>

<style>
  .nav-link {
    @apply rounded-full px-2.5 py-1.5 text-xs font-semibold text-berry-700 transition-colors hover:bg-pink-100/60 hover:text-pink-700 sm:px-3 sm:py-2 sm:text-sm md:px-4;
  }

  .nav-wikinb {
    @apply rounded-full bg-gradient-to-r from-pink-400 to-lavender-400 px-3 py-1.5 text-xs font-bold text-white shadow-glow transition-all hover:scale-105 hover:shadow-glass-lg sm:px-4 sm:py-2 sm:text-sm md:px-5;
  }

  .nav-about,
  .nav-github {
    @apply rounded-full bg-gradient-to-r from-teal-400 to-cyan-500 px-3 py-1.5 text-xs font-bold text-white shadow-[0_0_20px_rgba(45,212,191,0.35)] transition-all hover:scale-105 hover:shadow-[0_0_28px_rgba(34,211,238,0.45)] sm:px-4 sm:py-2 sm:text-sm md:px-5;
  }

  /* 黑底 + 彩色字（對齊 KCIS Gemini CTA 精神） */
  .nav-chroma {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid transparent;
    padding: 0.4rem 0.85rem;
    text-decoration: none;
    background:
      linear-gradient(#111111, #111111) padding-box,
      linear-gradient(120deg, #4285f4, #9b72cb, #d96570, #fbbc05, #34a853, #4285f4) border-box;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    font-size: 0.75rem;
    font-weight: 800;
  }

  @media (min-width: 640px) {
    .nav-chroma {
      padding: 0.45rem 1rem;
      font-size: 0.875rem;
    }
  }

  .nav-chroma::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(
      120deg,
      rgba(66, 133, 244, 0.12),
      rgba(155, 114, 203, 0.14),
      rgba(217, 101, 112, 0.1),
      rgba(251, 188, 5, 0.1),
      rgba(52, 168, 83, 0.1)
    );
    opacity: 0.9;
  }

  .nav-chroma-label {
    position: relative;
    z-index: 2;
    letter-spacing: 0.02em;
    white-space: nowrap;
    background: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nav-chroma:hover,
  .nav-chroma:focus-visible {
    transform: translateY(-1px) scale(1.03);
    box-shadow: 0 12px 26px rgba(123, 97, 255, 0.28);
    outline: none;
  }
</style>
