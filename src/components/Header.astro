---
import sites from '../../config/sites.json';

interface Props {
  visitorNav?: boolean;
  publicSection?: 'wiki' | 'gemini' | 'login';
}

const { visitorNav = false, publicSection = 'wiki' } = Astro.props;
const base = import.meta.env.BASE_URL;
const meUrl = sites.sites.me.url;
const aboutLabel = visitorNav ? 'kainnne.com' : 'About Me';
const loginLabel = visitorNav ? '私人登入' : '登入';
const loginI18nKey = visitorNav ? 'nav.ownerLogin' : 'nav.login';
const showGuestAiNav = !visitorNav || publicSection === 'gemini' || publicSection === 'login';
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50 border-b border-white/40 bg-white/40 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 py-3 md:px-8">
    <a
      id="brand-link"
      href={base}
      class="brand-link group shrink-0"
      aria-label="Kainnne home"
    >
      <img
        class="brand-logo"
        src={`${base}brand/kainnne-wordmark.png`}
        alt="Kainnne"
        width="3072"
        height="996"
        decoding="async"
      />
    </a>

    <nav class="flex max-w-[75%] flex-wrap items-center justify-end gap-1 md:max-w-none md:gap-2">
      <a
        id="nav-management"
        href={`${base}rename`}
        class="nav-management"
        hidden
        aria-hidden="true"
        data-i18n="home.management"
      >Management</a>
      <a
        id="nav-wikinb"
        href={`${base}search`}
        class:list={[
          'nav-wikinb',
          visitorNav && 'nav-public-link',
          visitorNav && (publicSection === 'wiki' ? 'is-public-active' : 'is-public-muted'),
        ]}
      >
        <span class="nav-wikinb-label">WikiNB</span>
      </a>
      <a
        id="nav-gemini"
        href={`${base}gemini`}
        class:list={[
          'nav-gemini',
          visitorNav && 'nav-public-link',
          visitorNav && (publicSection === 'gemini' ? 'is-public-active' : 'is-public-muted'),
        ]}
        data-guest-visible={showGuestAiNav ? 'true' : 'false'}
        hidden={!showGuestAiNav}
      >
        <span
          class="nav-gemini-label"
          data-i18n={visitorNav ? 'nav.guestAi' : undefined}
        >{visitorNav ? '訪客 AI' : 'Kainnne x Gemini'}</span>
      </a>
      <div id="nav-menu" class="nav-menu">
        <button
          id="nav-menu-btn"
          type="button"
          class="nav-menu-btn"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="nav-menu-panel"
          data-i18n-aria="nav.menu"
          data-i18n-title="nav.menu"
          title="選單"
          aria-label="選單"
        >
          <span class="nav-menu-bars" aria-hidden="true"></span>
        </button>
        <div id="nav-menu-panel" class="nav-menu-panel" hidden>
          <a id="nav-login" href={`${base}login`} class="nav-menu-item" data-i18n={loginI18nKey}>{loginLabel}</a>
          <a
            id="nav-menu-home"
            href={base}
            class="nav-menu-item nav-member-menu-item hidden"
            data-i18n="nav.workspaceHome"
          >工作區首頁</a>
          <a
            id="nav-menu-codex"
            href={`${base}codex`}
            class="nav-menu-item nav-member-menu-item hidden"
          >Kainnne x Codex</a>
          <a
            id="nav-menu-search"
            href={`${base}search`}
            class="nav-menu-item nav-member-menu-item hidden"
            data-i18n="nav.browseWiki"
          >瀏覽 WikiNB</a>
          <button
            id="nav-menu-logout"
            type="button"
            class="nav-menu-item nav-member-menu-item hidden w-full text-left"
            data-i18n="nav.logout"
          >登出</button>
          <a
            id="nav-about"
            href={meUrl}
            class="nav-menu-item"
            target="_blank"
            rel="noopener noreferrer"
          >
            {aboutLabel}
          </a>
          <a
            id="nav-github"
            href="https://github.com/kainnne"
            class="nav-menu-item"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </div>
      </div>
      <button id="btn-lang" type="button" class="nav-lang" title="Switch to English" data-i18n-title="nav.langTitle">
        English
      </button>
    </nav>
  </div>
</header>

<div class="member-shell-atmosphere" aria-hidden="true">
  <span class="member-shell-glow member-shell-glow-a"></span>
  <span class="member-shell-glow member-shell-glow-b"></span>
  <span class="member-shell-glow member-shell-glow-c"></span>
</div>

<script>
  import { mountI18n } from '../scripts/i18n.js';
  import { mountNavAuth } from '../scripts/bridge-client.js';
  mountI18n();
  mountNavAuth();

  /** 右上角下拉選單：登入 / About Me / GitHub */
  function mountNavMenu() {
    const wrap = document.getElementById('nav-menu');
    const btn = document.getElementById('nav-menu-btn');
    const panel = document.getElementById('nav-menu-panel');
    if (!wrap || !btn || !panel) return;

    const setOpen = (open) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      wrap.classList.toggle('is-open', open);
    };

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      setOpen(panel.hidden);
    });

    document.addEventListener('click', (e) => {
      if (panel.hidden) return;
      if (!wrap.contains(e.target)) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    panel.addEventListener('click', () => setOpen(false));
  }

  mountNavMenu();

  function mountHeaderScrollBehavior() {
    const header = document.getElementById('site-header');
    if (!header) return;
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = Math.max(0, window.scrollY);
      const delta = y - lastY;
      const menuOpen = document.getElementById('nav-menu')?.classList.contains('is-open');
      const chatLocked = document.body.classList.contains('gemini-fs-active') || document.body.classList.contains('codex-fs-active');
      header.classList.toggle('is-scrolled', y > 12);

      if (y <= 12 || menuOpen || chatLocked || delta < -6) {
        header.classList.remove('is-scroll-hidden');
      } else if (y > 88 && delta > 6) {
        header.classList.add('is-scroll-hidden');
      }

      lastY = y;
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }, { passive: true });
    header.addEventListener('focusin', () => header.classList.remove('is-scroll-hidden'));
    window.addEventListener('pageshow', update);
    update();
  }

  mountHeaderScrollBehavior();
</script>

<style>
  .site-header {
    transition: transform 0.24s ease, background-color 0.24s ease, box-shadow 0.24s ease;
    will-change: transform;
  }

  .site-header.is-scroll-hidden {
    transform: translateY(calc(-100% - 0.5rem));
  }

  .site-header.is-scrolled {
    background: rgba(255, 250, 253, 0.92);
    box-shadow: 0 10px 30px rgba(91, 52, 82, 0.08);
    backdrop-filter: blur(24px) saturate(1.25);
  }

  .nav-management {
    display: none;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 9999px;
    padding: 0.45rem 1rem;
    color: #5f3c54;
    background: linear-gradient(120deg, rgba(246, 200, 255, 0.82), rgba(255, 183, 206, 0.86), rgba(201, 255, 240, 0.76));
    box-shadow:
      0 9px 24px rgba(164, 91, 148, 0.14),
      inset 0 1px rgba(255, 255, 255, 0.76);
    font-size: 0.75rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-management.is-auth-visible {
    display: inline-flex;
  }

  .nav-management[hidden] {
    display: none !important;
  }

  .nav-management:hover,
  .nav-management:focus-visible {
    transform: translateY(-2px);
    box-shadow:
      0 14px 30px rgba(164, 91, 148, 0.2),
      inset 0 1px rgba(255, 255, 255, 0.82);
    outline: none;
  }

  /* 品牌：共用完整 Kainnne 字標，連結行為維持回到首頁。 */
  .brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .brand-logo {
    display: block;
    width: 7.5rem;
    height: auto;
    filter: drop-shadow(0 6px 14px rgba(128, 91, 166, 0.12));
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  @media (min-width: 640px) {
    .brand-logo {
      width: 9rem;
    }
  }

  .brand-link:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .brand-link:hover .brand-logo,
  .brand-link:focus-visible .brand-logo {
    filter: drop-shadow(0 9px 18px rgba(128, 91, 166, 0.18));
    transform: scale(1.02);
  }

  /* WikiNB：未登入時沿用公開站的柔和粉色入口。 */
  .nav-wikinb {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    padding: 0.4rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(90deg, #f48fb1, #ce93d8);
    box-shadow: 0 0 24px rgba(255, 183, 197, 0.5);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  @media (min-width: 640px) {
    .nav-wikinb {
      padding: 0.45rem 1.1rem;
      font-size: 0.875rem;
    }
  }

  .nav-wikinb-label {
    position: relative;
    z-index: 2;
  }

  .nav-wikinb:hover,
  .nav-wikinb:focus-visible {
    transform: scale(1.05);
  }

  /* Kainnne x Gemini：白底彩字（未登入才顯示） */
  .nav-gemini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(183, 148, 244, 0.34);
    border-radius: 9999px;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.88);
    box-shadow:
      0 6px 18px rgba(123, 97, 255, 0.12),
      0 0 18px rgba(110, 168, 255, 0.1);
    font-size: 0.75rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .nav-gemini[hidden] {
    display: none !important;
  }

  @media (min-width: 640px) {
    .nav-gemini {
      padding: 0.45rem 1.1rem;
      font-size: 0.875rem;
    }
  }

  .nav-gemini-label {
    background: linear-gradient(105deg, #4285f4 0%, #9b72cb 38%, #d96570 67%, #34a853 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .nav-gemini:hover,
  .nav-gemini:focus-visible {
    transform: translateY(-1px) scale(1.03);
    background: #fff;
    box-shadow:
      0 10px 26px rgba(123, 97, 255, 0.18),
      0 0 22px rgba(66, 133, 244, 0.14);
    outline: none;
  }

  /* 右上角下拉選單 */
  .nav-menu {
    position: relative;
    display: inline-flex;
  }

  .nav-menu[hidden] {
    display: none !important;
  }

  .nav-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid rgba(244, 143, 177, 0.45);
    background: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .nav-menu-btn:hover,
  .nav-menu.is-open .nav-menu-btn {
    transform: translateY(-1px);
    background: #fff;
    border-color: rgba(206, 147, 216, 0.8);
  }

  .nav-menu-bars,
  .nav-menu-bars::before,
  .nav-menu-bars::after {
    display: block;
    width: 1rem;
    height: 2px;
    border-radius: 9999px;
    background: linear-gradient(90deg, #f48fb1, #ce93d8);
  }

  .nav-menu-bars {
    position: relative;
  }

  .nav-menu-bars::before,
  .nav-menu-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-menu-bars::before {
    top: -5px;
  }

  .nav-menu-bars::after {
    top: 5px;
  }

  .nav-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 60;
    display: flex;
    flex-direction: column;
    min-width: 10rem;
    padding: 0.35rem;
    border-radius: 1rem;
    border: 1px solid rgba(244, 143, 177, 0.35);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    box-shadow: 0 16px 34px rgba(123, 97, 255, 0.18);
  }

  .nav-menu-panel[hidden] {
    display: none;
  }

  .nav-menu-item {
    @apply rounded-xl px-3 py-2 text-sm font-semibold text-berry-700 transition-colors hover:bg-pink-100/70 hover:text-pink-700;
    text-decoration: none;
    white-space: nowrap;
  }

  button.nav-menu-item {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
  }

  .nav-menu-item.hidden {
    display: none;
  }

  .nav-lang {
    @apply inline-flex items-center justify-center rounded-full border border-pink-200/80 bg-white/70 px-2.5 py-1.5 text-xs font-bold text-berry-700 transition hover:bg-pink-50 hover:border-pink-300 sm:px-3 sm:py-2 sm:text-sm;
    min-width: 4.5rem;
    cursor: pointer;
    font-family: inherit;
  }

  .nav-lang:hover {
    transform: translateY(-1px);
  }

  .member-shell-atmosphere {
    display: none;
  }

  :global(body.member-shell) {
    isolation: isolate;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 10% 22%, rgba(205, 220, 255, 0.84), transparent 29%),
      radial-gradient(circle at 89% 12%, rgba(255, 210, 232, 0.82), transparent 32%),
      radial-gradient(circle at 72% 78%, rgba(201, 255, 240, 0.66), transparent 30%),
      linear-gradient(145deg, #fffafd 0%, #fff4fa 46%, #f7f2ff 100%);
  }

  :global(body.member-shell)::before,
  :global(body.member-shell)::after {
    display: none;
  }

  :global(body.member-shell) .member-shell-atmosphere {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    overflow: hidden;
    pointer-events: none;
  }

  :global(body.member-shell) .member-shell-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(3.5rem);
    opacity: 0.42;
  }

  :global(body.member-shell) .member-shell-glow-a {
    top: 10%;
    left: -9rem;
    width: 28rem;
    height: 28rem;
    background: #b9cbff;
  }

  :global(body.member-shell) .member-shell-glow-b {
    top: -10rem;
    right: 3%;
    width: 31rem;
    height: 31rem;
    background: #ffc4dc;
  }

  :global(body.member-shell) .member-shell-glow-c {
    right: 18%;
    bottom: -13rem;
    width: 28rem;
    height: 28rem;
    background: #bdf7e7;
  }

  /* 公開首頁與登入後工作區共用的玻璃導覽語言。 */
  :global(body.home-page.home-guest) header {
    top: 0;
    border: 0;
    background: transparent;
    backdrop-filter: none;
    pointer-events: none;
  }

  :global(body.home-page.home-guest) header.site-header.is-scrolled {
    background: rgba(255, 250, 253, 0.92);
    box-shadow: 0 10px 30px rgba(91, 52, 82, 0.08);
    backdrop-filter: blur(24px) saturate(1.25);
  }

  :global(body.home-page.home-guest) header > div {
    max-width: none;
    justify-content: space-between;
    padding: 1rem clamp(1rem, 3vw, 2.5rem);
  }

  :global(body.home-page.home-guest) #nav-logout {
    display: none !important;
  }

  :global(body.home-page.home-guest) .brand-link {
    position: relative;
    display: inline-flex;
    min-height: 3.65rem;
    align-items: center;
    align-self: flex-start;
    padding: 0.2rem 0.35rem;
    pointer-events: auto;
  }

  :global(body.home-page.home-guest) .brand-logo {
    width: clamp(8rem, 14vw, 10.5rem);
    filter: drop-shadow(0 10px 22px rgba(128, 91, 166, 0.16));
  }

  :global(body.home-page.home-guest) .brand-link:hover,
  :global(body.home-page.home-guest) .brand-link:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }

  :global(body.home-page.home-guest) .brand-link:hover .brand-logo,
  :global(body.home-page.home-guest) .brand-link:focus-visible .brand-logo {
    filter: drop-shadow(0 14px 28px rgba(128, 91, 166, 0.22));
    transform: scale(1.035);
  }

  :global(body.home-page.home-guest) header nav {
    width: auto;
    max-width: calc(100vw - 2rem);
    flex-wrap: nowrap;
    gap: 0.3rem;
    padding: 0.38rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.46);
    box-shadow:
      0 16px 48px rgba(112, 66, 104, 0.1),
      inset 0 1px rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(24px) saturate(1.35);
    pointer-events: auto;
  }

  :global(body.home-page.home-guest) #nav-wikinb,
  :global(body.home-page.home-guest) #nav-gemini,
  :global(body.home-page.home-guest) #nav-management,
  :global(body.home-page.home-guest) #btn-lang,
  :global(body.home-page.home-guest) #nav-menu {
    flex: 0 0 auto;
  }

  :global(body.home-page.home-guest) #nav-wikinb,
  :global(body.home-page.home-guest) #nav-gemini {
    order: 1;
    min-width: 5.8rem;
    min-height: 2.75rem;
    padding: 0 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 1rem;
    color: #4a2038;
    background: transparent;
    box-shadow: none;
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.025em;
  }

  :global(body.home-page.home-guest) #nav-gemini {
    order: 2;
  }

  :global(body.home-page.home-guest) #nav-management {
    order: 1;
    min-width: 7.2rem;
    min-height: 2.75rem;
    padding: 0 1.15rem;
    border-radius: 1rem;
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  :global(body.home-page.home-guest) #nav-wikinb.is-public-active,
  :global(body.home-page.home-guest) #nav-gemini.is-public-active {
    background: linear-gradient(
      120deg,
      rgba(246, 200, 255, 0.82),
      rgba(255, 183, 206, 0.86),
      rgba(201, 255, 240, 0.76)
    );
    box-shadow:
      0 9px 24px rgba(164, 91, 148, 0.14),
      inset 0 1px rgba(255, 255, 255, 0.76);
  }

  :global(body.home-page.home-guest) #nav-wikinb.is-public-muted,
  :global(body.home-page.home-guest) #nav-gemini.is-public-muted {
    border-color: transparent;
  }

  :global(body.home-page.home-guest) #nav-gemini .nav-gemini-label {
    background: none;
    color: #5f3c54;
    -webkit-text-fill-color: currentColor;
  }

  :global(body.home-page.home-guest) #nav-wikinb:hover,
  :global(body.home-page.home-guest) #nav-wikinb:focus-visible,
  :global(body.home-page.home-guest) #nav-gemini:hover,
  :global(body.home-page.home-guest) #nav-gemini:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.58);
    background: rgba(255, 255, 255, 0.38);
    box-shadow:
      0 14px 30px rgba(164, 91, 148, 0.2),
      inset 0 1px rgba(255, 255, 255, 0.82);
  }

  :global(body.home-page.home-guest) #btn-lang {
    order: 3;
    min-width: 6.6rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid transparent;
    border-radius: 1rem;
    background: transparent;
    color: #5f3c54;
    font-family: Quicksand, 'Noto Sans TC', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    box-shadow: none;
  }

  :global(body.home-page.home-guest) #btn-lang:hover,
  :global(body.home-page.home-guest) #btn-lang:focus-visible {
    border-color: rgba(255, 255, 255, 0.58);
    background: rgba(255, 255, 255, 0.36);
    transform: translateY(-2px);
  }

  :global(body.home-page.home-guest) #nav-menu {
    order: 4;
  }

  :global(body.home-page.home-guest) .nav-menu-btn {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid transparent;
    border-radius: 1rem;
    background: transparent;
  }

  :global(body.home-page.home-guest) .nav-menu-btn:hover,
  :global(body.home-page.home-guest) .nav-menu-btn:focus-visible,
  :global(body.home-page.home-guest) .nav-menu.is-open .nav-menu-btn {
    border-color: rgba(255, 255, 255, 0.58);
    background: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
