---
import sites from '../../config/sites.json';

const base = import.meta.env.BASE_URL;
const meUrl = sites.sites.me.url;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/40 bg-white/40 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 py-3 md:px-8">
    <a id="brand-link" href={base} class="brand-link group shrink-0">
      <span id="brand-label" class="brand-label">Kainnne</span>
      <span id="brand-home" class="brand-home is-home-hidden" aria-hidden="true">© HOME</span>
    </a>

    <nav class="flex max-w-[75%] flex-wrap items-center justify-end gap-1 md:max-w-none md:gap-2">
      <a id="nav-wikinb" href={`${base}search`} class="nav-wikinb">
        <span class="nav-wikinb-label">WikiNB</span>
      </a>
      <a id="nav-gemini" href={`${base}gemini`} class="nav-gemini">
        <span class="nav-gemini-label">Kainnne x Gemini</span>
      </a>
      <a id="nav-add-note" href={`${base}add-note`} class="nav-chroma" hidden aria-hidden="true">
        <span class="nav-chroma-label">+ md.</span>
      </a>
      <a id="nav-codex" href={`${base}codex`} class="nav-chroma" hidden aria-hidden="true">
        <span class="nav-chroma-label">Codex</span>
      </a>
      <div id="nav-menu" class="nav-menu">
        <button
          id="nav-menu-btn"
          type="button"
          class="nav-menu-btn"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="nav-menu-panel"
          data-i18n-aria="nav.menu"
          data-i18n-title="nav.menu"
          title="選單"
          aria-label="選單"
        >
          <span class="nav-menu-bars" aria-hidden="true"></span>
        </button>
        <div id="nav-menu-panel" class="nav-menu-panel" hidden>
          <a id="nav-login" href={`${base}login`} class="nav-menu-item" data-i18n="nav.login">登入</a>
          <a
            id="nav-about"
            href={meUrl}
            class="nav-menu-item"
            target="_blank"
            rel="noopener noreferrer"
          >
            About Me
          </a>
          <a
            id="nav-github"
            href="https://github.com/kainnne"
            class="nav-menu-item"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </div>
      </div>
      <button id="nav-logout" type="button" class="nav-link hidden" data-i18n="nav.logout">登出</button>
      <button id="btn-lang" type="button" class="nav-lang" title="Switch to English" data-i18n-title="nav.langTitle">
        English
      </button>
    </nav>
  </div>
</header>

<script>
  import { mountI18n } from '../scripts/i18n.js';
  import { mountNavAuth } from '../scripts/bridge-client.js';
  mountI18n();
  mountNavAuth();

  /** 依實際網址判斷是否在首頁；多一段 /xxx 就顯示 © HOME（不改整站架構） */
  function syncBrandHome() {
    const el = document.getElementById('brand-home');
    if (!el) return;
    const base = (document.documentElement.dataset.base || '/').replace(/\/+$/, '');
    let path = window.location.pathname.replace(/\/+$/, '');
    if (path.endsWith('/index.html')) {
      path = path.slice(0, -'/index.html'.length).replace(/\/+$/, '');
    }
    const home = base || '';
    const isHome = path === home || path === '' || path === '/';
    el.classList.toggle('is-home-hidden', isHome);
    el.setAttribute('aria-hidden', isHome ? 'true' : 'false');
  }

  syncBrandHome();
  window.addEventListener('pageshow', syncBrandHome);

  /** 右上角下拉選單：登入 / About Me / GitHub */
  function mountNavMenu() {
    const wrap = document.getElementById('nav-menu');
    const btn = document.getElementById('nav-menu-btn');
    const panel = document.getElementById('nav-menu-panel');
    if (!wrap || !btn || !panel) return;

    const setOpen = (open) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      wrap.classList.toggle('is-open', open);
    };

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      setOpen(panel.hidden);
    });

    document.addEventListener('click', (e) => {
      if (panel.hidden) return;
      if (!wrap.contains(e.target)) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    panel.addEventListener('click', () => setOpen(false));
  }

  mountNavMenu();
</script>

<style>
  .nav-link {
    @apply rounded-full px-2.5 py-1.5 text-xs font-semibold text-berry-700 transition-colors hover:bg-pink-100/60 hover:text-pink-700 sm:px-3 sm:py-2 sm:text-sm md:px-4;
  }

  /* 品牌：恆為彩字（登入前後相同） */
  .brand-link {
    display: inline-flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.35rem;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .brand-label,
  .brand-home {
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-weight: 700;
    background: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .brand-label {
    font-size: 1.55rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .brand-home {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1.2;
    padding: 0 0 0.12rem;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    outline: none;
    background: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }

  .brand-home.is-home-hidden {
    display: none;
  }

  @media (min-width: 640px) {
    .brand-label {
      font-size: 1.75rem;
    }

    .brand-home {
      font-size: 0.85rem;
      padding-bottom: 0.14rem;
    }
  }

  .brand-link:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  /* 未登入：粉紅實心；登入後：黑底彩字 */
  .nav-wikinb {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    padding: 0.4rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(90deg, #f48fb1, #ce93d8);
    box-shadow: 0 0 24px rgba(255, 183, 197, 0.5);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  @media (min-width: 640px) {
    .nav-wikinb {
      padding: 0.45rem 1.1rem;
      font-size: 0.875rem;
    }
  }

  .nav-wikinb-label {
    position: relative;
    z-index: 2;
  }

  .nav-wikinb.is-logged {
    border: 1px solid transparent;
    color: transparent;
    background:
      linear-gradient(#111111, #111111) padding-box,
      linear-gradient(120deg, #4285f4, #9b72cb, #d96570, #fbbc05, #34a853, #4285f4) border-box;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
  }

  .nav-wikinb.is-logged::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(
      120deg,
      rgba(66, 133, 244, 0.12),
      rgba(155, 114, 203, 0.14),
      rgba(217, 101, 112, 0.1),
      rgba(251, 188, 5, 0.1),
      rgba(52, 168, 83, 0.1)
    );
  }

  .nav-wikinb.is-logged .nav-wikinb-label {
    background: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nav-wikinb:hover,
  .nav-wikinb:focus-visible {
    transform: scale(1.05);
  }

  /* Kainnne x Gemini：白底彩字（未登入才顯示） */
  .nav-gemini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(183, 148, 244, 0.34);
    border-radius: 9999px;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.88);
    box-shadow:
      0 6px 18px rgba(123, 97, 255, 0.12),
      0 0 18px rgba(110, 168, 255, 0.1);
    font-size: 0.75rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .nav-gemini[hidden] {
    display: none !important;
  }

  @media (min-width: 640px) {
    .nav-gemini {
      padding: 0.45rem 1.1rem;
      font-size: 0.875rem;
    }
  }

  .nav-gemini-label {
    background: linear-gradient(105deg, #4285f4 0%, #9b72cb 38%, #d96570 67%, #34a853 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .nav-gemini:hover,
  .nav-gemini:focus-visible {
    transform: translateY(-1px) scale(1.03);
    background: #fff;
    box-shadow:
      0 10px 26px rgba(123, 97, 255, 0.18),
      0 0 22px rgba(66, 133, 244, 0.14);
    outline: none;
  }

  /* 右上角下拉選單 */
  .nav-menu {
    position: relative;
    display: inline-flex;
  }

  .nav-menu[hidden] {
    display: none !important;
  }

  .nav-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid rgba(244, 143, 177, 0.45);
    background: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .nav-menu-btn:hover,
  .nav-menu.is-open .nav-menu-btn {
    transform: translateY(-1px);
    background: #fff;
    border-color: rgba(206, 147, 216, 0.8);
  }

  .nav-menu-bars,
  .nav-menu-bars::before,
  .nav-menu-bars::after {
    display: block;
    width: 1rem;
    height: 2px;
    border-radius: 9999px;
    background: linear-gradient(90deg, #f48fb1, #ce93d8);
  }

  .nav-menu-bars {
    position: relative;
  }

  .nav-menu-bars::before,
  .nav-menu-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-menu-bars::before {
    top: -5px;
  }

  .nav-menu-bars::after {
    top: 5px;
  }

  .nav-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 60;
    display: flex;
    flex-direction: column;
    min-width: 10rem;
    padding: 0.35rem;
    border-radius: 1rem;
    border: 1px solid rgba(244, 143, 177, 0.35);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    box-shadow: 0 16px 34px rgba(123, 97, 255, 0.18);
  }

  .nav-menu-panel[hidden] {
    display: none;
  }

  .nav-menu-item {
    @apply rounded-xl px-3 py-2 text-sm font-semibold text-berry-700 transition-colors hover:bg-pink-100/70 hover:text-pink-700;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-menu-item.hidden {
    display: none;
  }

  .nav-chroma {
    position: relative;
    isolation: isolate;
    /* 預設隱藏；登入後才顯示（避免 scoped display 蓋過 Tailwind .hidden） */
    display: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid transparent;
    padding: 0.4rem 0.85rem;
    text-decoration: none;
    background:
      linear-gradient(#111111, #111111) padding-box,
      linear-gradient(120deg, #4285f4, #9b72cb, #d96570, #fbbc05, #34a853, #4285f4) border-box;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .nav-chroma.is-auth-visible {
    display: inline-flex;
  }

  .nav-chroma[hidden] {
    display: none !important;
  }

  @media (min-width: 640px) {
    .nav-chroma {
      padding: 0.45rem 1rem;
      font-size: 0.875rem;
    }
  }

  .nav-chroma::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(
      120deg,
      rgba(66, 133, 244, 0.12),
      rgba(155, 114, 203, 0.14),
      rgba(217, 101, 112, 0.1),
      rgba(251, 188, 5, 0.1),
      rgba(52, 168, 83, 0.1)
    );
    opacity: 0.9;
  }

  .nav-chroma-label {
    position: relative;
    z-index: 2;
    letter-spacing: 0.02em;
    white-space: nowrap;
    background: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nav-chroma:hover,
  .nav-chroma:focus-visible {
    transform: translateY(-1px) scale(1.03);
    box-shadow: 0 12px 26px rgba(123, 97, 255, 0.28);
    outline: none;
  }

  .nav-lang {
    @apply inline-flex items-center justify-center rounded-full border border-pink-200/80 bg-white/70 px-2.5 py-1.5 text-xs font-bold text-berry-700 transition hover:bg-pink-50 hover:border-pink-300 sm:px-3 sm:py-2 sm:text-sm;
    min-width: 4.5rem;
    cursor: pointer;
    font-family: inherit;
  }

  .nav-lang:hover {
    transform: translateY(-1px);
  }
</style>
