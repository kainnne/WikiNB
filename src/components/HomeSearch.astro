---
interface Props {
  placeholder?: string;
  action?: string;
  dualMode?: boolean;
}

const {
  placeholder = '輸入關鍵字，找到你的筆記…',
  action = '/search',
  dualMode = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const searchAction = action.startsWith('http') ? action : `${base}${action.replace(/^\//, '')}`;
---

<div class="home-search w-full" data-dual={dualMode ? 'true' : 'false'}>
  <form action={searchAction} method="get" class="w-full">
    <div class="relative w-full">
      <input
        type="search"
        name="q"
        placeholder={placeholder}
        data-i18n-placeholder="home.placeholder"
        class="search-input py-3 text-base sm:py-4 sm:text-lg"
        autocomplete="off"
      />
    </div>

    <div id="search-actions-single" class="guest-actions mt-4 gap-3">
      <button type="submit" class="btn-primary justify-center py-3 text-sm sm:text-base" data-i18n="search.button">
        Search
      </button>
      <a
        id="gemini-guest-btn"
        href={`${base}gemini`}
        class="btn-gemini justify-center py-3 text-sm sm:text-base"
      >
        <span class="btn-gemini-label">Kainnne x Gemini</span>
      </a>
    </div>

    <div
      id="search-actions-logged"
      class="auth-grid mt-4 gap-3"
      hidden
      aria-hidden="true"
    >
      <button type="submit" class="btn-primary justify-center py-3 text-sm sm:text-base" data-i18n="search.button">
        Search
      </button>
      <a href={`${base}rename`} class="btn-rename-nav justify-center py-3 text-sm sm:text-base" data-i18n="home.management">
        Management
      </a>
      <a
        id="add-note-launch-btn"
        href={`${base}add-note`}
        class="btn-chroma auth-cta justify-center py-3 text-sm sm:text-base"
        hidden
        aria-hidden="true"
      >
        <span class="btn-chroma-label">+ md.</span>
      </a>
      <a
        id="codex-launch-btn"
        href={`${base}codex`}
        class="btn-chroma auth-cta justify-center py-3 text-sm sm:text-base"
        hidden
        aria-hidden="true"
      >
        <span class="btn-chroma-label">Codex</span>
      </a>
    </div>
  </form>
</div>

<script>
  import { isLoggedIn, setAuthVisibility } from '../scripts/bridge-client.js';

  function updateSearchActions() {
    const dual = document.querySelector('.home-search')?.getAttribute('data-dual') === 'true';
    if (!dual) return;
    const loggedIn = isLoggedIn();
    const single = document.getElementById('search-actions-single');
    if (single) single.hidden = loggedIn;
    setAuthVisibility(document.getElementById('search-actions-logged'), loggedIn);
    setAuthVisibility(document.getElementById('add-note-launch-btn'), loggedIn);
    setAuthVisibility(document.getElementById('codex-launch-btn'), loggedIn);
  }

  updateSearchActions();
  document.addEventListener('wikinb:auth-change', updateSearchActions);
</script>

<style>
  .btn-rename-nav {
    @apply inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-teal-400 to-cyan-500 px-6 py-2.5 font-display font-semibold text-white shadow-[0_0_20px_rgba(45,212,191,0.35)] transition-all duration-300 hover:scale-[1.02] hover:from-teal-300 hover:to-cyan-400;
  }

  .btn-chroma {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.76);
    padding: 0.75rem 1.5rem;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    background: linear-gradient(
      120deg,
      rgba(246, 200, 255, 0.86),
      rgba(255, 183, 206, 0.9),
      rgba(201, 255, 240, 0.8)
    );
    box-shadow:
      0 9px 24px rgba(164, 91, 148, 0.15),
      inset 0 1px rgba(255, 255, 255, 0.8);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .btn-chroma::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0.24),
      rgba(255, 255, 255, 0.04),
      rgba(255, 255, 255, 0.2)
    );
  }

  .btn-chroma-label {
    position: relative;
    z-index: 2;
    letter-spacing: 0.02em;
    background: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .btn-chroma:hover,
  .btn-chroma:focus-visible {
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 12px 28px rgba(123, 97, 255, 0.25);
    outline: none;
  }

  .btn-gemini {
    position: relative;
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(183, 148, 244, 0.34);
    border-radius: 9999px;
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.88);
    box-shadow:
      0 8px 24px rgba(123, 97, 255, 0.12),
      0 0 22px rgba(110, 168, 255, 0.1);
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  .btn-gemini-label {
    background: linear-gradient(105deg, #4285f4 0%, #9b72cb 38%, #d96570 67%, #34a853 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: 0.01em;
  }

  .btn-gemini:hover,
  .btn-gemini:focus-visible {
    transform: translateY(-1px) scale(1.02);
    background: #fff;
    box-shadow:
      0 12px 30px rgba(123, 97, 255, 0.18),
      0 0 26px rgba(66, 133, 244, 0.14);
    outline: none;
  }

  .guest-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .guest-actions[hidden] {
    display: none !important;
  }

  /* 登入專屬 UI：預設 display:none，只有 .is-auth-visible 才給 display，
     避免 Tailwind 的 hidden / grid 這類同層級 utility 互相蓋掉。 */
  .auth-grid {
    display: none;
  }

  .auth-grid.is-auth-visible {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .auth-cta {
    display: none;
  }

  .auth-cta.is-auth-visible {
    display: inline-flex;
  }

  .auth-grid[hidden],
  .auth-cta[hidden] {
    display: none !important;
  }
</style>
