---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalog from '../../config/private-study-catalog.json';
---
<BaseLayout title="Azure AI-901" description="私人學習入口" visitorNav={true}>
  <main class="glass-card mx-auto my-8 max-w-3xl p-5 sm:p-8">
    <h1 class="text-2xl font-bold text-berry-800">Azure AI-901</h1>
    <p class="mt-3 text-sm text-berry-700/80" data-i18n="study.accessHint">邀請碼開通題庫問答；每碼限一人，生成一小時後失效。私人文章僅本人登入可開啟，不提供檔案下載。</p>
    <p id="study-status" role="status" class="my-4 text-sm text-berry-700"></p>
    <form id="study-email-form" class="space-y-3" hidden>
      <label class="block"><span data-i18n="gemini.name">名稱</span><input id="study-name" class="search-input mt-1" required minlength="2" maxlength="60" autocomplete="name" /></label>
      <label class="block"><span data-i18n="gemini.email">電子信箱</span><input id="study-email" class="search-input mt-1" type="email" required autocomplete="email" /></label>
      <button class="btn-primary" type="submit" data-i18n="gemini.sendCode">寄送驗證碼</button>
    </form>
    <form id="study-otp-form" class="space-y-3" hidden>
      <label class="block"><span data-i18n="gemini.code">6 位數驗證碼</span><input id="study-otp" class="search-input mt-1" required pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" /></label>
      <button class="btn-primary" type="submit" data-i18n="gemini.verify">驗證</button>
    </form>
    <form id="study-invite-form" class="space-y-3" hidden>
      <label class="block"><span data-i18n="study.inviteCode">六碼英數邀請碼</span><input id="study-invite" class="search-input mt-1 uppercase" required pattern="[A-Za-z0-9]{6}" maxlength="6" autocomplete="off" /></label>
      <button class="btn-primary" type="submit" data-i18n="study.unlock">開通 AI 學習</button>
    </form>
    <section id="study-workspace" hidden>
      <details id="study-outline" class="mb-5 rounded-xl border border-pink-200 p-3">
        <summary class="cursor-pointer font-semibold" data-i18n="study.outline">題庫大綱</summary>
        <input id="study-unit-search" type="search" class="search-input my-3" maxlength="100" placeholder="找單元／概念，例如 U1、RAG、語音" data-i18n-placeholder="study.searchUnits" />
        <ul id="study-unit-results" class="space-y-2"></ul>
        <p id="study-no-units" class="text-sm" hidden data-i18n="study.noUnits">沒有符合的單元</p>
      </details>
      <label class="block min-w-0"><span data-i18n="study.unit">單元</span> <select id="study-unit" class="mt-2 w-full min-w-0 rounded-lg border border-pink-200 bg-white/70 p-2"></select></label>
      <p id="study-unit-summary" class="my-3 text-sm text-berry-700"></p>
      <div class="flex flex-wrap items-center gap-3">
        <button id="study-start" type="button" class="btn-ghost" data-i18n="study.start">開始／接續</button>
        <button id="study-next" type="button" class="btn-ghost disabled:opacity-50 disabled:cursor-not-allowed" disabled data-i18n="study.next">下一題</button>
      </div>
      <form id="study-locate-form" class="mt-4 flex flex-wrap gap-2">
        <input id="study-question-id" class="search-input min-w-0 flex-1" maxlength="81" required placeholder="來源題號，例如 bank-MC02" data-i18n-placeholder="study.questionId" aria-label="來源題號" data-i18n-aria="study.questionId" />
        <button type="submit" class="btn-ghost" data-i18n="study.locate">找這題</button>
      </form>
      <div id="study-question" class="prose prose-sm my-5 max-w-none break-words text-berry-800" aria-live="polite"></div>
      <p id="study-progress" class="my-3 text-xs text-berry-700"></p>
      <form id="study-answer-form" class="flex flex-wrap items-end gap-3">
        <label class="block min-w-0 flex-1"><span data-i18n="study.answer">答案（多項以頓號分隔）</span><input id="study-answer" class="search-input mt-1" maxlength="1200" required /></label>
        <button class="btn-primary" type="submit" data-i18n="study.submit">核對答案</button>
      </form>
      <div id="study-output" class="prose prose-sm my-5 max-w-none break-words text-berry-800" aria-live="polite"></div>
      <form id="study-ask-form" class="mt-4 space-y-3">
        <label class="block"><span data-i18n="study.reason">想問這題的題意／觀念</span><textarea id="study-message" class="search-input mt-1" maxlength="1200" rows="3"></textarea></label>
        <button id="study-ask" type="submit" class="btn-ghost" data-i18n="study.ask">問 Agent</button>
      </form>
      <p class="mt-4 text-xs text-berry-700/70" data-i18n="study.source">題庫：曾慶良主任（阿亮老師）。非 Microsoft 官方題庫。</p>
    </section>
    <article id="private-article-body" class="prose max-w-none" hidden></article>
    <p id="private-article-title" class="font-semibold" hidden></p>
  </main>
  <script id="private-catalog-data" type="application/json" set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
</BaseLayout>
<script>
  import { getGuestAiSession, requestGuestAiCode, verifyGuestAiCode, setGuestAiSession, studyAccess, studyCatalog, redeemStudyInvite, askPrivateStudy } from '../scripts/guest-gemini-client.js';
  import { fetchPrivateDocument, isLoggedIn } from '../scripts/bridge-client.js';
  import { findStudyUnits, normalizeStudyUnit } from '../scripts/study-unit-routing.js';
  import DOMPurify from 'dompurify';
  import { renderMarkdownWithMath } from '../scripts/markdown-math.js';
  import { t } from '../scripts/i18n.js';
  const el = (id: string) => document.getElementById(id)!;
  const value = (id: string) => (el(id) as HTMLInputElement).value.trim();
  let expiresAt = 0, busy = false, completed = false, questionId = '', hasAnswered = false, units: any[] = [];
  const show = (id: string, on: boolean) => { el(id).hidden = !on; };
  const status = (text: string) => { el('study-status').textContent = text; };
  const markdown = (id: string, text: string) => { el(id).innerHTML = DOMPurify.sanitize(renderMarkdownWithMath(text || '')); };
  function controls(disabled: boolean) {
    document.querySelectorAll<HTMLInputElement | HTMLButtonElement | HTMLTextAreaElement | HTMLSelectElement>('main input, main button, main textarea, main select').forEach(control => { control.disabled = disabled; });
    if (!disabled) {
      (el('study-next') as HTMLButtonElement).disabled = !questionId || completed || !hasAnswered;
      for (const id of ['study-answer-form', 'study-ask-form']) el(id).querySelectorAll<HTMLInputElement | HTMLButtonElement | HTMLTextAreaElement>('input, button, textarea').forEach(control => { control.disabled = !questionId || completed; });
    }
  }
  async function run(task: () => Promise<void>) {
    if (busy) return; busy = true; controls(true);
    try { await task(); } catch (error: any) { if (error.status === 403 || error.status === 401) { lock(); show('study-otp-form', false); } status(error.message || t('study.error')); }
    finally { busy = false; controls(false); }
  }
  function clearQuestion() {
    questionId = ''; hasAnswered = false; completed = false;
    for (const id of ['study-question', 'study-output', 'study-progress']) el(id).replaceChildren();
    for (const id of ['study-answer', 'study-message']) (el(id) as HTMLInputElement).value = '';
  }
  function lock() {
    show('study-workspace', false); show('study-invite-form', Boolean(getGuestAiSession())); show('study-email-form', !getGuestAiSession());
    clearQuestion(); units = []; el('study-unit-results').replaceChildren(); el('study-unit').replaceChildren(); el('study-unit-summary').replaceChildren(); status(t('study.expired'));
  }
  function unitInfo() {
    const unit = units.find(unit => unit.unit === value('study-unit'));
    el('study-unit-summary').textContent = unit?.summary || '';
  }
  function chooseUnit(unit: string) {
    (el('study-unit') as HTMLSelectElement).value = unit; clearQuestion(); unitInfo(); controls(busy);
  }
  function renderUnitResults() {
    const results = findStudyUnits(units, value('study-unit-search'));
    el('study-unit-results').replaceChildren(); show('study-no-units', !results.length);
    for (const unit of results) {
      const item = document.createElement('li'), button = document.createElement('button');
      button.type = 'button'; button.className = 'w-full rounded-lg border border-pink-100 bg-white/50 p-3 text-left text-sm hover:bg-pink-50'; button.dataset.studyUnit = unit.unit;
      const title = document.createElement('span'); title.className = 'block font-semibold'; title.textContent = `${unit.unit}｜${unit.name} (${unit.pool_count})`;
      const summary = document.createElement('span'); summary.className = 'mt-1 block text-xs text-berry-700'; summary.textContent = unit.summary;
      button.append(title, summary); button.addEventListener('click', () => { if (!busy) chooseUnit(unit.unit); }); item.append(button); el('study-unit-results').append(item);
    }
  }
  async function init() {
    const params = new URLSearchParams(location.search), slug = params.get('article');
    if (slug) {
      const titles = JSON.parse(el('private-catalog-data').textContent || '[]');
      const item = titles.find((item: any) => item.slug === slug);
      el('private-article-title').textContent = item?.title || t('study.private'); show('private-article-title', true);
      try { const data = await fetchPrivateDocument(slug); markdown('private-article-body', data.markdown); show('private-article-body', true); status(''); }
      catch { status(t('study.ownerOnly')); }
      return;
    }
    if (!getGuestAiSession()) { show('study-email-form', true); status(t('study.verifyFirst')); return; }
    const access = await studyAccess(); expiresAt = Number(access.expiresAt || 0);
    show('study-invite-form', !access.access);
    if (access.access) {
      const data = await studyCatalog(); units = data.units;
      if (expiresAt <= Date.now()) { lock(); return; }
      el('study-unit').replaceChildren();
      for (const unit of units) { const option = document.createElement('option'); option.value = unit.unit; option.textContent = `${unit.unit}｜${unit.name} (${unit.pool_count})`; el('study-unit').append(option); }
      chooseUnit(normalizeStudyUnit(params.get('unit')) || units[0]?.unit || 'U01'); renderUnitResults();
      (el('study-question-id') as HTMLInputElement).value = params.get('question') || ''; show('study-workspace', true);
    }
    status(access.access ? `${t('study.expires')} ${new Date(expiresAt).toLocaleString()}` : t('study.inviteRequired'));
  }
  el('study-email-form').addEventListener('submit', event => { event.preventDefault(); run(async () => { await requestGuestAiCode({ name: value('study-name'), email: value('study-email') }); show('study-email-form', false); show('study-otp-form', true); status(t('gemini.codeSent')); }); });
  el('study-otp-form').addEventListener('submit', event => { event.preventDefault(); run(async () => { const data = await verifyGuestAiCode({ email: value('study-email'), code: value('study-otp') }); setGuestAiSession(data); show('study-otp-form', false); await init(); }); });
  el('study-invite-form').addEventListener('submit', event => { event.preventDefault(); run(async () => { const data = await redeemStudyInvite(value('study-invite')); (el('study-invite') as HTMLInputElement).value = ''; expiresAt = data.expiresAt; await init(); }); });
  async function chat(action: string) {
    if (expiresAt <= Date.now()) { lock(); return; }
    const data = await askPrivateStudy({ unit: value('study-unit'), action, questionId: action === 'locate' ? value('study-question-id') : questionId, answer: value('study-answer'), message: value('study-message') });
    if (expiresAt <= Date.now()) { lock(); return; }
    (el('study-unit') as HTMLSelectElement).value = data.unit; unitInfo();
    markdown('study-question', data.questionText || ''); markdown('study-output', data.feedback ?? data.answer);
    el('study-progress').textContent = data.summary || (data.completed ? data.answer : '');
    questionId = data.questionId || ''; completed = Boolean(data.completed); hasAnswered = Boolean(data.hasAnswered);
    if (['next', 'start', 'locate'].includes(action)) for (const id of ['study-answer', 'study-message']) (el(id) as HTMLInputElement).value = '';
  }
  el('study-unit').addEventListener('change', () => chooseUnit(value('study-unit')));
  el('study-unit-search').addEventListener('input', renderUnitResults);
  el('study-start').addEventListener('click', () => run(() => chat('start')));
  el('study-next').addEventListener('click', () => run(() => chat('next')));
  el('study-locate-form').addEventListener('submit', event => { event.preventDefault(); run(() => chat('locate')); });
  el('study-ask-form').addEventListener('submit', event => { event.preventDefault(); run(() => chat('ask')); });
  el('study-answer-form').addEventListener('submit', event => { event.preventDefault(); run(() => chat('answer')); });
  setInterval(() => {
    if (expiresAt && Date.now() >= expiresAt && !el('study-workspace').hidden) lock();
    if (!el('private-article-body').hidden && !isLoggedIn()) { el('private-article-body').replaceChildren(); show('private-article-body', false); status(t('study.ownerOnly')); }
  }, 1000);
  run(init);
</script>
