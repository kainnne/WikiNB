---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSearch from '../components/HomeSearch.astro';
import WikiCard from '../components/WikiCard.astro';
import { getAllWikiPages } from '../lib/wiki';

const pages = getAllWikiPages();
const recent = pages.slice(0, 6);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="WikiNB" description="一個由 Kaine 設計與維護的個人知識系統。">
  <section class="animate-fadeIn mb-16 text-center">
    <h1 class="font-display text-4xl font-bold md:text-5xl lg:text-6xl">
      <a
        href={`${base}search`}
        class="bg-gradient-to-r from-pink-500 via-pink-400 to-lavender-400 bg-clip-text text-transparent transition-opacity hover:opacity-90"
      >
        WikiNB
      </a>
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-berry-700/80">
      一個由 Kaine 設計與維護的個人知識系統。
    </p>
    <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-berry-600/75 md:text-base">
      你現在看到的是公開知識庫；登入後，WikiNB 會展開成一套整合內容管理、知識檢索、AI 問答與自動發布流程的個人 AI 工作台。
    </p>
    <div class="mx-auto mt-8 max-w-lg">
      <HomeSearch dualMode={true} />
    </div>
  </section>

  {recent.length > 0 && (
    <section>
      <h2 class="mb-6 font-display text-2xl font-bold text-berry-800">最近更新</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recent.map((page) => (
          <WikiCard
            slug={page.slug}
            title={page.title}
            description={page.description}
            tags={page.tags}
            date={page.date}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
