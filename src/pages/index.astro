---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSearch from '../components/HomeSearch.astro';
import WikiCard from '../components/WikiCard.astro';
import { getAllWikiPages } from '../lib/wiki';

const pages = getAllWikiPages();
const pinnedSlug = 'AboutMe/00-about-me';
const pinnedPage = pages.find((page) => page.slug === pinnedSlug);
const recent = [
  ...(pinnedPage ? [pinnedPage] : []),
  ...pages.filter((page) => page.slug !== pinnedSlug),
].slice(0, 6);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="WikiNB"
  description="Kaine 的個人知識系統"
  pageClass="home-page home-guest"
  visitorNav={true}
>
  <div class="home-atmosphere" aria-hidden="true">
    <span class="home-glow home-glow-a"></span>
    <span class="home-glow home-glow-b"></span>
    <span class="home-glow home-glow-c"></span>
    <span class="home-grain"></span>
  </div>

  <section id="guest-home-hero" class="guest-home-hero animate-fadeIn text-center">
    <div class="home-side-art home-side-art-left" aria-hidden="true">
      <span class="home-art-orbit home-art-orbit-a"></span>
      <span class="home-art-orbit home-art-orbit-b"></span>
      <span class="home-art-core"></span>
      <span class="home-art-dot home-art-dot-a"></span>
      <span class="home-art-dot home-art-dot-b"></span>
    </div>
    <div class="home-side-art home-side-art-right" aria-hidden="true">
      <span class="home-art-sheet home-art-sheet-a"></span>
      <span class="home-art-sheet home-art-sheet-b"></span>
      <span class="home-art-sheet home-art-sheet-c"></span>
      <span class="home-art-thread"></span>
      <span class="home-art-spark home-art-spark-a"></span>
      <span class="home-art-spark home-art-spark-b"></span>
    </div>

    <h1 class="guest-home-title" aria-label="WikiNB">
      {Array.from('WikiNB').map((letter, index) => (
        <span style={`--letter-index: ${index}`} aria-hidden="true">{letter}</span>
      ))}
    </h1>
    <a id="home-gemini-btn" href={`${base}gemini`} class="home-gemini-btn">
      <span class="home-gemini-label">Kainnne x Gemini</span>
      <span class="home-gemini-light" aria-hidden="true"></span>
    </a>

    <section class="home-quick-guide" aria-labelledby="home-guide-title">
      <div class="home-guide-heading">
        <span aria-hidden="true">Q&A</span>
        <h2 id="home-guide-title" data-i18n="home.guideTitle">快速認識 WikiNB</h2>
      </div>
      <dl class="home-guide-list">
        <div>
          <dt data-i18n="home.guideBrowseQ">怎麼瀏覽？</dt>
          <dd data-i18n="home.guideBrowseA">從右上方的 WikiNB 進入巢狀筆記，或直接查看下方最近更新。</dd>
        </div>
        <div>
          <dt data-i18n="home.guideAiQ">訪客 AI 能做什麼？</dt>
          <dd data-i18n="home.guideAiA">完成 Email 驗證後，可詢問 Kaine 的專案、技能、經歷與合作方向。</dd>
        </div>
        <div>
          <dt data-i18n="home.guideSourceQ">內容從哪裡來？</dt>
          <dd data-i18n="home.guideSourceA">回答以 Kaine 公開整理的 WikiNB 為依據，方便快速理解作品與工作方式。</dd>
        </div>
      </dl>
    </section>
  </section>

  <section id="member-home-hero" class="animate-fadeIn mb-16 text-center" hidden>
    <h1 class="font-display text-5xl font-bold sm:text-6xl md:text-7xl lg:text-8xl">
      <a
        href={`${base}search`}
        class="bg-gradient-to-r from-pink-500 via-pink-400 to-lavender-400 bg-clip-text text-transparent transition-opacity hover:opacity-90"
      >
        WikiNB
      </a>
    </h1>
    <div class="mx-auto mt-7 max-w-lg">
      <HomeSearch dualMode={true} />
    </div>
  </section>

  {recent.length > 0 && (
    <section class="home-recent">
      <h2 class="mb-6 font-display text-2xl font-bold text-berry-800" data-i18n="home.recent">最近更新</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recent.map((page) => (
          <WikiCard
            slug={page.slug}
            title={page.title}
            description={page.description}
            tags={page.tags}
            date={page.updated || page.date}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { isLoggedIn } from '../scripts/bridge-client.js';

  function syncHomeMode() {
    const loggedIn = isLoggedIn();
    const guestHero = document.getElementById('guest-home-hero');
    const memberHero = document.getElementById('member-home-hero');
    if (guestHero) guestHero.hidden = loggedIn;
    if (memberHero) memberHero.hidden = !loggedIn;
    document.body.classList.toggle('home-guest', !loggedIn);
    document.body.classList.toggle('home-member', loggedIn);
  }

  function mountHomeInteractions() {
    const tones = ['rose', 'lilac', 'mint'];
    for (let i = tones.length - 1; i > 0; i -= 1) {
      const swapIndex = Math.floor(Math.random() * (i + 1));
      [tones[i], tones[swapIndex]] = [tones[swapIndex], tones[i]];
    }

    const recentCards = Array.from(document.querySelectorAll('.home-recent .glass-card-hover'));
    recentCards.forEach((card, index) => {
      card.dataset.cardTone = tones[index % tones.length];
    });

    const finePointer = window.matchMedia('(pointer: fine)').matches;
    if (!finePointer) return;

    window.addEventListener(
      'pointermove',
      (event) => {
        document.body.style.setProperty('--home-pointer-x', `${event.clientX}px`);
        document.body.style.setProperty('--home-pointer-y', `${event.clientY}px`);
        const artX = ((event.clientX / window.innerWidth) - 0.5) * 14;
        const artY = ((event.clientY / window.innerHeight) - 0.5) * 10;
        document.body.style.setProperty('--home-art-x', `${artX}px`);
        document.body.style.setProperty('--home-art-y', `${artY}px`);
        document.body.style.setProperty('--home-art-right-x', `${-artX}px`);
        document.body.style.setProperty('--home-art-right-y', `${artY * -0.8}px`);
      },
      { passive: true },
    );

    recentCards.forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const tiltX = ((y / rect.height) - 0.5) * -3;
        const tiltY = ((x / rect.width) - 0.5) * 3;
        card.style.setProperty('--card-x', `${x}px`);
        card.style.setProperty('--card-y', `${y}px`);
        card.style.setProperty('--card-tilt-x', `${tiltX}deg`);
        card.style.setProperty('--card-tilt-y', `${tiltY}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--card-tilt-x');
        card.style.removeProperty('--card-tilt-y');
      });
    });
  }

  syncHomeMode();
  mountHomeInteractions();
  document.addEventListener('wikinb:auth-change', syncHomeMode);
</script>

<style>
  :global(body.home-page.home-guest) {
    --home-ink: #4a2038;
    --home-soft: #786072;
    --home-glass: rgba(255, 255, 255, 0.48);
    --home-line: rgba(255, 255, 255, 0.74);
    --home-gradient: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    --home-pointer-x: 50vw;
    --home-pointer-y: 38vh;
    --home-art-x: 0px;
    --home-art-y: 0px;
    --home-art-right-x: 0px;
    --home-art-right-y: 0px;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 10% 22%, rgba(205, 220, 255, 0.84), transparent 29%),
      radial-gradient(circle at 89% 12%, rgba(255, 210, 232, 0.82), transparent 32%),
      radial-gradient(circle at 72% 78%, rgba(201, 255, 240, 0.66), transparent 30%),
      linear-gradient(145deg, #fffafd 0%, #fff4fa 46%, #f7f2ff 100%);
  }

  :global(body.home-page.home-guest)::before,
  :global(body.home-page.home-guest)::after {
    display: none;
  }

  :global(body.home-page.home-guest main) {
    position: relative;
    z-index: 1;
    max-width: 78rem;
    padding-top: 0;
    padding-bottom: 5rem;
  }

  .home-atmosphere {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
  }

  .home-atmosphere::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle 24rem at var(--home-pointer-x) var(--home-pointer-y),
      rgba(255, 255, 255, 0.7),
      transparent 72%
    );
    mix-blend-mode: soft-light;
  }

  .home-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(3.5rem);
    opacity: 0.46;
    animation: home-drift 14s ease-in-out infinite alternate;
  }

  .home-glow-a {
    top: 10%;
    left: -9rem;
    width: 28rem;
    height: 28rem;
    background: #b9cbff;
  }

  .home-glow-b {
    top: -10rem;
    right: 3%;
    width: 31rem;
    height: 31rem;
    background: #ffc4dc;
    animation-delay: -6s;
  }

  .home-glow-c {
    right: 18%;
    bottom: -13rem;
    width: 28rem;
    height: 28rem;
    background: #bdf7e7;
    animation-delay: -10s;
  }

  .home-grain {
    position: absolute;
    inset: 0;
    opacity: 0.032;
    background-image: radial-gradient(rgba(69, 24, 52, 0.76) 0.55px, transparent 0.75px);
    background-size: 4px 4px;
  }

  .guest-home-hero {
    position: relative;
    min-height: 0;
    padding: clamp(8.5rem, 15vh, 10rem) 0 clamp(1.5rem, 4vh, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }

  .guest-home-hero[hidden],
  #member-home-hero[hidden] {
    display: none !important;
  }

  .guest-home-title {
    margin: 0;
    display: flex;
    justify-content: center;
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: clamp(5.2rem, 15vw, 12.5rem);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.09em;
    filter: drop-shadow(0 20px 45px rgba(155, 114, 203, 0.17));
    cursor: default;
    user-select: none;
  }

  .guest-home-title span {
    display: inline-block;
    color: transparent;
    background: var(--home-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    transform-origin: 50% 86%;
    transition:
      transform 0.36s cubic-bezier(0.2, 0.9, 0.2, 1.2),
      filter 0.3s ease;
    animation: home-title-in 0.7s both cubic-bezier(0.2, 0.8, 0.2, 1);
    animation-delay: calc(var(--letter-index) * 55ms + 80ms);
  }

  .guest-home-title span:hover,
  .guest-home-title span:active {
    transform: translateY(-0.09em) rotate(calc((var(--letter-index) - 2.5) * 1.1deg)) scale(1.035);
    filter: saturate(1.18) drop-shadow(0 12px 22px rgba(183, 148, 255, 0.24));
  }

  .home-gemini-btn {
    position: relative;
    width: min(33rem, calc(100vw - 3rem));
    min-height: 5.25rem;
    margin-top: clamp(2.3rem, 5vh, 3.4rem);
    padding: 0.48rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 1.55rem;
    background: rgba(255, 255, 255, 0.45);
    box-shadow:
      0 20px 55px rgba(111, 62, 104, 0.13),
      inset 0 1px rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(22px) saturate(1.35);
    isolation: isolate;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.28s ease,
      border-color 0.28s ease;
  }

  .home-gemini-btn::before {
    content: '';
    position: absolute;
    inset: 0.4rem;
    z-index: -1;
    border-radius: 1.18rem;
    background: linear-gradient(
      120deg,
      rgba(205, 220, 255, 0.72),
      rgba(246, 200, 255, 0.75) 36%,
      rgba(255, 183, 206, 0.8) 68%,
      rgba(201, 255, 240, 0.72)
    );
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.7);
    transition: transform 0.32s ease, filter 0.32s ease;
  }

  .home-gemini-label {
    position: relative;
    z-index: 2;
    color: #482039;
    font-family: Quicksand, 'Noto Sans TC', sans-serif;
    font-size: clamp(1rem, 1.7vw, 1.18rem);
    font-weight: 700;
    letter-spacing: 0.035em;
  }

  .home-gemini-label::after {
    content: '↗';
    display: inline-block;
    margin-left: 0.75rem;
    font-family: sans-serif;
    font-size: 0.9em;
    font-weight: 500;
    transition: transform 0.24s ease;
  }

  .home-gemini-light {
    position: absolute;
    top: -90%;
    left: -18%;
    z-index: 1;
    width: 13%;
    height: 280%;
    opacity: 0.52;
    background: rgba(255, 255, 255, 0.82);
    filter: blur(0.55rem);
    transform: rotate(18deg);
    transition: left 0.62s ease;
  }

  .home-gemini-btn:hover,
  .home-gemini-btn:focus-visible,
  .home-gemini-btn:active {
    border-color: rgba(255, 255, 255, 0.94);
    transform: translateY(-0.35rem) scale(1.012);
    box-shadow:
      0 28px 68px rgba(111, 62, 104, 0.19),
      0 0 34px rgba(183, 148, 255, 0.14),
      inset 0 1px rgba(255, 255, 255, 0.9);
  }

  .home-gemini-btn:hover::before,
  .home-gemini-btn:focus-visible::before,
  .home-gemini-btn:active::before {
    transform: scale(1.015);
    filter: saturate(1.1);
  }

  .home-gemini-btn:hover .home-gemini-light,
  .home-gemini-btn:focus-visible .home-gemini-light,
  .home-gemini-btn:active .home-gemini-light {
    left: 110%;
  }

  .home-gemini-btn:hover .home-gemini-label::after,
  .home-gemini-btn:focus-visible .home-gemini-label::after {
    transform: translate(0.18rem, -0.12rem);
  }

  .home-quick-guide {
    width: min(51rem, calc(100vw - 3rem));
    margin-top: clamp(1.8rem, 4vh, 2.8rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 1.7rem;
    background: rgba(255, 255, 255, 0.38);
    box-shadow:
      0 20px 54px rgba(103, 59, 94, 0.09),
      inset 0 1px rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(22px) saturate(1.25);
    text-align: left;
  }

  .home-guide-heading {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
  }

  .home-guide-heading > span {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 0.75rem;
    padding: 0 0.65rem;
    background: linear-gradient(120deg, rgba(218, 205, 255, 0.68), rgba(255, 206, 226, 0.66));
    color: #6d3c5d;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.78);
    font-family: Quicksand, sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .home-guide-heading h2 {
    color: #4a2038;
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.015em;
  }

  .home-guide-list {
    margin: 0;
  }

  .home-guide-list > div {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.8fr) minmax(0, 2fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 1rem;
  }

  .home-guide-list > div + div {
    border-top: 1px solid rgba(255, 255, 255, 0.52);
  }

  .home-guide-list dt {
    color: #5d2948;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .home-guide-list dd {
    margin: 0;
    color: rgba(74, 32, 56, 0.68);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .home-side-art {
    display: none;
  }

  @media (min-width: 1100px) {
    .home-side-art {
      position: absolute;
      top: clamp(12rem, 24vh, 16rem);
      display: block;
      width: 11rem;
      height: 17rem;
      opacity: 0.78;
      pointer-events: none;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .home-side-art-left {
      left: clamp(-2.5rem, -2vw, -1rem);
      transform: translate3d(var(--home-art-x), var(--home-art-y), 0) rotate(-5deg);
    }

    .home-side-art-right {
      right: clamp(-2.5rem, -2vw, -1rem);
      transform: translate3d(var(--home-art-right-x), var(--home-art-right-y), 0) rotate(5deg);
    }

    .home-art-orbit {
      position: absolute;
      left: 50%;
      top: 48%;
      border: 1px solid rgba(255, 255, 255, 0.82);
      border-radius: 50%;
      box-shadow:
        0 16px 44px rgba(105, 76, 133, 0.08),
        inset 0 1px rgba(255, 255, 255, 0.72);
      animation: home-orbit-pulse 7s ease-in-out infinite alternate;
    }

    .home-art-orbit-a {
      width: 10rem;
      height: 5rem;
      transform: translate(-50%, -50%) rotate(24deg);
      background: rgba(205, 220, 255, 0.14);
    }

    .home-art-orbit-b {
      width: 6rem;
      height: 10.5rem;
      transform: translate(-50%, -50%) rotate(-31deg);
      background: rgba(255, 206, 226, 0.11);
      animation-delay: -3.5s;
    }

    .home-art-core {
      position: absolute;
      left: 50%;
      top: 48%;
      width: 3.6rem;
      height: 3.6rem;
      border: 1px solid rgba(255, 255, 255, 0.86);
      border-radius: 1.2rem;
      background: linear-gradient(135deg, rgba(140, 181, 255, 0.78), rgba(246, 200, 255, 0.82), rgba(255, 159, 184, 0.76));
      box-shadow:
        0 16px 36px rgba(129, 89, 145, 0.16),
        inset 0 1px rgba(255, 255, 255, 0.82);
      transform: translate(-50%, -50%) rotate(14deg);
      animation: home-core-float 5s ease-in-out infinite alternate;
    }

    .home-art-dot,
    .home-art-spark {
      position: absolute;
      border: 1px solid rgba(255, 255, 255, 0.82);
      border-radius: 50%;
      background: #ff9fba;
      box-shadow: 0 8px 20px rgba(156, 78, 143, 0.18);
    }

    .home-art-dot-a {
      left: 0.6rem;
      top: 4.6rem;
      width: 0.72rem;
      height: 0.72rem;
    }

    .home-art-dot-b {
      right: 0.6rem;
      bottom: 4rem;
      width: 0.52rem;
      height: 0.52rem;
      background: #75dec9;
    }

    .home-art-sheet {
      position: absolute;
      right: 0.6rem;
      width: 7.8rem;
      height: 9.2rem;
      border: 1px solid rgba(255, 255, 255, 0.82);
      border-radius: 1.45rem;
      box-shadow:
        0 20px 44px rgba(103, 59, 94, 0.1),
        inset 0 1px rgba(255, 255, 255, 0.76);
      backdrop-filter: blur(12px);
    }

    .home-art-sheet-a {
      top: 3.6rem;
      right: 1.8rem;
      background: rgba(205, 220, 255, 0.34);
      transform: rotate(-12deg);
    }

    .home-art-sheet-b {
      top: 4.6rem;
      right: 0.7rem;
      background: rgba(255, 206, 226, 0.34);
      transform: rotate(5deg);
    }

    .home-art-sheet-c {
      top: 5.7rem;
      right: -0.25rem;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.52), rgba(201, 255, 240, 0.3));
      transform: rotate(14deg);
      animation: home-sheet-float 6s ease-in-out infinite alternate;
    }

    .home-art-thread {
      position: absolute;
      top: 8.2rem;
      right: 1.25rem;
      z-index: 2;
      width: 4.2rem;
      height: 2.4rem;
      border-top: 2px solid rgba(183, 148, 255, 0.54);
      border-right: 2px solid rgba(255, 143, 171, 0.5);
      border-radius: 50%;
      transform: rotate(19deg);
    }

    .home-art-spark-a {
      top: 2.5rem;
      right: 0.8rem;
      width: 0.72rem;
      height: 0.72rem;
      background: #8cb5ff;
    }

    .home-art-spark-b {
      left: 1.15rem;
      bottom: 2.4rem;
      width: 0.5rem;
      height: 0.5rem;
      background: #75dec9;
    }
  }

  .home-recent {
    position: relative;
    padding-top: clamp(0.5rem, 2vw, 1.4rem);
  }

  .home-recent > h2 {
    color: var(--home-ink);
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    letter-spacing: -0.035em;
  }

  :global(body.home-page.home-guest .home-recent .glass-card-hover) {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--home-line);
    border-radius: 1.8rem;
    background:
      radial-gradient(circle 15rem at var(--card-x, 50%) var(--card-y, 50%), rgba(255, 255, 255, 0.54), transparent 72%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0.28));
    box-shadow:
      0 20px 55px rgba(103, 59, 94, 0.1),
      inset 0 1px rgba(255, 255, 255, 0.72);
