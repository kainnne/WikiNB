---
import BaseLayout from '../layouts/BaseLayout.astro';
import WikiCard from '../components/WikiCard.astro';
import { getAllWikiPages } from '../lib/wiki';

const pages = getAllWikiPages();
const pinnedSlug = 'AboutMe/00-about-me';
const pinnedPage = pages.find((page) => page.slug === pinnedSlug);
const recent = [
  ...(pinnedPage ? [pinnedPage] : []),
  ...pages.filter((page) => page.slug !== pinnedSlug),
].slice(0, 6);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="WikiNB"
  description="Kaine 的個人知識系統"
  pageClass="home-page home-guest wikinb-home"
  visitorNav={true}
>
  <div class="home-atmosphere" aria-hidden="true">
    <span class="home-glow home-glow-a"></span>
    <span class="home-glow home-glow-b"></span>
    <span class="home-glow home-glow-c"></span>
    <span class="home-grain"></span>
  </div>

  <section id="guest-home-hero" class="guest-home-hero animate-fadeIn text-center">
    <div class="home-side-art home-side-art-left" aria-hidden="true">
      <span class="home-art-orbit home-art-orbit-a"></span>
      <span class="home-art-orbit home-art-orbit-b"></span>
      <span class="home-art-core"></span>
      <span class="home-art-dot home-art-dot-a"></span>
      <span class="home-art-dot home-art-dot-b"></span>
    </div>
    <div class="home-side-art home-side-art-right" aria-hidden="true">
      <span class="home-art-sheet home-art-sheet-a"></span>
      <span class="home-art-sheet home-art-sheet-b"></span>
      <span class="home-art-sheet home-art-sheet-c"></span>
      <span class="home-art-thread"></span>
      <span class="home-art-spark home-art-spark-a"></span>
      <span class="home-art-spark home-art-spark-b"></span>
    </div>

    <h1 class="guest-home-title" aria-label="WikiNB">
      {Array.from('WikiNB').map((letter, index) => (
        <span style={`--letter-index: ${index}`} aria-hidden="true">{letter}</span>
      ))}
    </h1>
    <a id="home-gemini-btn" href={`${base}gemini`} class="home-gemini-btn">
      <span class="home-gemini-aura" aria-hidden="true"></span>
      <span class="home-gemini-orbit home-gemini-orbit-a" aria-hidden="true"></span>
      <span class="home-gemini-orbit home-gemini-orbit-b" aria-hidden="true"></span>
      <span class="home-gemini-copy">
        <span class="home-gemini-label">Kainnne x Gemini</span>
      </span>
      <span class="home-gemini-particles" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </span>
      <span class="home-gemini-light" aria-hidden="true"></span>
    </a>

    <section class="home-quick-guide" aria-label="How to use WikiNB">
      <details class="home-guide-master">
        <summary class="home-guide-master-toggle">
          <span class="home-guide-master-title">Q&A</span>
          <span class="home-guide-master-label">How to use WikiNB</span>
          <span class="home-guide-master-arrow" aria-hidden="true"></span>
        </summary>
        <div class="home-guide-list">
          <details class="home-guide-item" name="wikinb-guide">
            <summary>
              <span class="home-guide-number">Q1</span>
              <span class="home-guide-question" data-i18n="home.guideBrowseQ">第一次來，要怎麼開始瀏覽？</span>
              <span class="home-guide-toggle" aria-hidden="true"></span>
            </summary>
            <div class="home-guide-answer">
              <p data-i18n="home.guideBrowseA">不用登入也能閱讀公開內容；你可以依照想了解的深度，從三個入口開始。</p>
              <ul>
                <li data-i18n="home.guideBrowsePoint1">點選右上方 WikiNB，依巢狀分類探索完整筆記。</li>
                <li data-i18n="home.guideBrowsePoint2">從下方「最近更新」快速查看 Kaine 近期整理的主題。</li>
                <li data-i18n="home.guideBrowsePoint3">每篇筆記都可獨立閱讀，再沿著相關連結延伸。</li>
              </ul>
            </div>
          </details>
          <details class="home-guide-item" name="wikinb-guide">
            <summary>
              <span class="home-guide-number">Q2</span>
              <span class="home-guide-question" data-i18n="home.guideAiQ">Kainnne x Gemini 可以怎麼用？</span>
              <span class="home-guide-toggle" aria-hidden="true"></span>
            </summary>
            <div class="home-guide-answer">
              <p data-i18n="home.guideAiA">它是理解 Kaine 的訪客 AI 助理，回答會以公開 WikiNB 為主要依據。</p>
              <ul>
                <li data-i18n="home.guideAiPoint1">完成名稱與 Email 驗證後即可開始對話。</li>
                <li data-i18n="home.guideAiPoint2">適合詢問代表專案、能力背景、工作方式與合作方向。</li>
                <li data-i18n="home.guideAiPoint3">回答預設言簡意賅；需要更多脈絡時會引導你閱讀對應筆記。</li>
              </ul>
            </div>
          </details>
          <details class="home-guide-item" name="wikinb-guide">
            <summary>
              <span class="home-guide-number">Q3</span>
              <span class="home-guide-question" data-i18n="home.guideSourceQ">公開瀏覽與私人登入有什麼不同？</span>
              <span class="home-guide-toggle" aria-hidden="true"></span>
            </summary>
            <div class="home-guide-answer">
              <p data-i18n="home.guideSourceA">訪客可以閱讀公開知識庫並使用訪客 AI；私人登入只提供 Kaine 維護系統。</p>
              <ul>
                <li data-i18n="home.guideSourcePoint1">公開頁面是唯讀內容，不需要管理者帳號。</li>
                <li data-i18n="home.guideSourcePoint2">私人登入包含筆記管理、同步與 Codex 工作區功能。</li>
                <li data-i18n="home.guideSourcePoint3">若只是想認識 Kaine，直接瀏覽或使用 Gemini 即可。</li>
              </ul>
            </div>
          </details>
        </div>
      </details>
    </section>
  </section>

  <section id="member-home-hero" class="guest-home-hero member-home-hero animate-fadeIn text-center" hidden>
    <div class="home-side-art home-side-art-left" aria-hidden="true">
      <span class="home-art-orbit home-art-orbit-a"></span>
      <span class="home-art-orbit home-art-orbit-b"></span>
      <span class="home-art-core"></span>
      <span class="home-art-dot home-art-dot-a"></span>
      <span class="home-art-dot home-art-dot-b"></span>
    </div>
    <div class="home-side-art home-side-art-right" aria-hidden="true">
      <span class="home-art-sheet home-art-sheet-a"></span>
      <span class="home-art-sheet home-art-sheet-b"></span>
      <span class="home-art-sheet home-art-sheet-c"></span>
      <span class="home-art-thread"></span>
      <span class="home-art-spark home-art-spark-a"></span>
      <span class="home-art-spark home-art-spark-b"></span>
    </div>

    <h1 class="guest-home-title" aria-label="WikiNB">
      {Array.from('WikiNB').map((letter, index) => (
        <span style={`--letter-index: ${index}`} aria-hidden="true">{letter}</span>
      ))}
    </h1>
    <a id="home-codex-btn" href={`${base}codex`} class="home-gemini-btn home-codex-btn">
      <span class="home-gemini-aura" aria-hidden="true"></span>
      <span class="home-gemini-orbit home-gemini-orbit-a" aria-hidden="true"></span>
      <span class="home-gemini-orbit home-gemini-orbit-b" aria-hidden="true"></span>
      <span class="home-gemini-copy">
        <span class="home-gemini-label">Kainnne x Codex</span>
      </span>
      <span class="home-gemini-particles" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </span>
      <span class="home-gemini-light" aria-hidden="true"></span>
    </a>
  </section>

  {recent.length > 0 && (
    <section class="home-recent">
      <h2 class="mb-6 font-display text-2xl font-bold text-berry-800" data-i18n="home.recent">最近更新</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recent.map((page) => (
          <WikiCard
            slug={page.slug}
            title={page.title}
            description={page.description}
            tags={page.tags}
            date={page.updated || page.date}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { isLoggedIn } from '../scripts/bridge-client.js';

  function syncHomeMode() {
    const loggedIn = isLoggedIn();
    const guestHero = document.getElementById('guest-home-hero');
    const memberHero = document.getElementById('member-home-hero');
    if (guestHero) guestHero.hidden = loggedIn;
    if (memberHero) memberHero.hidden = !loggedIn;
    document.body.classList.add('home-guest');
    document.body.classList.toggle('home-member', loggedIn);
  }

  function mountHomeInteractions() {
    const tones = ['rose', 'lilac', 'mint'];
    for (let i = tones.length - 1; i > 0; i -= 1) {
      const swapIndex = Math.floor(Math.random() * (i + 1));
      [tones[i], tones[swapIndex]] = [tones[swapIndex], tones[i]];
    }

    const recentCards = Array.from(document.querySelectorAll('.home-recent .glass-card-hover'));
    recentCards.forEach((card, index) => {
      card.dataset.cardTone = tones[index % tones.length];
    });

    const finePointer = window.matchMedia('(pointer: fine)').matches;
    if (!finePointer) return;

    window.addEventListener(
      'pointermove',
      (event) => {
        document.body.style.setProperty('--home-pointer-x', `${event.clientX}px`);
        document.body.style.setProperty('--home-pointer-y', `${event.clientY}px`);
        const artX = ((event.clientX / window.innerWidth) - 0.5) * 14;
        const artY = ((event.clientY / window.innerHeight) - 0.5) * 10;
        document.body.style.setProperty('--home-art-x', `${artX}px`);
        document.body.style.setProperty('--home-art-y', `${artY}px`);
        document.body.style.setProperty('--home-art-right-x', `${-artX}px`);
        document.body.style.setProperty('--home-art-right-y', `${artY * -0.8}px`);
      },
      { passive: true },
    );

    recentCards.forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const tiltX = ((y / rect.height) - 0.5) * -3;
        const tiltY = ((x / rect.width) - 0.5) * 3;
        card.style.setProperty('--card-x', `${x}px`);
        card.style.setProperty('--card-y', `${y}px`);
        card.style.setProperty('--card-tilt-x', `${tiltX}deg`);
        card.style.setProperty('--card-tilt-y', `${tiltY}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--card-tilt-x');
        card.style.removeProperty('--card-tilt-y');
      });
    });
  }

  syncHomeMode();
  mountHomeInteractions();
  document.addEventListener('wikinb:auth-change', syncHomeMode);
</script>

<style>
  :global(body.home-page) {
    --home-ink: #4a2038;
    --home-soft: #786072;
    --home-glass: rgba(255, 255, 255, 0.48);
    --home-line: rgba(255, 255, 255, 0.74);
    --home-gradient: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    --home-pointer-x: 50vw;
    --home-pointer-y: 38vh;
    --home-art-x: 0px;
    --home-art-y: 0px;
    --home-art-right-x: 0px;
    --home-art-right-y: 0px;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 10% 22%, rgba(205, 220, 255, 0.84), transparent 29%),
      radial-gradient(circle at 89% 12%, rgba(255, 210, 232, 0.82), transparent 32%),
      radial-gradient(circle at 72% 78%, rgba(201, 255, 240, 0.66), transparent 30%),
      linear-gradient(145deg, #fffafd 0%, #fff4fa 46%, #f7f2ff 100%);
  }

  :global(body.home-page)::before,
  :global(body.home-page)::after {
    display: none;
  }

  :global(body.home-page main) {
    position: relative;
    z-index: 1;
    max-width: 78rem;
    padding-top: 0;
    padding-bottom: 5rem;
  }

  .home-atmosphere {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
  }

  .home-atmosphere::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle 24rem at var(--home-pointer-x) var(--home-pointer-y),
      rgba(255, 255, 255, 0.7),
      transparent 72%
    );
    mix-blend-mode: soft-light;
  }

  .home-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(3.5rem);
    opacity: 0.46;
    animation: home-drift 14s ease-in-out infinite alternate;
  }

  .home-glow-a {
    top: 10%;
    left: -9rem;
    width: 28rem;
    height: 28rem;
    background: #b9cbff;
  }

  .home-glow-b {
    top: -10rem;
    right: 3%;
    width: 31rem;
    height: 31rem;
    background: #ffc4dc;
    animation-delay: -6s;
  }

  .home-glow-c {
    right: 18%;
    bottom: -13rem;
    width: 28rem;
    height: 28rem;
    background: #bdf7e7;
    animation-delay: -10s;
  }

  .home-grain {
    position: absolute;
    inset: 0;
    opacity: 0.032;
    background-image: radial-gradient(rgba(69, 24, 52, 0.76) 0.55px, transparent 0.75px);
    background-size: 4px 4px;
  }

  .guest-home-hero {
    position: relative;
    min-height: 0;
    padding: clamp(8.5rem, 15vh, 10rem) 0 clamp(1.5rem, 4vh, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }

  .guest-home-hero[hidden],
  #member-home-hero[hidden] {
    display: none !important;
  }

  .home-gemini-btn.home-codex-btn::before {
    background: conic-gradient(
      from 25deg,
      rgba(255, 183, 206, 0.92),
      rgba(218, 205, 255, 0.96),
      rgba(255, 143, 171, 0.92),
      rgba(201, 255, 240, 0.82),
      rgba(255, 183, 206, 0.92)
    );
  }

  .home-codex-btn .home-gemini-label {
    background: linear-gradient(105deg, #b14d87 0%, #ad6be5 42%, #ef6f9a 72%, #4eb9aa 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .guest-home-title {
    margin: 0;
    display: flex;
    justify-content: center;
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: clamp(5.2rem, 15vw, 12.5rem);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.09em;
    filter: drop-shadow(0 20px 45px rgba(155, 114, 203, 0.17));
    cursor: default;
    user-select: none;
  }

  .guest-home-title span {
    display: inline-block;
    color: transparent;
    background: var(--home-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    transform-origin: 50% 86%;
    transition:
      transform 0.36s cubic-bezier(0.2, 0.9, 0.2, 1.2),
      filter 0.3s ease;
    animation: home-title-in 0.7s both cubic-bezier(0.2, 0.8, 0.2, 1);
    animation-delay: calc(var(--letter-index) * 55ms + 80ms);
  }

  .guest-home-title span:hover,
  .guest-home-title span:active {
    transform: translateY(-0.09em) rotate(calc((var(--letter-index) - 2.5) * 1.1deg)) scale(1.035);
    filter: saturate(1.18) drop-shadow(0 12px 22px rgba(183, 148, 255, 0.24));
  }

  .home-gemini-btn {
    position: relative;
    width: min(43rem, calc(100vw - 3rem));
    min-height: 8rem;
    margin-top: clamp(2.3rem, 5vh, 3.4rem);
    padding: 0.62rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 0;
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.5);
    box-shadow:
      0 26px 72px rgba(111, 62, 104, 0.17),
      0 8px 25px rgba(183, 148, 255, 0.15),
      inset 0 1px rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(22px) saturate(1.35);
    isolation: isolate;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.28s ease,
      border-color 0.28s ease;
  }

  .home-gemini-btn::before {
    content: '';
    position: absolute;
    inset: -260%;
    z-index: 0;
    background: conic-gradient(
      from 25deg,
      rgba(110, 168, 255, 0.86),
      rgba(183, 148, 255, 0.95),
      rgba(255, 143, 171, 0.9),
      rgba(94, 234, 212, 0.82),
      rgba(110, 168, 255, 0.86)
    );
    animation: home-gemini-rim 13s linear infinite;
    pointer-events: none;
  }

  .home-gemini-btn::after {
    content: '';
    position: absolute;
    inset: 0.16rem;
    z-index: 1;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 1.84rem;
    background:
      radial-gradient(circle at 18% 20%, rgba(205, 220, 255, 0.56), transparent 34%),
      radial-gradient(circle at 82% 78%, rgba(201, 255, 240, 0.44), transparent 36%),
      linear-gradient(118deg, rgba(255, 255, 255, 0.8), rgba(244, 228, 255, 0.66) 46%, rgba(255, 228, 239, 0.7));
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.94),
      inset 0 -14px 34px rgba(183, 148, 255, 0.09);
    pointer-events: none;
  }

  .home-gemini-aura {
    position: absolute;
    inset: 0.65rem;
    z-index: 2;
    border-radius: 1.38rem;
    background:
      radial-gradient(circle at 24% 56%, rgba(110, 168, 255, 0.42), transparent 26%),
      radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.72), transparent 31%),
      radial-gradient(circle at 74% 48%, rgba(255, 143, 171, 0.38), transparent 28%);
    filter: blur(0.6rem);
    opacity: 0.58;
    animation: home-gemini-breathe 4.8s ease-in-out infinite alternate;
    pointer-events: none;
  }

  .home-gemini-orbit {
    position: absolute;
    z-index: 3;
    width: 15.5rem;
    height: 3.8rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
    box-shadow: 0 0 18px rgba(183, 148, 255, 0.13);
    opacity: 0.42;
    pointer-events: none;
    transition: transform 0.45s ease, opacity 0.35s ease;
  }

  .home-gemini-orbit-a {
    left: -4.5rem;
    top: 1.8rem;
    transform: rotate(12deg);
  }

  .home-gemini-orbit-b {
    right: -4rem;
    bottom: 1.65rem;
    transform: rotate(-12deg);
  }

  .home-gemini-copy {
    position: relative;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.4rem;
    border: 0;
    background: transparent;
    filter:
      drop-shadow(0 4px 9px rgba(255, 255, 255, 0.82))
      drop-shadow(0 11px 22px rgba(105, 58, 95, 0.14));
    transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.32s ease;
  }

  .home-gemini-label {
    position: relative;
    color: transparent;
    background: linear-gradient(102deg, #5e91dc 0%, #9e78dc 35%, #d57fae 70%, #36a990 100%);
    background-clip: text;
    -webkit-background-clip: text;
    font-family: Quicksand, 'Noto Sans TC', sans-serif;
    font-size: clamp(1.18rem, 2.45vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.055em;
    -webkit-text-fill-color: transparent;
  }

  .home-gemini-light {
    position: absolute;
    top: -90%;
    left: -18%;
    z-index: 7;
    width: 10%;
    height: 280%;
    opacity: 0.46;
    background: rgba(255, 255, 255, 0.9);
    filter: blur(0.7rem);
    transform: rotate(18deg);
    transition: left 0.76s ease;
    pointer-events: none;
  }

  .home-gemini-particles {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  .home-gemini-particles i {
    position: absolute;
    width: 0.32rem;
    height: 0.32rem;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 0 0 13px rgba(183, 148, 255, 0.34);
    animation: home-gemini-particle 3.8s ease-in-out infinite alternate;
  }

  .home-gemini-particles i:nth-child(1) { left: 12%; top: 28%; }
  .home-gemini-particles i:nth-child(2) { left: 21%; bottom: 20%; animation-delay: -1.2s; }
  .home-gemini-particles i:nth-child(3) { right: 17%; top: 22%; animation-delay: -2.1s; }
  .home-gemini-particles i:nth-child(4) { right: 10%; bottom: 29%; animation-delay: -0.7s; }

  .home-gemini-btn:focus-visible {
    outline: 3px solid rgba(183, 148, 255, 0.48);
    outline-offset: 0.35rem;
  }

  .home-gemini-btn:hover,
  .home-gemini-btn:focus-visible {
    transform: translateY(-0.35rem) scale(1.012);
    box-shadow:
      0 34px 84px rgba(111, 62, 104, 0.22),
      0 0 48px rgba(183, 148, 255, 0.22),
      inset 0 1px rgba(255, 255, 255, 0.9);
  }

  .home-gemini-btn:hover .home-gemini-copy,
  .home-gemini-btn:focus-visible .home-gemini-copy {
    transform: scale(1.045);
    filter:
      drop-shadow(0 5px 11px rgba(255, 255, 255, 0.9))
      drop-shadow(0 14px 26px rgba(105, 58, 95, 0.19));
  }

  .home-gemini-btn:hover .home-gemini-orbit-a,
  .home-gemini-btn:focus-visible .home-gemini-orbit-a {
    opacity: 0.84;
