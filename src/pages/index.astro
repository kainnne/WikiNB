---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSearch from '../components/HomeSearch.astro';
import WikiCard from '../components/WikiCard.astro';
import { getAllWikiPages } from '../lib/wiki';

const pages = getAllWikiPages();
const recent = pages.slice(0, 6);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="WikiNB" description="一個由 Kaine 設計的個人知識系統。">
  <section class="animate-fadeIn mb-16 text-center">
    <h1 class="font-display text-4xl font-bold md:text-5xl lg:text-6xl">
      <a
        href={`${base}search`}
        class="bg-gradient-to-r from-pink-500 via-pink-400 to-lavender-400 bg-clip-text text-transparent transition-opacity hover:opacity-90"
      >
        WikiNB
      </a>
    </h1>
    <div id="home-taglines" class="home-taglines">
      <p class="mx-auto mt-4 max-w-xl text-lg text-berry-700/80" data-i18n="home.tagline">
        一個由 Kaine 設計的個人知識系統。
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-berry-600/75 md:text-base" data-i18n="home.subtitle">
        登入後，WikiNB 將會展開成一套整合資料管理的個人 AI 工作台。
      </p>
    </div>
    <div class="mx-auto mt-8 max-w-lg">
      <HomeSearch dualMode={true} />
    </div>
  </section>

  {recent.length > 0 && (
    <section>
      <h2 class="mb-6 font-display text-2xl font-bold text-berry-800" data-i18n="home.recent">最近更新</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recent.map((page) => (
          <WikiCard
            slug={page.slug}
            title={page.title}
            description={page.description}
            tags={page.tags}
            date={page.date}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { isLoggedIn } from '../scripts/bridge-client.js';

  function syncHomeTaglines() {
    const el = document.getElementById('home-taglines');
    if (!el) return;
    const hide = isLoggedIn();
    el.hidden = hide;
    el.setAttribute('aria-hidden', hide ? 'true' : 'false');
  }

  syncHomeTaglines();
  document.addEventListener('wikinb:auth-change', syncHomeTaglines);
</script>

<style>
  .home-taglines[hidden] {
    display: none !important;
  }
</style>
