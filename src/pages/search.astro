---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicDreamBackdrop from '../components/PublicDreamBackdrop.astro';
import SearchBar from '../components/SearchBar.astro';
import { getAllWikiPages, getSearchIndex, getWikiDiskTree } from '../lib/wiki';

const pages = getAllWikiPages();
const searchIndex = getSearchIndex(pages);
const folderTree = getWikiDiskTree();
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="WikiNB"
  description="搜尋與瀏覽 Kainnne 知識庫"
  pageClass="public-wiki-page"
  visitorNav={true}
>
  <PublicDreamBackdrop />
  <div class="animate-fadeIn public-search-page">
    <div class="public-search-heading mb-6 text-center">
      <h1 class="font-display text-4xl font-bold md:text-5xl">
        <a
          href={`${base}search`}
          class="bg-gradient-to-r from-pink-500 via-pink-400 to-lavender-400 bg-clip-text text-transparent transition-opacity hover:opacity-90"
        >
          WikiNB
        </a>
      </h1>
    </div>

    <div class="public-search-control mx-auto max-w-3xl">
      <SearchBar
        size="lg"
        placeholder="搜尋筆記…"
        showButton={true}
        buttonLabel="Search"
        action="/search"
      />
    </div>

    <p id="search-meta" class="mt-4 text-center text-sm text-berry-600/70 md:text-left"></p>

    <div
      id="search-results"
      data-search-results
      class="wiki-scroll public-search-results glass-card mx-auto mt-6 max-w-3xl overflow-hidden"
    ></div>
    <div id="search-empty" class="glass-card mx-auto mt-6 hidden max-w-3xl p-8 text-center text-berry-700/80"></div>
  </div>

  <script>
    import { createWikiSearch } from '../scripts/wiki-search.js';

    const searchIndex = JSON.parse(document.getElementById('search-data')!.textContent!);
    const folderTree = JSON.parse(document.getElementById('folder-tree-data')!.textContent!);
    const { mount, getQueryFromUrl } = createWikiSearch(searchIndex, { folderTree });

    const input = document.querySelector('input[name="q"]') as HTMLInputElement;
    const form = input?.closest('form');
    const resultsEl = document.getElementById('search-results')!;
    const emptyEl = document.getElementById('search-empty')!;
    const metaEl = document.getElementById('search-meta')!;

    const { runSearch } = mount({ input, form, resultsEl, emptyEl, metaEl, syncUrl: true });

    const q = getQueryFromUrl();
    if (q && input) input.value = q;
    runSearch();
  </script>

  <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />
  <script id="folder-tree-data" type="application/json" set:html={JSON.stringify(folderTree)} />
</BaseLayout>

<style>
  .wiki-scroll {
    max-height: min(75vh, 900px);
    overflow-y: auto;
    scroll-behavior: smooth;
  }

  .public-search-heading {
    margin-bottom: clamp(2rem, 5vw, 3.75rem);
  }

  .public-search-heading h1 {
    font-size: clamp(4.25rem, 11vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.075em;
    filter: drop-shadow(0 18px 36px rgba(155, 114, 203, 0.16));
  }

  .public-search-heading a {
    background-image: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
  }

  .public-search-control {
    padding: clamp(0.65rem, 1.5vw, 0.85rem);
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 1.75rem;
    background: rgba(255, 255, 255, 0.46);
    box-shadow:
      0 22px 62px rgba(103, 59, 94, 0.12),
      inset 0 1px rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(24px) saturate(1.3);
  }

  .public-search-control :global(form) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.55rem;
  }

  .public-search-control :global(.search-input) {
    min-height: 3.8rem;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 1.3rem;
    padding-inline: 1.25rem;
    background: rgba(255, 255, 255, 0.58);
    color: #4a2038;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(14px);
  }

  .public-search-control :global(.search-input:focus) {
    border-color: rgba(183, 148, 255, 0.48);
    background: rgba(255, 255, 255, 0.78);
    box-shadow:
      0 0 0 0.25rem rgba(183, 148, 255, 0.1),
      inset 0 1px rgba(255, 255, 255, 0.85);
  }

  .public-search-control :global(.btn-primary) {
    min-width: 8rem;
    min-height: 3.8rem;
    margin-top: 0;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 1.3rem;
    padding-inline: 1.5rem;
    background: linear-gradient(
      120deg,
      rgba(205, 220, 255, 0.9),
      rgba(246, 200, 255, 0.92) 36%,
      rgba(255, 183, 206, 0.92) 68%,
      rgba(201, 255, 240, 0.86)
    );
    color: #482039;
    box-shadow:
      0 10px 28px rgba(156, 78, 143, 0.16),
      inset 0 1px rgba(255, 255, 255, 0.76);
    font-size: 0.9rem;
    transition: transform 0.24s ease, box-shadow 0.24s ease;
  }

  .public-search-control :global(.btn-primary:hover),
  .public-search-control :global(.btn-primary:focus-visible),
  .public-search-control :global(.btn-primary:active) {
    transform: translateY(-0.15rem);
    box-shadow:
      0 16px 36px rgba(156, 78, 143, 0.22),
      inset 0 1px rgba(255, 255, 255, 0.85);
  }

  .public-search-results,
  #search-empty {
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 1.9rem;
    background: rgba(255, 255, 255, 0.43);
    box-shadow:
      0 24px 72px rgba(103, 59, 94, 0.12),
      inset 0 1px rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(26px) saturate(1.28);
  }

  #search-meta {
    color: rgba(74, 32, 56, 0.62);
  }

  .wiki-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .wiki-scroll::-webkit-scrollbar-thumb {
    background: rgba(236, 64, 122, 0.25);
    border-radius: 9999px;
  }

  :global(#search-results .wiki-title-link:hover) {
    text-decoration: underline;
    text-decoration-color: rgba(236, 64, 122, 0.35);
    text-underline-offset: 4px;
  }

  :global(.wiki-tree .folder-row) {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    min-height: 4.25rem;
    padding: 0.85rem 1.15rem;
    text-align: left;
    font-weight: 700;
    color: #5c2a4a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.58);
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.36), transparent);
    transition: background 0.22s ease, padding 0.22s ease, box-shadow 0.22s ease;
  }

  :global(.wiki-tree .folder-row:hover),
  :global(.wiki-tree .folder-row:focus-visible),
  :global(.wiki-tree .folder-row:active) {
    padding-left: 1.4rem;
    background: linear-gradient(110deg, rgba(218, 205, 255, 0.3), rgba(255, 206, 226, 0.25));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.5);
  }

  :global(.wiki-tree .folder-chevron) {
    display: inline-block;
    width: 1rem;
    color: #ec407a;
    transition: transform 0.2s ease;
  }

  :global(.wiki-tree .folder-chevron.is-open) {
    transform: rotate(90deg);
  }

  :global(.wiki-tree .folder-name) {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    font-size: 1rem;
  }

  :global(.wiki-tree .folder-count) {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(107, 58, 107, 0.55);
  }

  :global(.wiki-tree .folder-children) {
    border-left: 2px solid rgba(183, 148, 255, 0.28);
    margin-left: 1.25rem;
  }

  :global(.wiki-tree .root-group-label) {
    padding: 0.65rem 1.25rem 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(107, 58, 107, 0.55);
    text-transform: uppercase;
  }

  :global(.wiki-tree .wiki-item) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.56);
    position: relative;
    background: rgba(255, 255, 255, 0.1);
    transition: background 0.24s ease, box-shadow 0.24s ease;
  }

  :global(.wiki-tree .wiki-item:hover) {
    background: linear-gradient(110deg, rgba(255, 206, 226, 0.16), rgba(218, 205, 255, 0.16));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.38);
  }

  :global(.wiki-tree .wiki-expand) {
    border-color: rgba(255, 255, 255, 0.72);
    border-radius: 0.95rem;
    background: rgba(255, 255, 255, 0.52);
    color: #a05c8c;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.72);
  }

  :global(.wiki-tree .wiki-title-link) {
    color: #4a2038;
    letter-spacing: -0.025em;
  }

  :global(.wiki-tree .wiki-panel) {
    border-color: rgba(255, 255, 255, 0.54);
    background: rgba(255, 255, 255, 0.3);
  }

  :global(.wiki-tree .wiki-card-actions) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global(.wiki-tree .wiki-fs-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.5);
    color: #7d4b70;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  :global(.wiki-tree .wiki-copy-btn) {
    width: auto;
    min-width: 2rem;
    padding: 0 0.4rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  :global(.wiki-tree .wiki-fs-btn:hover),
  :global(.wiki-tree .wiki-fs-btn:focus-visible) {
    background: linear-gradient(120deg, rgba(218, 205, 255, 0.58), rgba(255, 206, 226, 0.58));
    transform: translateY(-0.1rem);
    outline: none;
  }

  @media (max-width: 640px) {
    .public-search-heading {
      margin-bottom: 2.5rem;
    }

    .public-search-heading h1 {
      font-size: clamp(4rem, 20vw, 5.8rem);
    }

    .public-search-control :global(form) {
      grid-template-columns: 1fr;
    }

    .public-search-control :global(.btn-primary) {
      width: 100%;
    }

    .public-search-results,
    #search-empty {
      border-radius: 1.55rem;
    }

    :global(.wiki-tree .wiki-item-header) {
      padding-inline: 0.8rem;
    }

    :global(.wiki-tree .wiki-card-actions) {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .public-search-control :global(.btn-primary),
    :global(.wiki-tree .folder-row),
    :global(.wiki-tree .wiki-item),
    :global(.wiki-tree .wiki-fs-btn) {
      transition-duration: 0.001ms !important;
    }
  }
</style>
