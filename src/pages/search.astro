---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import { getAllWikiPages, getSearchIndex, getWikiDiskTree } from '../lib/wiki';

const pages = getAllWikiPages();
const searchIndex = getSearchIndex(pages);
const folderTree = getWikiDiskTree();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="WikiNB" description="搜尋與瀏覽 Kainnne 知識庫">
  <div class="animate-fadeIn">
    <div class="mb-6 text-center md:text-left">
      <h1 class="font-display text-4xl font-bold md:text-5xl">
        <a
          href={`${base}search`}
          class="bg-gradient-to-r from-pink-500 via-pink-400 to-lavender-400 bg-clip-text text-transparent transition-opacity hover:opacity-90"
        >
          WikiNB
        </a>
      </h1>
    </div>

    <div class="mx-auto max-w-3xl">
      <SearchBar
        size="lg"
        placeholder="搜尋筆記…"
        showButton={true}
        buttonLabel="Search"
        action="/search"
      />
    </div>

    <p id="search-meta" class="mt-4 text-center text-sm text-berry-600/70 md:text-left"></p>

    <div
      id="search-results"
      data-search-results
      class="wiki-scroll glass-card mx-auto mt-6 max-w-3xl overflow-hidden"
    ></div>
    <div id="search-empty" class="glass-card mx-auto mt-6 hidden max-w-3xl p-8 text-center text-berry-700/80"></div>
  </div>

  <script>
    import { createWikiSearch } from '../scripts/wiki-search.js';

    const searchIndex = JSON.parse(document.getElementById('search-data')!.textContent!);
    const folderTree = JSON.parse(document.getElementById('folder-tree-data')!.textContent!);
    const { mount, getQueryFromUrl } = createWikiSearch(searchIndex, { folderTree });

    const input = document.querySelector('input[name="q"]') as HTMLInputElement;
    const form = input?.closest('form');
    const resultsEl = document.getElementById('search-results')!;
    const emptyEl = document.getElementById('search-empty')!;
    const metaEl = document.getElementById('search-meta')!;

    const { runSearch } = mount({ input, form, resultsEl, emptyEl, metaEl, syncUrl: true });

    const q = getQueryFromUrl();
    if (q && input) input.value = q;
    runSearch();
  </script>

  <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />
  <script id="folder-tree-data" type="application/json" set:html={JSON.stringify(folderTree)} />
</BaseLayout>

<style>
  .wiki-scroll {
    max-height: min(75vh, 900px);
    overflow-y: auto;
    scroll-behavior: smooth;
  }

  .wiki-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .wiki-scroll::-webkit-scrollbar-thumb {
    background: rgba(236, 64, 122, 0.25);
    border-radius: 9999px;
  }

  :global(#search-results .wiki-title-link:hover) {
    text-decoration: underline;
    text-decoration-color: rgba(236, 64, 122, 0.35);
    text-underline-offset: 4px;
  }

  :global(.wiki-tree .folder-row) {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    text-align: left;
    font-weight: 700;
    color: #5c2a4a;
    border-bottom: 1px solid rgba(252, 231, 243, 0.9);
    background: linear-gradient(90deg, rgba(252, 231, 243, 0.45), transparent);
    transition: background 0.2s ease;
  }

  :global(.wiki-tree .folder-row:hover) {
    background: rgba(252, 231, 243, 0.7);
  }

  :global(.wiki-tree .folder-chevron) {
    display: inline-block;
    width: 1rem;
    color: #ec407a;
    transition: transform 0.2s ease;
  }

  :global(.wiki-tree .folder-chevron.is-open) {
    transform: rotate(90deg);
  }

  :global(.wiki-tree .folder-name) {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    font-size: 1rem;
  }

  :global(.wiki-tree .folder-count) {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(107, 58, 107, 0.55);
  }

  :global(.wiki-tree .folder-children) {
    border-left: 2px solid rgba(244, 143, 177, 0.35);
    margin-left: 1.25rem;
  }

  :global(.wiki-tree .root-group-label) {
    padding: 0.65rem 1.25rem 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(107, 58, 107, 0.55);
    text-transform: uppercase;
  }

  :global(.wiki-tree .wiki-item) {
    border-bottom: 1px solid rgba(252, 231, 243, 0.85);
    position: relative;
  }

  :global(.wiki-tree .wiki-fs-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
    border: 1px solid rgba(244, 143, 177, 0.45);
    background: rgba(255, 255, 255, 0.75);
    color: #9c2d5a;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  :global(.wiki-tree .wiki-fs-btn:hover),
  :global(.wiki-tree .wiki-fs-btn:focus-visible) {
    background: rgba(252, 231, 243, 0.95);
    transform: scale(1.05);
    outline: none;
  }

  :global(.wiki-tree .wiki-item.is-fullscreen) {
    position: fixed;
    inset: 0;
    z-index: 200;
    width: 100%;
    height: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: linear-gradient(160deg, #fff5f8 0%, #fce4ec 35%, #f3e5f5 100%);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: none;
  }

  :global(.wiki-tree .wiki-item.is-fullscreen .wiki-item-header) {
    flex-shrink: 0;
    border-bottom: 1px solid rgba(252, 231, 243, 0.85);
    background: rgba(255, 255, 255, 0.55);
  }

  :global(.wiki-tree .wiki-item.is-fullscreen .wiki-panel) {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    border-top: 0;
    background: transparent;
    padding-bottom: 2rem;
  }

  :global(.wiki-tree .wiki-item.is-fullscreen .wiki-panel .wiki-content),
  :global(.wiki-tree .wiki-item.is-fullscreen .wiki-panel > div) {
    padding-left: 0;
  }

  :global(html.wiki-browse-fs-active),
  :global(body.wiki-browse-fs-active) {
    overflow: hidden;
  }
</style>
