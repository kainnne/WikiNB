---
import BaseLayout from '../layouts/BaseLayout.astro';
import '@fontsource/iansui/chinese-traditional-400.css';
import '@fontsource/iansui/latin-400.css';
---

<BaseLayout title="Kainnne x Gemini" description="由公開 WikiNB 建構的 Kaine 數位助理">
  <div class="animate-fadeIn gemini-page">
    <div class="mb-5">
      <div>
        <h1 class="gemini-heading" data-i18n="gemini.title">Kainnne x Gemini</h1>
      </div>
    </div>

    <section id="gemini-unlock" class="gemini-card mx-auto max-w-xl p-5 sm:p-7">
      <span class="gemini-unlock-glow gemini-unlock-glow-a" aria-hidden="true"></span>
      <span class="gemini-unlock-glow gemini-unlock-glow-b" aria-hidden="true"></span>
      <div class="mb-5 text-center">
        <h2 class="font-display text-xl font-bold text-berry-800" data-i18n="gemini.unlockTitle">
          解鎖訪客 AI
        </h2>
      </div>

      <form id="gemini-profile-form" class="space-y-4">
        <label class="block text-sm font-semibold text-berry-800">
          <span data-i18n="gemini.name">使用者名稱</span>
          <input
            id="gemini-name"
            type="text"
            class="search-input mt-2 py-3 text-sm"
            maxlength="60"
            autocomplete="name"
            required
            data-i18n-placeholder="gemini.namePlaceholder"
            placeholder="請輸入你的名字"
          />
        </label>
        <label class="block text-sm font-semibold text-berry-800">
          <span data-i18n="gemini.email">電子信箱</span>
          <input
            id="gemini-email"
            type="email"
            class="search-input mt-2 py-3 text-sm"
            autocomplete="email"
            required
            data-i18n-placeholder="gemini.emailPlaceholder"
            placeholder="name@example.com"
          />
        </label>
        <button
          id="gemini-send-code"
          type="submit"
          class="gemini-primary w-full justify-center py-3"
          data-i18n="gemini.sendCode"
        >
          寄送驗證碼
        </button>
      </form>

      <form id="gemini-code-form" class="hidden space-y-4">
        <p id="gemini-code-sent" class="rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800"></p>
        <label class="block text-sm font-semibold text-berry-800">
          <span data-i18n="gemini.code">6 位數驗證碼</span>
          <input
            id="gemini-code"
            type="text"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            class="search-input mt-2 py-3 text-center text-xl tracking-[0.35em]"
            autocomplete="one-time-code"
            required
            data-i18n-placeholder="gemini.codePlaceholder"
            placeholder="000000"
          />
        </label>
        <button
          id="gemini-verify"
          type="submit"
          class="gemini-primary w-full justify-center py-3"
          data-i18n="gemini.verify"
        >
          驗證並進入 Gemini
        </button>
        <button id="gemini-back" type="button" class="btn-ghost w-full justify-center text-sm" data-i18n="gemini.back">
          ← 修改資料
        </button>
      </form>
      <p id="gemini-auth-message" class="mt-4 hidden text-center text-sm"></p>
    </section>

    <section id="gemini-chat" class="gemini-window hidden">
      <div class="gemini-chrome">
        <div class="min-w-0">
          <p class="gemini-chrome-title" data-i18n="gemini.title">Kainnne x Gemini</p>
          <p id="gemini-identity" class="truncate text-xs text-berry-600/60"></p>
        </div>
      </div>
      <div id="gemini-output" class="gemini-output" aria-live="polite"></div>
      <form id="gemini-chat-form" class="gemini-input-row">
        <input
          id="gemini-input"
          type="text"
          class="gemini-input"
          maxlength="1200"
          autocomplete="off"
          data-i18n-placeholder="gemini.placeholder"
          placeholder="詢問關於 Kaine、他的作品或專業領域…"
        />
        <button id="gemini-chat-send" type="submit" class="gemini-send" data-i18n="gemini.send">
          送出
        </button>
      </form>
    </section>
  </div>
</BaseLayout>

<script>
  import { renderMarkdownWithMath } from '../scripts/markdown-math.js';
  import { t } from '../scripts/i18n.js';
  import {
    askGuestGemini,
    fetchGuestAiMe,
    getGuestAiSession,
    requestGuestAiCode,
    setGuestAiSession,
    verifyGuestAiCode,
  } from '../scripts/guest-gemini-client.js';

  const unlock = document.getElementById('gemini-unlock');
  const profileForm = document.getElementById('gemini-profile-form');
  const codeForm = document.getElementById('gemini-code-form');
  const nameInput = document.getElementById('gemini-name');
  const emailInput = document.getElementById('gemini-email');
  const codeInput = document.getElementById('gemini-code');
  const sendCodeBtn = document.getElementById('gemini-send-code');
  const verifyBtn = document.getElementById('gemini-verify');
  const backBtn = document.getElementById('gemini-back');
  const codeSent = document.getElementById('gemini-code-sent');
  const authMessage = document.getElementById('gemini-auth-message');
  const chat = document.getElementById('gemini-chat');
  const identity = document.getElementById('gemini-identity');
  const output = document.getElementById('gemini-output');
  const chatForm = document.getElementById('gemini-chat-form');
  const chatInput = document.getElementById('gemini-input');
  const chatSend = document.getElementById('gemini-chat-send');

  let pendingEmail = '';
  let running = false;
  /** @type {{role: 'user'|'assistant', content: string}[]} */
  let history = [];

  if (unlock && window.matchMedia('(pointer: fine)').matches) {
    unlock.addEventListener(
      'pointermove',
      (event) => {
        const rect = unlock.getBoundingClientRect();
        unlock.style.setProperty('--unlock-x', `${event.clientX - rect.left}px`);
        unlock.style.setProperty('--unlock-y', `${event.clientY - rect.top}px`);
      },
      { passive: true },
    );
  }

  function showAuthMessage(text, ok = false) {
    if (!authMessage) return;
    authMessage.textContent = text;
    authMessage.className = ok
      ? 'mt-4 text-center text-sm text-emerald-700'
      : 'mt-4 text-center text-sm text-red-600';
  }

  function clearAuthMessage() {
    authMessage?.classList.add('hidden');
    if (authMessage) authMessage.textContent = '';
  }

  function setBusy(button, busy, fallback) {
    if (!button) return;
    button.disabled = busy;
    if (busy) button.textContent = '…';
    else button.textContent = fallback;
  }

  function sanitizeRenderedMarkdown(markdown) {
    const template = document.createElement('template');
    const normalized = String(markdown || '')
      .replace(/^```(?:markdown|md)?\s*\n([\s\S]*?)\n```$/i, '$1')
      .replace(/\\([*_`~])/g, '$1')
      // CommonMark 不會解析 **粗體**後面緊接中文字母的情況。
      // 先轉成安全清理器允許的 strong，支援 Gemini 常見的中英混排輸出。
      .replace(/\*\*([^*\n]+?)\*\*(?=[\p{L}\p{N}])/gu, '<strong>$1</strong>');
    template.innerHTML = renderMarkdownWithMath(normalized);
    template.content
      .querySelectorAll('script, style, iframe, object, embed, form, input, button, textarea, select')
      .forEach((node) => node.remove());
    template.content.querySelectorAll('*').forEach((node) => {
      for (const attr of [...node.attributes]) {
        const name = attr.name.toLowerCase();
        const value = attr.value.trim().toLowerCase();
        if (name.startsWith('on') || name === 'style') node.removeAttribute(attr.name);
        if ((name === 'href' || name === 'src') && /^(javascript|data):/.test(value)) {
          node.removeAttribute(attr.name);
        }
      }
      if (node.tagName === 'A') {
        node.setAttribute('target', '_blank');
        node.setAttribute('rel', 'noopener noreferrer');
      }
    });
    return template.innerHTML;
  }

  function appendMessage(text, role = 'assistant') {
    const line = document.createElement('div');
    line.className = `gemini-line gemini-line-${role}`;
    const bubble = document.createElement('div');
    bubble.className = 'gemini-bubble';
    if (role === 'assistant') {
      bubble.classList.add('wiki-content');
      bubble.innerHTML = sanitizeRenderedMarkdown(text);
    } else {
      bubble.textContent = text;
    }
    line.appendChild(bubble);
    output?.appendChild(line);
    output?.scrollTo({ top: output.scrollHeight, behavior: 'smooth' });
    return bubble;
  }

  function startResponseTimer() {
    let seconds = 1;
    const bubble = appendMessage(t('gemini.elapsed', { n: seconds }), 'system');
    const timerId = window.setInterval(() => {
      seconds += 1;
      if (bubble) bubble.textContent = t('gemini.elapsed', { n: seconds });
    }, 1000);
    return {
      stop() {
        window.clearInterval(timerId);
        bubble?.parentElement?.remove();
      },
    };
  }

  function appendWelcome() {
    if (!output) return;
    output.innerHTML = '';
    const line = document.createElement('div');
    line.className = 'gemini-line gemini-line-system';
    const box = document.createElement('div');
    box.className = 'gemini-welcome';
    const title = document.createElement('p');
    title.className = 'font-display font-bold text-berry-800';
    title.textContent = t('gemini.connected');
    box.appendChild(title);

    const examples = document.createElement('div');
    examples.className = 'mt-3 grid gap-2';
    ['gemini.example1', 'gemini.example2', 'gemini.example3', 'gemini.example4'].forEach((key) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'gemini-example';
      button.textContent = t(key);
      button.addEventListener('click', () => {
        if (!chatInput || running) return;
        chatInput.value = t(key);
        chatInput.focus();
      });
      examples.appendChild(button);
    });
    box.appendChild(examples);
    line.appendChild(box);
    output.appendChild(line);
    appendMessage(t('gemini.welcomeMessage'), 'assistant');
  }

  function openChat(session) {
    unlock?.classList.add('hidden');
    chat?.classList.remove('hidden');
    if (identity) identity.textContent = `${session.name} · ${session.email}`;
    appendWelcome();
    chatInput?.focus();
  }

  function openUnlock() {
    chat?.classList.add('hidden');
    unlock?.classList.remove('hidden');
    profileForm?.classList.remove('hidden');
    codeForm?.classList.add('hidden');
  }

  profileForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearAuthMessage();
    const name = String(nameInput?.value || '').trim();
    const email = String(emailInput?.value || '').trim().toLowerCase();
    setBusy(sendCodeBtn, true, t('gemini.sendCode'));
    try {
      const result = await requestGuestAiCode({ name, email });
      pendingEmail = email;
      if (codeSent) codeSent.textContent = result.message || '驗證碼已寄出';
      profileForm.classList.add('hidden');
      codeForm?.classList.remove('hidden');
      codeInput?.focus();
    } catch (error) {
      showAuthMessage(error.message || '驗證碼寄送失敗');
    } finally {
      setBusy(sendCodeBtn, false, t('gemini.sendCode'));
    }
  });

  codeForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearAuthMessage();
    const code = String(codeInput?.value || '').trim();
    setBusy(verifyBtn, true, t('gemini.verify'));
    try {
      const result = await verifyGuestAiCode({ email: pendingEmail, code });
      const session = {
        token: result.token,
        name: result.name,
        email: result.email,
        expiresAt: result.expiresAt,
      };
      setGuestAiSession(session);
      openChat(session);
    } catch (error) {
      showAuthMessage(error.message || '驗證失敗');
    } finally {
      setBusy(verifyBtn, false, t('gemini.verify'));
    }
  });

  backBtn?.addEventListener('click', () => {
    clearAuthMessage();
    codeForm?.classList.add('hidden');
    profileForm?.classList.remove('hidden');
  });

  chatForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (running) return;
    const message = String(chatInput?.value || '').trim();
    if (!message) return;

    running = true;
    if (chatInput) {
      chatInput.value = '';
      chatInput.disabled = true;
    }
    if (chatSend) {
      chatSend.disabled = true;
      chatSend.textContent = t('gemini.sending');
    }
    appendMessage(message, 'user');
    const responseTimer = startResponseTimer();

    try {
      const result = await askGuestGemini({ message, history });
      responseTimer.stop();
      appendMessage(result.answer, 'assistant');
      history.push({ role: 'user', content: message });
      history.push({ role: 'assistant', content: result.answer });
      history = history.slice(-4);
    } catch (error) {
      responseTimer.stop();
      const raw = error.message || '';
      const friendly =
        /暫時無法回應|暫時無法讀取|服務暫時發生錯誤/.test(raw)
          ? t('gemini.tempError')
          : raw || t('gemini.tempError');
      appendMessage(friendly, 'error');
      if (/驗證已過期/.test(raw)) openUnlock();
    } finally {
      running = false;
      if (chatInput) {
        chatInput.disabled = false;
        chatInput.focus();
      }
      if (chatSend) {
        chatSend.disabled = false;
        chatSend.textContent = t('gemini.send');
      }
    }
  });

  document.addEventListener('wikinb:locale-change', () => {
    if (!chat?.classList.contains('hidden') && history.length === 0) appendWelcome();
  });

  async function init() {
    const session = getGuestAiSession();
    if (!session) {
      openUnlock();
      return;
    }
    try {
      const me = await fetchGuestAiMe();
      openChat({ ...session, ...me });
    } catch {
      openUnlock();
    }
  }

  void init();
</script>

<style>
  .gemini-page {
    font-family: 'Iansui', 'Noto Sans TC', sans-serif;
  }

  .gemini-heading {
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: clamp(1.8rem, 5vw, 2.7rem);
    font-weight: 700;
    background: linear-gradient(105deg, #4285f4 0%, #9b72cb 38%, #d96570 67%, #34a853 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .gemini-card,
  .gemini-window {
    border: 1px solid rgba(183, 148, 244, 0.25);
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.9);
    box-shadow:
      0 18px 50px rgba(91, 70, 135, 0.1),
      0 0 32px rgba(110, 168, 255, 0.08);
    backdrop-filter: blur(16px);
  }

  #gemini-unlock {
    --unlock-x: 50%;
    --unlock-y: 35%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 2rem;
    background:
      radial-gradient(circle 18rem at var(--unlock-x) var(--unlock-y), rgba(255, 255, 255, 0.7), transparent 74%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.72), rgba(255, 250, 253, 0.56));
    box-shadow:
      0 30px 90px rgba(103, 59, 94, 0.16),
      0 0 45px rgba(183, 148, 255, 0.1),
      inset 0 1px rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(28px) saturate(1.32);
  }

  #gemini-unlock::before {
    content: '';
    position: absolute;
    inset: 0.55rem;
    z-index: -1;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 1.55rem;
    pointer-events: none;
  }

  .gemini-unlock-glow {
    position: absolute;
    z-index: -2;
    width: 13rem;
    height: 13rem;
    border-radius: 50%;
    opacity: 0.42;
    filter: blur(2.7rem);
    pointer-events: none;
    animation: gemini-unlock-drift 9s ease-in-out infinite alternate;
  }

  .gemini-unlock-glow-a {
    top: -6rem;
    right: -3rem;
    background: #ffc4dc;
  }

  .gemini-unlock-glow-b {
    bottom: -7rem;
    left: -3rem;
    background: #cddcff;
    animation-delay: -4s;
  }

  #gemini-unlock h2 {
    display: inline-block;
    color: transparent;
    background: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 72%, #5eead4 100%);
    background-clip: text;
    -webkit-background-clip: text;
    font-size: clamp(1.55rem, 4vw, 2.15rem);
    letter-spacing: -0.035em;
    filter: drop-shadow(0 9px 20px rgba(155, 114, 203, 0.14));
  }

  #gemini-unlock form {
    position: relative;
    z-index: 1;
  }

  #gemini-unlock label {
    color: #4a2038;
    font-family: Quicksand, 'Noto Sans TC', sans-serif;
    letter-spacing: 0.01em;
  }

  #gemini-unlock .search-input {
    min-height: 3.65rem;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 1.2rem;
    padding-inline: 1.1rem;
    background: rgba(255, 255, 255, 0.62);
    color: #4a2038;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px);
  }

  #gemini-unlock .search-input:focus {
    border-color: rgba(183, 148, 255, 0.52);
    background: rgba(255, 255, 255, 0.82);
    box-shadow:
      0 0 0 0.25rem rgba(183, 148, 255, 0.1),
      inset 0 1px rgba(255, 255, 255, 0.9);
  }

  #gemini-unlock .gemini-primary {
    position: relative;
    min-height: 3.65rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 1.2rem;
    background: linear-gradient(
      120deg,
      rgba(205, 220, 255, 0.9),
      rgba(246, 200, 255, 0.92) 36%,
      rgba(255, 183, 206, 0.92) 68%,
      rgba(201, 255, 240, 0.86)
    );
    color: #482039;
    box-shadow:
      0 12px 30px rgba(156, 78, 143, 0.17),
      inset 0 1px rgba(255, 255, 255, 0.8);
  }

  #gemini-unlock .gemini-primary:hover:not(:disabled),
  #gemini-unlock .gemini-primary:focus-visible:not(:disabled),
  #gemini-unlock .gemini-primary:active:not(:disabled) {
    transform: translateY(-0.18rem);
    box-shadow:
      0 18px 40px rgba(156, 78, 143, 0.24),
      inset 0 1px rgba(255, 255, 255, 0.9);
  }

  #gemini-unlock #gemini-back {
    min-height: 3.25rem;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.48);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.72);
  }

  #gemini-unlock #gemini-code-sent {
    border: 1px solid rgba(167, 243, 208, 0.72);
    background: rgba(236, 253, 245, 0.72);
    backdrop-filter: blur(12px);
  }

  .gemini-primary {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(183, 148, 244, 0.35);
    border-radius: 9999px;
    background: #fff;
    color: #75569d;
    font-weight: 800;
    box-shadow: 0 8px 24px rgba(123, 97, 255, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .gemini-primary:hover:not(:disabled),
  .gemini-primary:focus-visible:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px rgba(123, 97, 255, 0.18);
  }

  .gemini-primary:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .gemini-window {
    overflow: hidden;
  }

  .gemini-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid rgba(183, 148, 244, 0.2);
    background: linear-gradient(90deg, rgba(239, 246, 255, 0.82), rgba(253, 242, 248, 0.72));
  }

  .gemini-chrome-title {
    font-family: Comfortaa, Quicksand, sans-serif;
    font-weight: 700;
    background: linear-gradient(105deg, #4285f4, #9b72cb, #d96570, #34a853);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .gemini-output {
    min-height: 420px;
    max-height: min(62vh, 680px);
    overflow-y: auto;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.66);
  }

  :global(.gemini-line) {
    display: flex;
    margin-bottom: 0.85rem;
  }

  :global(.gemini-line-user) {
    justify-content: flex-end;
  }

  :global(.gemini-bubble) {
    max-width: min(88%, 760px);
    border: 1px solid rgba(183, 148, 244, 0.18);
    border-radius: 1rem;
    padding: 0.8rem 1rem;
    background: #fff;
    color: #5c2a4a;
    line-height: 1.65;
    box-shadow: 0 5px 18px rgba(91, 70, 135, 0.06);
  }

  :global(.gemini-bubble.wiki-content) {
    white-space: normal;
  }

  :global(.gemini-bubble.wiki-content > *:first-child) {
    margin-top: 0;
  }

  :global(.gemini-bubble.wiki-content > *:last-child) {
    margin-bottom: 0;
  }

  :global(.gemini-bubble.wiki-content p),
  :global(.gemini-bubble.wiki-content ul),
  :global(.gemini-bubble.wiki-content ol),
  :global(.gemini-bubble.wiki-content pre),
  :global(.gemini-bubble.wiki-content blockquote),
  :global(.gemini-bubble.wiki-content table) {
    margin: 0.55em 0;
  }

  :global(.gemini-bubble.wiki-content h1),
  :global(.gemini-bubble.wiki-content h2),
  :global(.gemini-bubble.wiki-content h3),
  :global(.gemini-bubble.wiki-content h4) {
    margin: 0.8em 0 0.35em;
    color: #3b0f2e;
    font-weight: 800;
    line-height: 1.3;
  }

  :global(.gemini-bubble.wiki-content h1) {
    font-size: 1.25em;
  }

  :global(.gemini-bubble.wiki-content h2) {
    font-size: 1.16em;
  }

  :global(.gemini-bubble.wiki-content h3),
  :global(.gemini-bubble.wiki-content h4) {
    font-size: 1.07em;
  }

  :global(.gemini-bubble.wiki-content strong) {
    color: #3b0f2e;
    font-weight: 800;
  }

  :global(.gemini-bubble.wiki-content em) {
    font-style: italic;
  }

  :global(.gemini-bubble.wiki-content ul) {
    list-style: disc;
    padding-left: 1.35rem;
  }

  :global(.gemini-bubble.wiki-content ol) {
    list-style: decimal;
    padding-left: 1.35rem;
  }

  :global(.gemini-bubble.wiki-content li) {
    margin: 0.25em 0;
  }

  :global(.gemini-bubble.wiki-content a) {
    color: #db2777;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  :global(.gemini-bubble.wiki-content code) {
    border-radius: 0.3rem;
