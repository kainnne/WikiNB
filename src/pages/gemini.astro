---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicDreamBackdrop from '../components/PublicDreamBackdrop.astro';
import openaiConfig from '../../config/openai-demo.json';

interface Props { provider?: 'gemini' | 'openai'; }
const { provider = 'gemini' } = Astro.props;
const isOpenAI = provider === 'openai';
import '@fontsource/iansui/chinese-traditional-400.css';
import '@fontsource/iansui/latin-400.css';
---

<BaseLayout
  title={isOpenAI ? "Kainnne x Codex" : "Kainnne x Gemini"}
  description="由公開 WikiNB 驅動的 Kaine 限定聊天"
  pageClass="public-wiki-page gemini-public-page"
  visitorNav={true}
  publicSection={isOpenAI ? "openai" : "gemini"}
>
  <PublicDreamBackdrop />
  <div class="animate-fadeIn gemini-page" data-provider={provider} data-api-url={isOpenAI ? openaiConfig.apiUrl : undefined}>
    <header class="gemini-product-lockup">
      <span class="gemini-product-orbit" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <h1 class="gemini-heading">
        <span>Kainnne</span>
        <span class="gemini-heading-cross" aria-hidden="true">×</span>
        <span class:list={{ "codex-wordmark": isOpenAI }}>{isOpenAI ? "Codex" : "Gemini"}</span>
      </h1>
    </header>

    <section id="gemini-unlock" class="gemini-card hidden mx-auto max-w-xl p-5 sm:p-7">
      <span class="gemini-unlock-glow gemini-unlock-glow-a" aria-hidden="true"></span>
      <span class="gemini-unlock-glow gemini-unlock-glow-b" aria-hidden="true"></span>
      <div class="gemini-unlock-heading">
        <h2 class="font-display text-xl font-bold text-berry-800" data-i18n="gemini.unlockTitle">
          解鎖訪客 AI
        </h2>
        <p class="gemini-unlock-note" data-i18n="gemini.unlockPrivacy">
          Email 僅用於訪客登入紀錄，不會額外蒐集或保存其他個人資訊。名字可以填寫暱稱，不需要使用真實姓名。
        </p>
      </div>

      <form id="gemini-profile-form" class="space-y-4">
        <label class="block text-sm font-semibold text-berry-800">
          <span data-i18n="gemini.name">使用者名稱</span>
          <input
            id="gemini-name"
            type="text"
            class="search-input mt-2 py-3 text-sm"
            maxlength="60"
            autocomplete="name"
            required
            data-i18n-placeholder="gemini.namePlaceholder"
            placeholder="請輸入你的名字"
          />
        </label>
        <label class="block text-sm font-semibold text-berry-800">
          <span data-i18n="gemini.email">電子信箱</span>
          <input
            id="gemini-email"
            type="email"
            class="search-input mt-2 py-3 text-sm"
            autocomplete="email"
            required
            data-i18n-placeholder="gemini.emailPlaceholder"
            placeholder="name@example.com"
          />
        </label>
        <button
          id="gemini-send-code"
          type="submit"
          class="gemini-primary w-full justify-center py-3"
          data-i18n="gemini.sendCode"
        >
          寄送驗證碼
        </button>
      </form>

      <form id="gemini-code-form" class="hidden space-y-4">
        <p id="gemini-code-sent" class="rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800"></p>
        <label class="block text-sm font-semibold text-berry-800">
          <span data-i18n="gemini.code">6 位數驗證碼</span>
          <input
            id="gemini-code"
            type="text"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            class="search-input mt-2 py-3 text-center text-xl tracking-[0.35em]"
            autocomplete="one-time-code"
            required
            data-i18n-placeholder="gemini.codePlaceholder"
            placeholder="000000"
          />
        </label>
        <button
          id="gemini-verify"
          type="submit"
          class="gemini-primary w-full justify-center py-3"
          data-i18n="gemini.verify"
        >
          驗證並進入 Gemini
        </button>
        <button id="gemini-back" type="button" class="btn-ghost w-full justify-center text-sm" data-i18n="gemini.back">
          ← 修改資料
        </button>
      </form>
      <p id="gemini-auth-message" class="mt-4 hidden text-center text-sm"></p>
    </section>

    <section id="gemini-chat" class="gemini-window">
      <div class="gemini-chrome">
        <div class="gemini-chrome-copy">
          <p class="gemini-chrome-title" data-i18n={isOpenAI ? undefined : "gemini.title"}>{isOpenAI ? <><span>Kainnne x </span><span class="codex-wordmark">Codex</span></> : "Kainnne x Gemini"}</p>
          <p id="gemini-identity" class="gemini-chrome-identity"></p>
        </div>
        <button
          id="gemini-fs-toggle"
          type="button"
          class="gemini-fs-btn"
          aria-label="放大視窗"
          title="放大"
        >
          <span class="gemini-fs-icon" aria-hidden="true">⛶</span>
        </button>
      </div>
      <div id="gemini-output" class="gemini-output" aria-live="polite"></div>
      <form id="gemini-chat-form" class="gemini-input-row">
        <input
          id="gemini-input"
          type="text"
          class="gemini-input"
          maxlength="1200"
          autocomplete="off"
          data-i18n-placeholder="gemini.placeholder"
          placeholder="也可以直接寫下你想做的事…"
          aria-label="寫下你想做的事或問題"
          data-i18n-aria="gemini.placeholder"
        />
        <button id="gemini-chat-send" type="submit" class="gemini-send" data-i18n="gemini.send">
          送出
        </button>
      </form>
    </section>
  </div>
</BaseLayout>

<script>
  import { askOpenAI, checkOpenAI, safeAnswer } from '../scripts/openai-chat.js';
  import { renderMarkdownWithMath } from '../scripts/markdown-math.js';
  import { t, getLocale } from '../scripts/i18n.js';
  import { drawDiscoveryTopics, discoveryQuestion } from '../../worker/discovery-topics.js';
  import { GEMINI_TOPICS, GEMINI_FOLLOWUPS, prepareVisitorRequest } from '../scripts/gemini-onboarding.js';
  import {
    askGuestGemini,
    askGuestGeminiAnonymous,
    fetchGuestAiMe,
    getGuestAiSession,
    requestGuestAiCode,
    describeGuestAiMessage,
    setGuestAiSession,
    verifyGuestAiCode,
  } from '../scripts/guest-gemini-client.js';

  const providerRoot = document.querySelector('[data-provider]');
  const isOpenAI = providerRoot?.getAttribute('data-provider') === 'openai';
  const openaiApi = providerRoot?.getAttribute('data-api-url') || '';
  let openaiAvailable = !isOpenAI;
  let openaiStateKey = '';

  function showOpenAIState(key) {
    openaiStateKey = key;
    if (identity) { identity.hidden = !key; identity.textContent = key ? t(key) : ''; }
  }

  const unlock = document.getElementById('gemini-unlock');
  const profileForm = document.getElementById('gemini-profile-form');
  const codeForm = document.getElementById('gemini-code-form');
  const nameInput = document.getElementById('gemini-name');
  const emailInput = document.getElementById('gemini-email');
  const codeInput = document.getElementById('gemini-code');
  const sendCodeBtn = document.getElementById('gemini-send-code');
  const verifyBtn = document.getElementById('gemini-verify');
  const backBtn = document.getElementById('gemini-back');
  const codeSent = document.getElementById('gemini-code-sent');
  const authMessage = document.getElementById('gemini-auth-message');
  const chat = document.getElementById('gemini-chat');
  const identity = document.getElementById('gemini-identity');
  const output = document.getElementById('gemini-output');
  const chatForm = document.getElementById('gemini-chat-form');
  const chatInput = document.getElementById('gemini-input');
  const chatSend = document.getElementById('gemini-chat-send');
  const fsToggle = document.getElementById('gemini-fs-toggle');
  const fsIcon = fsToggle?.querySelector('.gemini-fs-icon');

  let pendingEmail = '';
  let running = false;
  let authMessageState = null;
  let codeSentState = null;
  let fullscreen = false;
  let mobileFullscreenLocked = false;
  let followLatest = true;
  const ANONYMOUS_QUESTION_LIMIT = 5;
  let anonymousQuestionsUsed = 0;
  let pendingPostAuthMessage = '';
  let activeTopic = '';
  let topicTurns = 0;
  let selectedQuestion = '';
  let discoveryTopics = [];
  let showingDiscovery = false;
  /** @type {{role: 'user'|'assistant', content: string}[]} */
  let history = [];

  function syncConversationControls() {
    const blocked = running || (isOpenAI && !openaiAvailable);
    output?.querySelectorAll('.gemini-choice, .gemini-followup, .gemini-change-topic').forEach((button) => {
      button.disabled = blocked;
    });
    if (chatInput) {
      chatInput.disabled = blocked;
      chatInput.setAttribute('data-i18n-placeholder', 'gemini.placeholder');
      chatInput.placeholder = t('gemini.placeholder');
    }
    if (chatSend) {
      chatSend.disabled = blocked;
      const key = running ? 'gemini.sending' : 'gemini.send';
      chatSend.setAttribute('data-i18n', key);
      chatSend.textContent = t(key);
    }
  }

  function setFullscreen(on) {
    fullscreen = mobileFullscreenLocked ? true : Boolean(on);
    chat?.classList.toggle('is-fullscreen', fullscreen);
    document.documentElement.classList.toggle('gemini-fs-active', fullscreen);
    document.body.classList.toggle('gemini-fs-active', fullscreen);
    if (fsToggle) {
      fsToggle.setAttribute('aria-label', fullscreen ? '還原視窗' : '放大視窗');
      fsToggle.title = fullscreen ? '還原' : '放大';
    }
    if (fsIcon) fsIcon.textContent = fullscreen ? '❐' : '⛶';
  }

  const mobileChatQuery = window.matchMedia('(max-width: 640px), (hover: none) and (pointer: coarse)');

  function syncMobileFullscreenMode() {
    mobileFullscreenLocked = mobileChatQuery.matches;
    fsToggle?.toggleAttribute('hidden', mobileFullscreenLocked);
    if (mobileFullscreenLocked && !chat?.classList.contains('hidden')) setFullscreen(true);
  }

  mobileChatQuery.addEventListener?.('change', syncMobileFullscreenMode);
  syncMobileFullscreenMode();

  fsToggle?.addEventListener('click', () => setFullscreen(!fullscreen));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && fullscreen) setFullscreen(false);
  });

  function isOutputNearBottom() {
    if (!output) return true;
    return output.scrollHeight - output.scrollTop - output.clientHeight < 96;
  }

  function scrollToLatest({ force = false, behavior = 'smooth' } = {}) {
    if (!output || (!force && !followLatest)) return;
    window.requestAnimationFrame(() => {
      output.scrollTo({ top: output.scrollHeight, behavior });
      followLatest = true;
    });
  }

  output?.addEventListener('scroll', () => {
    followLatest = isOutputNearBottom();
  }, { passive: true });

  if (unlock && window.matchMedia('(pointer: fine)').matches) {
    unlock.addEventListener(
      'pointermove',
      (event) => {
        const rect = unlock.getBoundingClientRect();
        unlock.style.setProperty('--unlock-x', `${event.clientX - rect.left}px`);
        unlock.style.setProperty('--unlock-y', `${event.clientY - rect.top}px`);
      },
      { passive: true },
    );
  }

  function renderMessageState(element, state) {
    if (!element || !state) return;
    element.textContent = state.key ? t(state.key, state.vars) : state.raw;
  }

  function showAuthMessage(text, ok = false, fallbackKey = '') {
    if (!authMessage) return;
    authMessageState = describeGuestAiMessage(text, fallbackKey);
    renderMessageState(authMessage, authMessageState);
    authMessage.className = ok
      ? 'mt-4 text-center text-sm text-emerald-700'
      : 'mt-4 text-center text-sm text-red-600';
  }

  function showCodeSent(text) {
    codeSentState = describeGuestAiMessage(text, 'gemini.codeSent');
    renderMessageState(codeSent, codeSentState);
  }

  function clearAuthMessage() {
    authMessageState = null;
    authMessage?.classList.add('hidden');
    if (authMessage) authMessage.textContent = '';
  }

  function setBusy(button, busy, fallback) {
    if (!button) return;
    button.disabled = busy;
    if (busy) button.textContent = '…';
    else button.textContent = fallback;
  }

  function sanitizeRenderedMarkdown(markdown) {
    const template = document.createElement('template');
    const normalized = String(markdown || '')
      .replace(/^```(?:markdown|md)?\s*\n([\s\S]*?)\n```$/i, '$1')
      .replace(/\\([*_`~])/g, '$1')
      // CommonMark 不會解析 **粗體**後面緊接中文字母的情況。
      // 先轉成安全清理器允許的 strong，支援 Gemini 常見的中英混排輸出。
      .replace(/\*\*([^*\n]+?)\*\*(?=[\p{L}\p{N}])/gu, '<strong>$1</strong>');
    template.innerHTML = renderMarkdownWithMath(normalized);
    template.content
      .querySelectorAll('script, style, iframe, object, embed, form, input, button, textarea, select')
      .forEach((node) => node.remove());
    template.content.querySelectorAll('*').forEach((node) => {
      for (const attr of [...node.attributes]) {
        const name = attr.name.toLowerCase();
        const value = attr.value.trim().toLowerCase();
        if (name.startsWith('on') || name === 'style') node.removeAttribute(attr.name);
        if ((name === 'href' || name === 'src') && /^(javascript|data):/.test(value)) {
          node.removeAttribute(attr.name);
        }
      }
      if (node.tagName === 'A') {
        node.setAttribute('target', '_blank');
        node.setAttribute('rel', 'noopener noreferrer');
      }
    });
    return template.innerHTML;
  }

  function appendMessage(text, role = 'assistant') {
    const shouldFollow = followLatest || isOutputNearBottom();
    const line = document.createElement('div');
    line.className = `gemini-line gemini-line-${role}`;
    const bubble = document.createElement('div');
    bubble.className = 'gemini-bubble';
    if (role === 'assistant') {
      bubble.classList.add('wiki-content');
      if (isOpenAI) bubble.append(safeAnswer(text));
      else bubble.innerHTML = sanitizeRenderedMarkdown(text);
    } else {
      bubble.textContent = text;
    }
    line.appendChild(bubble);
    output?.appendChild(line);
    if (shouldFollow) scrollToLatest({ force: true });
    return bubble;
  }

  function startResponseTimer() {
    let seconds = 1;
    const elapsedKey = isOpenAI ? 'openai.elapsed' : 'gemini.elapsed';
    const bubble = appendMessage(t(elapsedKey, { n: seconds }), 'system');
    const timerId = window.setInterval(() => {
      seconds += 1;
      if (bubble) bubble.textContent = t(elapsedKey, { n: seconds });
    }, 1000);
    return {
      stop() {
        window.clearInterval(timerId);
        bubble?.parentElement?.remove();
      },
    };
  }

  function appendWelcome() {
    if (!output) return;
    output.innerHTML = '';
    followLatest = true;
    activeTopic = '';
    topicTurns = 0;
    showingDiscovery = false;
    discoveryTopics = [];
    appendTopicPicker();
  }

  function submitChoice(questionKey) {
    if (!chatInput || running) return;
    selectedQuestion = t(questionKey);
    chatInput.value = selectedQuestion;
    chatForm?.requestSubmit();
  }

  function appendTopicPicker(randomize = false) {
    if (!output) return;
    output.querySelectorAll('.gemini-suggestions, .gemini-next').forEach((node) => node.remove());
    const box = document.createElement('div');
    box.className = 'gemini-suggestions';
    const heading = document.createElement('h2');
    heading.className = 'gemini-choice-heading';
    heading.dataset.i18n = 'gemini.chooseTitle';
    heading.textContent = t('gemini.chooseTitle');
    const intro = document.createElement('p');
    intro.className = 'gemini-choice-intro';
    intro.dataset.i18n = 'gemini.welcomeMessage';
    intro.textContent = t('gemini.welcomeMessage');
    box.append(heading);
    if (!randomize) box.append(intro);
    showingDiscovery = randomize;
    if (randomize) {
      discoveryTopics = drawDiscoveryTopics(discoveryTopics.map((topic) => topic.id));
      heading.dataset.i18n = 'gemini.discoverTitle';
      heading.textContent = t('gemini.discoverTitle');
    }
    const examples = document.createElement('div');
    examples.className = 'gemini-choice-grid';
    (randomize ? discoveryTopics : GEMINI_TOPICS).forEach((topic) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'gemini-choice';
      if (randomize) {
        button.dataset.discovery = topic.id;
        const label = document.createElement('strong');
        const subject = document.createElement('span');
        button.append(label, subject);
        button.addEventListener('click', () => {
          if (running || !chatInput) return;
          activeTopic = ''; topicTurns = 0;
          selectedQuestion = discoveryQuestion(topic, getLocale() === 'en');
          chatInput.value = selectedQuestion;
          chatForm?.requestSubmit();
        });
        examples.appendChild(button);
        return;
      }
      button.dataset.topic = topic;
      for (const part of ['title', 'description']) {
        const text = document.createElement(part === 'title' ? 'strong' : 'span');
        const key = `gemini.entry.${topic}.${part}`;
        text.dataset.i18n = key;
        text.textContent = t(key);
        button.appendChild(text);
      }
      button.addEventListener('click', () => {
        if (running) return;
        activeTopic = topic;
        topicTurns = 0;
        submitChoice(`gemini.entry.${topic}.question`);
      });
      examples.appendChild(button);
    });
    box.appendChild(examples);
    box.appendChild(createChangeButton());
    output.appendChild(box);
    renderDiscoveryLabels();
    syncConversationControls();
  }

  function appendFollowups() {
    if (!output) return;
    output.querySelectorAll('.gemini-next').forEach((node) => node.remove());
    const group = document.createElement('div');
    group.className = 'gemini-next';
    group.setAttribute('role', 'group');
    group.dataset.i18nAria = 'gemini.followupTitle';
    group.setAttribute('aria-label', t('gemini.followupTitle'));
    const choices = topicTurns === 1 && activeTopic ? GEMINI_FOLLOWUPS[activeTopic] : ['prepare', 'examples'];
    choices.forEach((choice) => {
      const isTopic = GEMINI_TOPICS.includes(choice);
      const labelKey = isTopic ? `gemini.entry.${choice}.title` : `gemini.next.${choice}.label`;
      const questionKey = isTopic ? `gemini.entry.${choice}.question` : `gemini.next.${choice}.question`;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'gemini-followup';
      button.dataset.i18n = labelKey;
      button.textContent = t(labelKey);
      button.addEventListener('click', () => {
        if (running) return;
        if (isTopic) { activeTopic = choice; topicTurns = 0; }
        submitChoice(questionKey);
      });
      group.appendChild(button);
    });
    group.prepend(createChangeButton());
    output.appendChild(group);
  }

  function createChangeButton() {
    const change = document.createElement('button');
    change.type = 'button';
    change.className = 'gemini-change-topic';
    change.dataset.i18n = 'gemini.changeTopic';
    change.textContent = t('gemini.changeTopic');
    change.addEventListener('click', () => {
      if (running) return;
      appendTopicPicker(true);
      output.querySelector('.gemini-choice')?.focus({ preventScroll: true });
      window.requestAnimationFrame(() => {
        const picker = output.querySelector('.gemini-suggestions');
        if (picker) output.scrollTo({ top: picker.offsetTop - output.offsetTop, behavior: 'smooth' });
      });
    });
    return change;
  }

  function renderDiscoveryLabels() {
    if (!showingDiscovery) return;
    const language = getLocale() === 'en' ? 'en' : 'zh';
    output?.querySelectorAll('[data-discovery]').forEach((button) => {
      const topic = discoveryTopics.find((item) => item.id === button.dataset.discovery);
      if (!topic) return;
      button.querySelector('strong').textContent = topic.label[language];
      button.querySelector('span').textContent = topic.subject[language];
    });
  }

  function openChat(session, { preserveConversation = false } = {}) {
    unlock?.classList.add('hidden');
    chat?.classList.remove('hidden');
    syncMobileFullscreenMode();
    setFullscreen(mobileFullscreenLocked);
    if (identity) {
      identity.hidden = false;
      identity.textContent = `${session.name} · ${session.email}`;
    }
    if (!preserveConversation) {
      history = [];
      appendWelcome();
    }
    syncConversationControls();
    if (!mobileFullscreenLocked && preserveConversation) chatInput?.focus();
  }

  function openAnonymousChat() {
    unlock?.classList.add('hidden');
    chat?.classList.remove('hidden');
    syncMobileFullscreenMode();
    setFullscreen(mobileFullscreenLocked);
    if (identity) {
      identity.textContent = '';
      identity.hidden = true;
    }
    anonymousQuestionsUsed = 0;
    history = [];
    appendWelcome();
    syncConversationControls();
  }

  function openUnlock(nextMessage = '') {
    pendingPostAuthMessage = String(nextMessage || '').trim();
    mobileFullscreenLocked = false;
    setFullscreen(false);
    chat?.classList.add('hidden');
    unlock?.classList.remove('hidden');
    syncMobileFullscreenMode();
    profileForm?.classList.remove('hidden');
    codeForm?.classList.add('hidden');
  }

  profileForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearAuthMessage();
    const name = String(nameInput?.value || '').trim();
    const email = String(emailInput?.value || '').trim().toLowerCase();
    setBusy(sendCodeBtn, true, t('gemini.sendCode'));
    try {
      const result = await requestGuestAiCode({ name, email });
      pendingEmail = email;
      showCodeSent(result.message);
      profileForm.classList.add('hidden');
      codeForm?.classList.remove('hidden');
      codeInput?.focus();
    } catch (error) {
      showAuthMessage(error.message, false, 'gemini.errorSendCode');
    } finally {
      setBusy(sendCodeBtn, false, t('gemini.sendCode'));
    }
  });

  codeForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearAuthMessage();
    const code = String(codeInput?.value || '').trim();
    setBusy(verifyBtn, true, t('gemini.verify'));
    try {
      const result = await verifyGuestAiCode({ email: pendingEmail, code });
      const session = {
        token: result.token,
        name: result.name,
        email: result.email,
        expiresAt: result.expiresAt,
      };
      setGuestAiSession(session);
      const shouldResume = anonymousQuestionsUsed > 0;
      openChat(session, { preserveConversation: shouldResume });
      const queuedMessage = pendingPostAuthMessage;
      pendingPostAuthMessage = '';
      if (queuedMessage && chatInput) {
        chatInput.value = queuedMessage;
        window.requestAnimationFrame(() => chatForm?.requestSubmit());
      }
    } catch (error) {
      showAuthMessage(error.message, false, 'gemini.errorVerify');
    } finally {
      setBusy(verifyBtn, false, t('gemini.verify'));
    }
  });

  backBtn?.addEventListener('click', () => {
    clearAuthMessage();
    codeForm?.classList.add('hidden');
    profileForm?.classList.remove('hidden');
  });

  chatForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (running || (isOpenAI && !openaiAvailable)) return;
    const message = String(chatInput?.value || '').trim();
    if (!message) return;

    const verified = isOpenAI || Boolean(getGuestAiSession()?.token);
    if (!verified && anonymousQuestionsUsed >= ANONYMOUS_QUESTION_LIMIT) {
      openUnlock(message);
      return;
    }

    running = true;
    syncConversationControls();
    output?.querySelectorAll('.gemini-suggestions, .gemini-next').forEach((node) => node.remove());
    if (chatInput) {
      chatInput.value = '';
      chatInput.disabled = true;
    }
    if (chatSend) {
      chatSend.disabled = true;
      chatSend.textContent = t('gemini.sending');
    }
    followLatest = true;
    appendMessage(message, 'user');
    scrollToLatest({ force: true });
    const responseTimer = startResponseTimer();

    try {
      const requestMessage = prepareVisitorRequest(message, t('gemini.plainPreference'), selectedQuestion, history, getLocale() === 'en');
      const result = isOpenAI
        ? await askOpenAI(openaiApi, { message, history })
        : verified
        ? await askGuestGemini({ message: requestMessage, history, originalMessage: message })
        : await askGuestGeminiAnonymous({ message: requestMessage, history, originalMessage: message });
      responseTimer.stop();
      appendMessage(result.answer, 'assistant');
      if (isOpenAI) showOpenAIState(result.incomplete ? 'openai.incomplete' : '');
      if (!verified) anonymousQuestionsUsed += 1;
      if (result.kind === 'answer') {
        selectedQuestion = '';
        topicTurns += 1;
        history.push({ role: 'user', content: message });
        history.push({ role: 'assistant', content: result.answer });
        history = history.slice(-4);
      }
      if (result.kind === 'answer') appendFollowups();
    } catch (error) {
      responseTimer.stop();
      if (isOpenAI) {
        if (error.code === 'budget_exhausted') openaiAvailable = false;
        showOpenAIState(error.message);
        appendMessage(t(error.message), 'error');
        if (chatInput) chatInput.value = message;
        return;
      }
      const raw = error.message || '';
      const described = describeGuestAiMessage(raw);
      if (described.key === 'gemini.anonymousLimit') {
        openUnlock(message);
        showAuthMessage(raw, false, 'gemini.anonymousLimit');
      }
      const friendly =
        /暫時無法回應|暫時無法讀取|服務暫時發生錯誤/.test(raw)
          ? t('gemini.tempError')
          : described.key
            ? t(described.key, described.vars)
            : raw || t('gemini.tempError');
      if (described.key !== 'gemini.anonymousLimit') appendMessage(friendly, 'error');
      if (described.key === 'gemini.errorSessionExpired') openUnlock();
      if (chatInput) chatInput.value = message;
    } finally {
      running = false;
      syncConversationControls();
      if (!mobileFullscreenLocked && !chat?.classList.contains('hidden')) chatInput?.focus();
    }
  });

  document.addEventListener('wikinb:locale-change', () => {
    renderDiscoveryLabels();
    if (isOpenAI) showOpenAIState(openaiStateKey);
    renderMessageState(authMessage, authMessageState);
    renderMessageState(codeSent, codeSentState);
    syncConversationControls();
    // Dynamic choices have data-i18n attributes. Translate them in place;
    // rebuilding the welcome screen would erase pending or failed questions.
  });

  async function init() {
    if (isOpenAI) {
      openAnonymousChat();
      showOpenAIState('openai.checking');
      try {
        openaiAvailable = await checkOpenAI(openaiApi);
        showOpenAIState(openaiAvailable ? '' : 'openai.paused');
      } catch { showOpenAIState('openai.error.unavailable'); }
      syncConversationControls();
      return;
    }
    const session = getGuestAiSession();
    if (!session) {
      openAnonymousChat();
      return;
    }
    try {
      const me = await fetchGuestAiMe();
      openChat({ ...session, ...me });
    } catch {
      openAnonymousChat();
    }
  }

  void init();
</script>

