---
import BaseLayout from '../layouts/BaseLayout.astro';
import ManagementUploader from '../components/ManagementUploader.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="新增 Markdown"
  description="上傳 Markdown 到 WikiNB Management"
  pageClass="private-workspace-page"
  visitorNav={true}
>
  <div class="animate-fadeIn mx-auto max-w-2xl">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-pink-500" data-i18n="home.management">Management</p>
        <h1 class="mt-1 font-display text-3xl font-bold text-berry-800 md:text-4xl" data-i18n="manage.addTitle">上傳 Markdown</h1>
      </div>
      <a href={`${base}rename?tab=add`} class="btn-ghost shrink-0 text-sm" data-i18n="add.manage">管理筆記 →</a>
    </div>
    <ManagementUploader />
  </div>
</BaseLayout>
