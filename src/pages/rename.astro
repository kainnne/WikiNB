---
import BaseLayout from '../layouts/BaseLayout.astro';
import ManagementUploader from '../components/ManagementUploader.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Management"
  description="新增、整理與同步 WikiNB Markdown"
  pageClass="private-workspace-page"
  visitorNav={true}
>
  <div class="management-page animate-fadeIn mx-auto max-w-3xl">
    <div class="management-page-heading">
      <div>
        <p class="management-page-kicker">KAINNNE WORKSPACE</p>
        <h1>Management</h1>
      </div>
    </div>

    <div class="management-tabs" role="tablist" aria-label="Management">
      <button id="management-tab-add" type="button" class="management-tab" role="tab" aria-controls="management-add" data-management-tab="add" data-i18n="manage.tabAdd">新增內容</button>
      <button id="management-tab-library" type="button" class="management-tab" role="tab" aria-controls="management-library" data-management-tab="library" data-i18n="manage.tabLibrary">管理筆記</button>
    </div>

    <section id="management-add" class="management-workspace" role="tabpanel">
      <ManagementUploader />
    </section>

    <section id="management-library" class="management-workspace" role="tabpanel" hidden>
      <div class="management-library-heading">
        <div>
          <p class="management-uploader-kicker" data-i18n="manage.libraryKicker">現有內容</p>
          <h2 data-i18n="manage.title">管理筆記</h2>
        </div>
        <button id="btn-sync-wiki" type="button" class="btn-chroma-sync hidden">
          <span class="btn-chroma-sync-label" data-i18n="nav.sync">同步 Wiki</span>
        </button>
      </div>

      <div id="rename-gate" class="glass-card hidden p-6 text-center text-berry-700/80">
        <span data-i18n="manage.gate">請先登入後使用。</span>
        <a href={`${base}login`} class="ml-1 font-semibold text-pink-600" data-i18n="nav.login">登入</a>
      </div>

      <div id="rename-offline" class="glass-card hidden border border-amber-200 bg-amber-50/50 p-6 text-center text-amber-900">
        <span data-i18n="manage.offline">本機 Bridge 未連線。請確認 Mac 已開機且 Bridge 正在執行。</span>
      </div>

      <div id="rename-panel" class="hidden space-y-4">
        <p id="rename-status" class="text-sm text-berry-600/80"></p>
        <div id="rename-list" class="glass-card overflow-hidden"></div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    isLoggedIn,
    checkHealth,
    listWikiTree,
    updateWikiTitle,
    deleteWikiFile,
    renameWikiFile,
    replaceWikiNote,
    syncWiki,
  } from '../scripts/bridge-client.js';
  import { mountKeywordEditor } from '../scripts/keyword-chips.js';
  import { applyI18n, t } from '../scripts/i18n.js';

  const gate = document.getElementById('rename-gate');
  const offline = document.getElementById('rename-offline');
  const panel = document.getElementById('rename-panel');
  const listEl = document.getElementById('rename-list');
  const statusEl = document.getElementById('rename-status');
  const syncBtn = document.getElementById('btn-sync-wiki');
  const tabButtons = Array.from(document.querySelectorAll('[data-management-tab]'));
  const addWorkspace = document.getElementById('management-add');
  const libraryWorkspace = document.getElementById('management-library');
  const expandedDirs = new Set();
  /** @type {Map<string, ReturnType<typeof mountKeywordEditor>>} */
  const keywordEditors = new Map();

  function setManagementTab(tab, { updateUrl = true } = {}) {
    const active = tab === 'add' ? 'add' : 'library';
    if (addWorkspace) addWorkspace.hidden = active !== 'add';
    if (libraryWorkspace) libraryWorkspace.hidden = active !== 'library';
    for (const button of tabButtons) {
      const selected = button.getAttribute('data-management-tab') === active;
      button.classList.toggle('is-active', selected);
      button.setAttribute('aria-selected', selected ? 'true' : 'false');
      button.setAttribute('tabindex', selected ? '0' : '-1');
    }
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (active === 'library') url.searchParams.delete('tab');
      else url.searchParams.set('tab', active);
      window.history.replaceState({}, '', url);
    }
  }

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => setManagementTab(button.getAttribute('data-management-tab')));
  });
  setManagementTab(new URLSearchParams(window.location.search).get('tab'), { updateUrl: false });

  function escapeHtml(text) {
    return String(text ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function escapeAttr(text) {
    return escapeHtml(text).replace(/'/g, '&#39;');
  }

  function stemOf(slug) {
    const parts = String(slug || '').split('/').filter(Boolean);
    return parts[parts.length - 1] || '';
  }

  function folderOf(slug) {
    const parts = String(slug || '').split('/').filter(Boolean);
    if (parts.length <= 1) return '';
    return parts.slice(0, -1).join('/');
  }

  function isValidStem(stem) {
    return /^[\u4e00-\u9fffA-Za-z0-9_-]+$/.test(String(stem || '').trim());
  }

  function formatFolderKeyword(folderName) {
    const name = String(folderName || '').trim();
    if (!name) return '';
    if (/^[A-Z0-9]{2,6}$/.test(name)) return name;
    const spaced = name
      .replace(/([a-z\d])([A-Z])/g, '$1 $2')
      .replace(/[_-]+/g, ' ')
      .trim();
    const words = spaced.split(/\s+/).filter(Boolean);
    if (!words.length) return '';
    return words
      .map((w, i) =>
        i === 0 ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : w.toLowerCase(),
      )
      .join(' ');
  }

  function setStatus(text, isError = false) {
    if (!statusEl) return;
    statusEl.textContent = text;
    statusEl.classList.toggle('text-red-600', isError);
    statusEl.classList.toggle('text-berry-600/80', !isError);
  }

  function countFiles(nodes) {
    return (nodes || []).reduce(
      (n, node) => n + (node.type === 'dir' ? countFiles(node.children) : 1),
      0,
    );
  }

  function readMdFile(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = () => reject(new Error('讀取檔案失敗'));
      reader.readAsText(file);
    });
  }

  function isMdFile(file) {
    if (!file) return false;
    const name = String(file.name || '').toLowerCase();
    return name.endsWith('.md') || name.endsWith('.txt') || file.type === 'text/markdown' || file.type === 'text/plain';
  }

  function renderFileRow(node) {
    const slug = node.slug;
    const stem = stemOf(slug);
    const folder = folderOf(slug);
    const title = node.title || stem;
    const description = node.description || '';
    const pathAttr = escapeHtml(node.path || `${slug}.md`);
    const leaf = folder.split('/').filter(Boolean).pop() || '';
    const folderKw = formatFolderKeyword(leaf);

    return `
      <div class="rename-row border-t border-pink-100/80 p-4" data-slug="${escapeAttr(slug)}" data-path="${pathAttr}" data-folder="${escapeAttr(folder)}" data-folder-kw="${escapeAttr(folderKw)}" data-tags="${escapeAttr(JSON.stringify(node.tags || []))}">
        <label class="mb-1 block text-xs font-semibold text-berry-600/70" data-i18n="manage.filename">檔案名稱</label>
        <div class="mb-3 flex flex-wrap items-center gap-2">
          ${folder ? `<span class="text-xs font-semibold text-berry-600/60">${escapeHtml(folder)}/</span>` : ''}
          <input
            type="text"
            class="search-input rename-filename flex-1 py-2 text-sm"
            value="${escapeAttr(stem)}"
            spellcheck="false"
            autocomplete="off"
            aria-label="檔案名稱"
          />
          <span class="shrink-0 text-sm font-semibold text-berry-600/70">.md</span>
        </div>

        <label class="mb-1 block text-xs font-semibold text-berry-600/70" data-i18n="add.displayTitle">顯示標題</label>
        <div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-center">
          <input
            type="text"
            class="search-input rename-input flex-1 py-2 text-sm"
            value="${escapeAttr(title)}"
            autocomplete="off"
            aria-label="標題：${escapeAttr(title)}"
          />
        </div>
        <label class="mb-1 block text-xs font-semibold text-berry-600/70">
          <span data-i18n="manage.description">簡述</span>
        </label>
        <div class="mb-3">
          <input
            type="text"
            class="search-input rename-desc flex-1 py-2 text-sm"
            value="${escapeAttr(description)}"
            placeholder="例如：一個持續把想法做成作品的人。"
            data-i18n-placeholder="add.descriptionPlaceholder"
            autocomplete="off"
            aria-label="簡述"
          />
        </div>
        <label class="mb-1 block text-xs font-semibold text-berry-600/70">
          <span data-i18n="manage.keywords">關鍵字</span>
        </label>
        <div class="kw-mount mb-3" data-kw-mount="${escapeAttr(slug)}"></div>

        <div class="rename-drop mb-3 rounded-xl border border-dashed border-pink-200/90 bg-pink-50/30 px-3 py-3 text-center">
          <button type="button" class="btn-ghost rename-replace-pick px-3 py-1.5 text-xs" data-i18n="manage.replacePick">上傳覆蓋</button>
          <input type="file" class="rename-replace-input hidden" accept=".md,.txt,text/markdown,text/plain" />
        </div>

        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn-rename rename-save shrink-0 justify-center px-4 py-2 text-sm" data-i18n="manage.save">
            儲存
          </button>
          <button type="button" class="btn-delete rename-delete shrink-0 justify-center px-4 py-2 text-sm" data-i18n="manage.delete">
            刪除
          </button>
        </div>
        <p class="rename-msg mt-2 hidden text-sm"></p>
      </div>
    `;
  }

  function renderDir(node) {
    const open = expandedDirs.has(node.path);
    const notes = countFiles(node.children || []);
    return `
      <div class="manage-dir" data-dir="${escapeAttr(node.path)}">
        <button type="button" class="folder-row" data-dir-toggle="${escapeAttr(node.path)}" aria-expanded="${open}">
          <span class="folder-chevron${open ? ' is-open' : ''}">▸</span>
          <span class="folder-name">${escapeHtml(node.name)}</span>
          <span class="folder-count">${escapeHtml(t('manage.folderCount', { n: notes }))}</span>
        </button>
        <div class="folder-children${open ? '' : ' hidden'}"${open ? '' : ' hidden'}>
          ${renderNodes(node.children || [])}
        </div>
      </div>
    `;
  }

  function renderNodes(nodes) {
    const dirs = (nodes || []).filter((n) => n.type === 'dir');
    const files = (nodes || []).filter((n) => n.type !== 'dir');
    let html = dirs.map(renderDir).join('');
    if (files.length) {
      if (dirs.length) html += `<div class="root-group-label">${escapeHtml(t('search.rootNotes'))}</div>`;
      html += files.map(renderFileRow).join('');
    }
    return html;
  }

  function bindHandlers() {
    keywordEditors.forEach((ed) => ed?.destroy?.());
    keywordEditors.clear();

    listEl?.querySelectorAll('[data-dir-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dirPath = btn.getAttribute('data-dir-toggle');
        const children = btn.parentElement?.querySelector('.folder-children');
        const chevron = btn.querySelector('.folder-chevron');
        if (!children) return;
        const open = children.hidden;
        children.hidden = !open;
        children.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        chevron?.classList.toggle('is-open', open);
        if (open) expandedDirs.add(dirPath);
        else expandedDirs.delete(dirPath);
      });
    });

    listEl?.querySelectorAll('.rename-row').forEach((row) => {
      let currentSlug = row.getAttribute('data-slug') || '';
      const filePath = row.getAttribute('data-path');
      const folder = row.getAttribute('data-folder') || '';
      const folderKw = row.getAttribute('data-folder-kw') || '';
      let tags = [];
      try {
        tags = JSON.parse(row.getAttribute('data-tags') || '[]');
      } catch {
        tags = [];
      }
      const mount = row.querySelector('[data-kw-mount]');
      if (mount && currentSlug) {
        const editor = mountKeywordEditor(mount, {
          locked: folderKw ? [folderKw] : [],
          keywords: tags,
          composeOpen: true,
        });
        keywordEditors.set(currentSlug, editor);
      }

      const filenameInput = row.querySelector('.rename-filename');
      const input = row.querySelector('.rename-input');
      const descInput = row.querySelector('.rename-desc');
      const saveBtn = row.querySelector('.rename-save');
      const delBtn = row.querySelector('.rename-delete');
      const msg = row.querySelector('.rename-msg');
      const dropZone = row.querySelector('.rename-drop');
      const pickBtn = row.querySelector('.rename-replace-pick');
      const fileInput = row.querySelector('.rename-replace-input');

      const showMsg = (text, ok = false) => {
        if (!msg) return;
        msg.classList.remove('hidden');
        msg.textContent = text;
        msg.className = ok
          ? 'rename-msg mt-2 text-sm text-emerald-700'
          : 'rename-msg mt-2 text-sm text-red-600';
      };

      const replaceWithFile = async (file) => {
        if (!isMdFile(file)) {
          showMsg(t('manage.replaceNeedMd'));
          return;
        }
        if (!confirm(t('manage.replaceConfirm', { name: `${currentSlug}.md` }))) return;
        showMsg(t('manage.replacing'), true);
        try {
          const content = await readMdFile(file);
          const result = await replaceWikiNote({ slug: currentSlug, content, autoSync: true });
          showMsg(result.message || '已覆蓋', true);
          setStatus(result.message || `已覆蓋 ${currentSlug}`);
          await loadList();
        } catch (err) {
          showMsg(err.message || '覆蓋失敗');
        }
      };

      dropZone?.addEventListener('dragenter', (e) => {
        e.preventDefault();
        dropZone.classList.add('is-dragover');
      });
      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('is-dragover');
      });
      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('is-dragover');
      });
      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('is-dragover');
        const file = e.dataTransfer?.files?.[0];
        if (file) void replaceWithFile(file);
      });
      pickBtn?.addEventListener('click', () => fileInput?.click());
      fileInput?.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (file) void replaceWithFile(file);
        fileInput.value = '';
      });

      saveBtn?.addEventListener('click', async () => {
        const title = String(input?.value || '').trim();
        const description = String(descInput?.value || '').trim();
        const newStem = String(filenameInput?.value || '').trim();
        const editor = keywordEditors.get(currentSlug);
        const keywords = editor?.getExtras?.() || [];
        msg?.classList.remove('hidden');
        if (!title) {
          showMsg('標題不可空白');
          return;
        }
        if (!isValidStem(newStem)) {
          showMsg(t('manage.renameInvalid'));
          return;
        }

        const nextSlug = folder ? `${folder}/${newStem}` : newStem;
        saveBtn.disabled = true;
        saveBtn.textContent = '儲存中…';
        try {
          if (nextSlug !== currentSlug) {
            await renameWikiFile({ oldSlug: currentSlug, newSlug: nextSlug, autoSync: false });
            if (editor) {
              keywordEditors.delete(currentSlug);
              keywordEditors.set(nextSlug, editor);
            }
            currentSlug = nextSlug;
            row.setAttribute('data-slug', nextSlug);
            row.setAttribute('data-path', `${nextSlug}.md`);
          }
          const result = await updateWikiTitle({
            slug: currentSlug,
            title,
            description,
            keywords,
            autoSync: true,
          });
          showMsg(result.message || '已更新', true);
          setStatus(`剛更新：${title}`);
          await loadList();
        } catch (err) {
          showMsg(err.message || '更新失敗');
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = t('manage.save');
        }
      });

      delBtn?.addEventListener('click', async () => {
        if (!confirm(`確定刪除 ${filePath}？`)) return;
        msg?.classList.remove('hidden');
        delBtn.disabled = true;
        delBtn.textContent = '刪除中…';
        try {
          const result = await deleteWikiFile({ path: filePath || currentSlug, autoSync: true });
          showMsg(result.message || '已刪除', true);
          setStatus(`已刪除 ${stemOf(currentSlug)}`);
          await loadList();
        } catch (err) {
          showMsg(err.message || '刪除失敗');
        } finally {
          delBtn.disabled = false;
          delBtn.textContent = t('manage.delete');
        }
      });
    });
  }

  function renderTree(tree) {
    keywordEditors.forEach((ed) => ed.destroy?.());
    keywordEditors.clear();
    if (!listEl) return;
    if (!tree?.length) {
      listEl.innerHTML = `<div class="p-6 text-center text-berry-700/80">${escapeHtml(t('search.emptyAll'))}</div>`;
      return;
    }
    listEl.innerHTML = renderNodes(tree);
    applyI18n(listEl);
    bindHandlers();
  }

  async function loadList() {
    const data = await listWikiTree();
    const tree = data.tree || [];
    renderTree(tree);
    setStatus(t('manage.fileCount', { n: countFiles(tree) }));
  }

  async function init() {
    if (!isLoggedIn()) {
      gate?.classList.remove('hidden');
      return;
    }
    const health = await checkHealth();
    if (!health.online) {
      offline?.classList.remove('hidden');
      return;
    }
    panel?.classList.remove('hidden');
    syncBtn?.classList.remove('hidden');
    try {
      await loadList();
    } catch (err) {
      setStatus(err.message || '無法載入列表', true);
    }
  }

  syncBtn?.addEventListener('click', async () => {
    const label = syncBtn.querySelector('.btn-chroma-sync-label');
    syncBtn.setAttribute('disabled', 'true');
    if (label) label.textContent = '同步中…';
    setStatus('正在同步 wiki/ …');
    try {
      const result = await syncWiki();
      setStatus(result.message || '同步完成');
      await loadList();
    } catch (err) {
      setStatus(err.message || '同步失敗', true);
    } finally {
      syncBtn.removeAttribute('disabled');
      if (label) label.textContent = t('nav.sync');
    }
  });

  init();
  document.addEventListener('wikinb:management-updated', () => void loadList());
  document.addEventListener('wikinb:locale-change', () => {
    if (panel && !panel.classList.contains('hidden')) void loadList();
  });
</script>

<style>
  .management-page {
    padding-bottom: 3rem;
  }

  .management-page-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.35rem;
  }

  .management-page-kicker,
  .management-uploader-kicker {
    color: #d05d92;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .management-page-heading h1 {
    margin-top: 0.2rem;
    color: transparent;
    background: linear-gradient(105deg, #8a68d8, #d05d92 58%, #4eb9aa);
    background-clip: text;
    -webkit-background-clip: text;
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: clamp(2.15rem, 7vw, 3.65rem);
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .management-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    padding: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.42);
    box-shadow: 0 16px 42px rgba(103, 59, 94, 0.09), inset 0 1px rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(22px) saturate(1.25);
  }

  .management-tab {
    min-height: 3.1rem;
    border: 1px solid transparent;
    border-radius: 1rem;
    background: transparent;
    color: rgba(95, 60, 84, 0.72);
    font-family: Quicksand, 'Noto Sans TC', sans-serif;
    font-size: 0.84rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .management-tab.is-active {
    border-color: rgba(255, 255, 255, 0.84);
    background: linear-gradient(120deg, rgba(218, 205, 255, 0.72), rgba(255, 183, 206, 0.78), rgba(201, 255, 240, 0.68));
    color: #542944;
    box-shadow: 0 9px 24px rgba(156, 78, 143, 0.13), inset 0 1px rgba(255, 255, 255, 0.84);
  }

  .management-tab:hover,
  .management-tab:focus-visible {
    transform: translateY(-1px);
    outline: none;
  }

  .management-workspace[hidden] {
    display: none !important;
  }

  .management-library-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 0.2rem;
  }

  .management-library-heading h2 {
    margin-top: 0.2rem;
    color: #4a2038;
    font-family: Comfortaa, Quicksand, 'Noto Sans TC', sans-serif;
    font-size: clamp(1.45rem, 4vw, 2rem);
    font-weight: 700;
  }

  .btn-chroma-sync {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.84);
    padding: 0.45rem 1rem;
    font-weight: 800;
    font-size: 0.875rem;
    cursor: pointer;
    background: linear-gradient(120deg, rgba(218, 205, 255, 0.82), rgba(255, 183, 206, 0.88), rgba(201, 255, 240, 0.78));
    box-shadow: 0 10px 24px rgba(156, 78, 143, 0.14), inset 0 1px rgba(255, 255, 255, 0.82);
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
  }

  .btn-chroma-sync-label {
    position: relative;
    z-index: 2;
    letter-spacing: 0.02em;
    color: #542944;
  }

  .btn-chroma-sync:hover:not(:disabled),
  .btn-chroma-sync:focus-visible:not(:disabled) {
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 12px 26px rgba(123, 97, 255, 0.25);
    outline: none;
  }

  .btn-chroma-sync:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media (max-width: 560px) {
    .management-page-heading {
      align-items: flex-start;
    }

    .management-library-heading {
      align-items: center;
    }
