---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="管理筆記" description="修改標題與刪除 wiki 筆記">
  <div class="animate-fadeIn mx-auto max-w-2xl">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <h1 class="font-display text-3xl font-bold text-berry-800 md:text-4xl">管理筆記</h1>
      <div class="flex flex-wrap items-center gap-2">
        <button id="btn-sync-wiki" type="button" class="btn-chroma-sync hidden">
          <span class="btn-chroma-sync-label">同步 Wiki</span>
        </button>
        <a href={base} class="btn-ghost shrink-0 text-sm">← 首頁</a>
      </div>
    </div>

    <div id="rename-gate" class="glass-card hidden p-6 text-center text-berry-700/80">
      請先 <a href={`${base}login`} class="font-semibold text-pink-600">登入</a> 後使用。
    </div>

    <div id="rename-offline" class="glass-card hidden border border-amber-200 bg-amber-50/50 p-6 text-center text-amber-900">
      本機 Bridge 未連線。請確認 Mac 已開機且 Bridge 正在執行。
    </div>

    <div id="rename-panel" class="hidden space-y-4">
      <p id="rename-status" class="text-sm text-berry-600/80"></p>
      <div id="rename-list" class="glass-card overflow-hidden"></div>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    isLoggedIn,
    checkHealth,
    listWikiTree,
    updateWikiTitle,
    deleteWikiFile,
    syncWiki,
  } from '../scripts/bridge-client.js';

  const gate = document.getElementById('rename-gate');
  const offline = document.getElementById('rename-offline');
  const panel = document.getElementById('rename-panel');
  const listEl = document.getElementById('rename-list');
  const statusEl = document.getElementById('rename-status');
  const syncBtn = document.getElementById('btn-sync-wiki');
  const expandedDirs = new Set();

  function escapeHtml(text) {
    return String(text ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function escapeAttr(text) {
    return escapeHtml(text).replace(/'/g, '&#39;');
  }

  function stemOf(slug) {
    const parts = String(slug || '').split('/').filter(Boolean);
    return parts[parts.length - 1] || '';
  }

  function folderOf(slug) {
    const parts = String(slug || '').split('/').filter(Boolean);
    if (parts.length <= 1) return '';
    return parts.slice(0, -1).join('/');
  }

  function formatFolderKeyword(folderName) {
    const name = String(folderName || '').trim();
    if (!name) return '';
    if (/^[A-Z0-9]{2,6}$/.test(name)) return name;
    const spaced = name
      .replace(/([a-z\d])([A-Z])/g, '$1 $2')
      .replace(/[_-]+/g, ' ')
      .trim();
    const words = spaced.split(/\s+/).filter(Boolean);
    if (!words.length) return '';
    return words
      .map((w, i) =>
        i === 0 ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : w.toLowerCase(),
      )
      .join(' ');
  }

  function setStatus(text, isError = false) {
    if (!statusEl) return;
    statusEl.textContent = text;
    statusEl.classList.toggle('text-red-600', isError);
    statusEl.classList.toggle('text-berry-600/80', !isError);
  }

  function countFiles(nodes) {
    return (nodes || []).reduce(
      (n, node) => n + (node.type === 'dir' ? countFiles(node.children) : 1),
      0,
    );
  }

  function renderFileRow(node) {
    const slug = node.slug;
    const stem = stemOf(slug);
    const folder = folderOf(slug);
    const title = node.title || stem;
    const pathAttr = escapeHtml(node.path || `${slug}.md`);
    const leaf = folder.split('/').filter(Boolean).pop() || '';
    const folderKw = formatFolderKeyword(leaf);
    const metaBits = [
      folder ? `<span class="text-xs text-berry-600/60">${escapeHtml(folder)}/</span>` : '',
      `<span class="tag-badge">${escapeHtml(stem)}.md</span>`,
      folderKw ? `<span class="tag-badge">${escapeHtml(folderKw)}</span>` : '',
    ].filter(Boolean).join('');

    return `
      <div class="rename-row border-t border-pink-100/80 p-4" data-slug="${escapeAttr(slug)}" data-path="${pathAttr}">
        <div class="mb-2 flex flex-wrap items-center gap-2">
          ${metaBits}
        </div>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
          <input
            type="text"
            class="search-input rename-input flex-1 py-2 text-sm"
            value="${escapeAttr(title)}"
            autocomplete="off"
            aria-label="標題：${escapeAttr(title)}"
          />
          <button type="button" class="btn-rename rename-save shrink-0 justify-center px-4 py-2 text-sm">
            儲存標題
          </button>
          <button type="button" class="btn-delete rename-delete shrink-0 justify-center px-4 py-2 text-sm">
            刪除
          </button>
        </div>
        <p class="rename-msg mt-2 hidden text-sm"></p>
      </div>
    `;
  }

  function renderDir(node) {
    const open = expandedDirs.has(node.path);
    const notes = countFiles(node.children || []);
    return `
      <div class="manage-dir" data-dir="${escapeAttr(node.path)}">
        <button type="button" class="folder-row" data-dir-toggle="${escapeAttr(node.path)}" aria-expanded="${open}">
          <span class="folder-chevron${open ? ' is-open' : ''}">▸</span>
          <span class="folder-name">${escapeHtml(node.name)}</span>
          <span class="folder-count">${notes} 篇</span>
        </button>
        <div class="folder-children${open ? '' : ' hidden'}"${open ? '' : ' hidden'}>
          ${renderNodes(node.children || [])}
        </div>
      </div>
    `;
  }

  function renderNodes(nodes) {
    const dirs = (nodes || []).filter((n) => n.type === 'dir');
    const files = (nodes || []).filter((n) => n.type !== 'dir');
    let html = dirs.map(renderDir).join('');
    if (files.length) {
      if (dirs.length) html += '<div class="root-group-label">根目錄</div>';
      html += files.map(renderFileRow).join('');
    }
    return html;
  }

  function bindHandlers() {
    listEl?.querySelectorAll('[data-dir-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dirPath = btn.getAttribute('data-dir-toggle');
        const children = btn.parentElement?.querySelector('.folder-children');
        const chevron = btn.querySelector('.folder-chevron');
        if (!children) return;
        const open = children.hidden;
        children.hidden = !open;
        children.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        chevron?.classList.toggle('is-open', open);
        if (open) expandedDirs.add(dirPath);
        else expandedDirs.delete(dirPath);
      });
    });

    listEl?.querySelectorAll('.rename-row').forEach((row) => {
      const oldSlug = row.getAttribute('data-slug');
      const filePath = row.getAttribute('data-path');
      const input = row.querySelector('.rename-input');
      const saveBtn = row.querySelector('.rename-save');
      const delBtn = row.querySelector('.rename-delete');
      const msg = row.querySelector('.rename-msg');

      saveBtn?.addEventListener('click', async () => {
        const title = String(input?.value || '').trim();
        msg?.classList.remove('hidden');
        if (!title) {
          if (msg) {
            msg.textContent = '標題不可空白';
            msg.className = 'rename-msg mt-2 text-sm text-red-600';
          }
          return;
        }

        saveBtn.disabled = true;
        saveBtn.textContent = '儲存中…';
        try {
          const result = await updateWikiTitle({ slug: oldSlug, title, autoSync: true });
          if (msg) {
            msg.textContent = result.message || '已更新標題';
            msg.className = 'rename-msg mt-2 text-sm text-emerald-700';
          }
          setStatus(`剛更新標題：${title}`);
          await loadList();
        } catch (err) {
          if (msg) {
            msg.textContent = err.message || '更新標題失敗';
            msg.className = 'rename-msg mt-2 text-sm text-red-600';
          }
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = '儲存標題';
        }
      });

      delBtn?.addEventListener('click', async () => {
        if (!confirm(`確定刪除 ${filePath}？`)) return;
        msg?.classList.remove('hidden');
        delBtn.disabled = true;
        delBtn.textContent = '刪除中…';
        try {
          const result = await deleteWikiFile({ path: filePath || oldSlug, autoSync: true });
          if (msg) {
            msg.textContent = result.message || '已刪除';
            msg.className = 'rename-msg mt-2 text-sm text-emerald-700';
          }
          setStatus(`已刪除 ${stemOf(oldSlug)}`);
          await loadList();
        } catch (err) {
          if (msg) {
            msg.textContent = err.message || '刪除失敗';
            msg.className = 'rename-msg mt-2 text-sm text-red-600';
          }
        } finally {
          delBtn.disabled = false;
          delBtn.textContent = '刪除';
        }
      });
    });
  }

  function renderTree(tree) {
    if (!listEl) return;
    if (!tree?.length) {
      listEl.innerHTML = '<div class="p-6 text-center text-berry-700/80">目前沒有可管理的筆記。</div>';
      return;
    }
    listEl.innerHTML = renderNodes(tree);
    bindHandlers();
  }

  async function loadList() {
    const data = await listWikiTree();
    const tree = data.tree || [];
    renderTree(tree);
    setStatus(`共 ${countFiles(tree)} 個檔案`);
  }

  async function init() {
    if (!isLoggedIn()) {
      gate?.classList.remove('hidden');
      return;
    }
    const health = await checkHealth();
    if (!health.online) {
      offline?.classList.remove('hidden');
      return;
    }
    panel?.classList.remove('hidden');
    syncBtn?.classList.remove('hidden');
    try {
      await loadList();
    } catch (err) {
      setStatus(err.message || '無法載入列表', true);
    }
  }

  syncBtn?.addEventListener('click', async () => {
    const label = syncBtn.querySelector('.btn-chroma-sync-label');
    syncBtn.setAttribute('disabled', 'true');
    if (label) label.textContent = '同步中…';
    setStatus('正在同步 wiki/ …');
    try {
      const result = await syncWiki();
      setStatus(result.message || '同步完成');
      await loadList();
    } catch (err) {
      setStatus(err.message || '同步失敗', true);
    } finally {
      syncBtn.removeAttribute('disabled');
      if (label) label.textContent = '同步 Wiki';
    }
  });

  init();
</script>

<style>
  .btn-chroma-sync {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid transparent;
    padding: 0.45rem 1rem;
    font-weight: 800;
    font-size: 0.875rem;
    cursor: pointer;
    background:
      linear-gradient(#111111, #111111) padding-box,
      linear-gradient(120deg, #4285f4, #9b72cb, #d96570, #fbbc05, #34a853, #4285f4) border-box;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
  }

  .btn-chroma-sync::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(
      120deg,
      rgba(66, 133, 244, 0.12),
      rgba(155, 114, 203, 0.14),
      rgba(217, 101, 112, 0.1),
      rgba(251, 188, 5, 0.1),
      rgba(52, 168, 83, 0.1)
    );
  }

  .btn-chroma-sync-label {
    position: relative;
    z-index: 2;
    letter-spacing: 0.02em;
    background: linear-gradient(105deg, #6ea8ff 0%, #b794ff 40%, #ff8fab 70%, #5eead4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .btn-chroma-sync:hover:not(:disabled),
  .btn-chroma-sync:focus-visible:not(:disabled) {
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 12px 26px rgba(123, 97, 255, 0.25);
    outline: none;
  }

  .btn-chroma-sync:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  :global(#rename-list .btn-rename) {
    @apply inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-teal-400 to-cyan-500 px-5 py-2 font-display font-semibold text-white shadow-[0_0_16px_rgba(45,212,191,0.3)] transition-all hover:scale-[1.02] hover:from-teal-300 hover:to-cyan-400 disabled:cursor-not-allowed disabled:opacity-50;
  }

  :global(#rename-list .btn-delete) {
    @apply inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-5 py-2 font-display font-semibold text-red-700 transition-all hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-50;
  }

  :global(#rename-list .folder-row) {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    text-align: left;
    font-weight: 700;
    color: #5c2a4a;
    border-bottom: 1px solid rgba(252, 231, 243, 0.9);
    background: linear-gradient(90deg, rgba(252, 231, 243, 0.45), transparent);
  }

  :global(#rename-list .folder-chevron) {
    display: inline-block;
    width: 1rem;
    color: #ec407a;
    transition: transform 0.2s ease;
  }

  :global(#rename-list .folder-chevron.is-open) {
    transform: rotate(90deg);
  }

  :global(#rename-list .folder-name) {
    flex: 1;
    min-width: 0;
  }

  :global(#rename-list .folder-count) {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(107, 58, 107, 0.55);
  }

  :global(#rename-list .folder-children) {
    border-left: 2px solid rgba(244, 143, 177, 0.35);
    margin-left: 1rem;
  }

  :global(#rename-list .root-group-label) {
    padding: 0.65rem 1rem 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(107, 58, 107, 0.55);
    text-transform: uppercase;
  }
</style>
