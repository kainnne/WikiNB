---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicDreamBackdrop from '../../components/PublicDreamBackdrop.astro';
import { getAllWikiPages, getWikiPage, encodeWikiSlug } from '../../lib/wiki';

export function getStaticPaths() {
  return getAllWikiPages().map((page) => ({
    params: { slug: page.slug },
  }));
}

const page = getWikiPage(Astro.params.slug);
const base = import.meta.env.BASE_URL;

if (!page) {
  return Astro.redirect(`${base}404`);
}

const allPages = getAllWikiPages();
const related = allPages
  .filter((p) => p.slug !== page.slug && p.tags.some((t) => page.tags.includes(t)))
  .slice(0, 3);
---

<BaseLayout
  title={page.title}
  description={page.description}
  pageClass="public-wiki-page"
  visitorNav={true}
>
  <PublicDreamBackdrop />
  <article class="animate-fadeIn wiki-page">
    <div id="wiki-reader" class="wiki-reader">
      <div class="wiki-reader-titlebar">
        <span class="wiki-reader-label">{page.title}</span>
        <div class="wiki-reader-actions">
          <button
            id="wiki-copy-link"
            type="button"
            class="wiki-fs-btn wiki-copy-btn"
            aria-label="複製連結"
            title="複製連結"
          >
            <span class="wiki-copy-label">copy</span>
          </button>
          <button
            id="wiki-fs-toggle"
            type="button"
            class="wiki-fs-btn"
            aria-label="放大視窗"
            title="放大"
          >
            <span class="wiki-fs-icon" aria-hidden="true">⛶</span>
          </button>
        </div>
      </div>

      <div class="wiki-reader-scroll">
        <header class="mb-6 px-1 sm:mb-8">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <time class="text-sm font-semibold text-pink-500">{page.date}</time>
            {page.updated && (
              <span class="text-xs text-berry-600/60" data-i18n="wiki.updated" data-i18n-date={page.updated}
                >更新於 {page.updated}</span
              >
            )}
            {page.tags.map((tag) => (
              <a
                href={`${base}search?q=${encodeURIComponent(tag)}`}
                class="tag-badge hover:bg-pink-200"
                data-keyword={tag}
              >
                {tag}
              </a>
            ))}
          </div>
          <h1 class="font-display text-3xl font-bold text-berry-800 md:text-4xl">{page.title}</h1>
          {page.description && (
            <p class="mt-3 text-lg text-berry-700/80">{page.description}</p>
          )}
        </header>

        <div class="glass-card wiki-content p-6 md:p-10" set:html={page.html} />
      </div>
    </div>

    {related.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-4 font-display text-xl font-bold text-berry-800" data-i18n="wiki.related">相關筆記</h2>
        <div class="grid gap-3 sm:grid-cols-3">
          {related.map((r) => (
            <a href={`${base}wiki/${encodeWikiSlug(r.slug)}`} class="glass-card-hover block p-4">
              <h3 class="font-display font-bold text-berry-800">{r.title}</h3>
              <p class="mt-1 line-clamp-2 text-sm text-berry-700/70">{r.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="mt-8">
      <a href={`${base}search`} class="btn-ghost">← 回到 WikiNB</a>
    </div>
  </article>
</BaseLayout>

<script>
  const reader = document.getElementById('wiki-reader');
  const fsToggle = document.getElementById('wiki-fs-toggle');
  const fsIcon = fsToggle?.querySelector('.wiki-fs-icon');
  const copyBtn = document.getElementById('wiki-copy-link');
  const copyLabel = copyBtn?.querySelector('.wiki-copy-label');
  let fullscreen = false;

  function noteShareUrl() {
    const url = new URL(window.location.href);
    url.search = '';
    url.hash = '';
    if (!url.pathname.endsWith('/')) url.pathname += '/';
    return url.href;
  }

  async function copyNoteLink() {
    const text = noteShareUrl();
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
    if (copyLabel) {
      const prev = copyLabel.textContent;
      copyLabel.textContent = 'copied';
      copyBtn?.setAttribute('title', '已複製');
      window.setTimeout(() => {
        copyLabel.textContent = prev || 'copy';
        copyBtn?.setAttribute('title', '複製連結');
      }, 1400);
    }
  }

  function syncFsParam(on) {
    const url = new URL(window.location.href);
    if (on) url.searchParams.set('fs', '1');
    else url.searchParams.delete('fs');
    window.history.replaceState({}, '', url);
  }

  function setFullscreen(on, { syncUrl = true } = {}) {
    fullscreen = Boolean(on);
    reader?.classList.toggle('is-fullscreen', fullscreen);
    document.documentElement.classList.toggle('wiki-fs-active', fullscreen);
    document.body.classList.toggle('wiki-fs-active', fullscreen);
    if (fsToggle) {
      fsToggle.setAttribute('aria-label', fullscreen ? '還原視窗' : '放大視窗');
      fsToggle.title = fullscreen ? '還原' : '放大';
    }
    if (fsIcon) fsIcon.textContent = fullscreen ? '❐' : '⛶';
    if (syncUrl) syncFsParam(fullscreen);
  }

  copyBtn?.addEventListener('click', () => {
    void copyNoteLink();
  });
  fsToggle?.addEventListener('click', () => setFullscreen(!fullscreen));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && fullscreen) setFullscreen(false);
  });

  // 從 WikiNB 字卡放大鈕進來：/?fs=1 → 直接全螢幕
  if (new URLSearchParams(window.location.search).get('fs') === '1') {
    setFullscreen(true, { syncUrl: false });
  }
</script>

<style is:global>
  .public-wiki-page .wiki-page {
    width: min(100%, 68rem);
    margin-inline: auto;
  }

  .wiki-page .wiki-reader {
    position: relative;
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.78);
    background: rgba(255, 255, 255, 0.42);
    box-shadow:
      0 28px 82px rgba(103, 59, 94, 0.14),
      inset 0 1px rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(26px) saturate(1.28);
  }

  .wiki-page .wiki-reader-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3.75rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.62);
    background: linear-gradient(100deg, rgba(218, 205, 255, 0.22), rgba(255, 206, 226, 0.2), rgba(201, 255, 240, 0.18));
  }

  @media (min-width: 640px) {
    .wiki-page .wiki-reader-titlebar {
      padding: 0.65rem 1rem;
    }
  }

  .wiki-page .wiki-reader-label {
    min-width: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: #4a2038;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wiki-page .wiki-reader-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .wiki-page .wiki-fs-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.74);
    background: rgba(255, 255, 255, 0.48);
    color: #7d4b70;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .wiki-page .wiki-copy-btn {
    width: auto;
    min-width: 2rem;
    padding: 0 0.45rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .wiki-page .wiki-fs-btn:hover,
  .wiki-page .wiki-fs-btn:focus-visible {
    background: linear-gradient(120deg, rgba(218, 205, 255, 0.58), rgba(255, 206, 226, 0.58));
    transform: translateY(-0.12rem);
    box-shadow:
      0 8px 20px rgba(103, 59, 94, 0.12),
      inset 0 1px rgba(255, 255, 255, 0.78);
    outline: none;
  }

  .wiki-page .wiki-reader-scroll {
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  @media (min-width: 640px) {
    .wiki-page .wiki-reader-scroll {
      padding: clamp(1.4rem, 3vw, 2.2rem);
    }
  }

  .wiki-page .wiki-reader.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 200;
    width: 100%;
    height: 100%;
    height: 100dvh;
    max-height: 100dvh;
    border-radius: 0;
    border: 0;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(circle at 10% 18%, rgba(205, 220, 255, 0.74), transparent 30%),
      radial-gradient(circle at 90% 12%, rgba(255, 210, 232, 0.74), transparent 31%),
      linear-gradient(145deg, #fffafd 0%, #fff4fa 48%, #f7f2ff 100%);
  }

  .wiki-page .wiki-reader.is-fullscreen .wiki-reader-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1rem 1rem 1.5rem;
  }

  @media (min-width: 640px) {
    .wiki-page .wiki-reader.is-fullscreen .wiki-reader-scroll {
      padding: 1.25rem 1.5rem 2rem;
    }
  }

  .wiki-page .wiki-reader.is-fullscreen .wiki-reader-label {
    font-size: 0.95rem;
  }

  html.wiki-fs-active,
  body.wiki-fs-active {
    overflow: hidden;
  }

  .public-wiki-page .wiki-reader-scroll > header {
    padding: clamp(0.5rem, 2vw, 1rem) clamp(0.25rem, 1vw, 0.6rem) clamp(0.75rem, 2vw, 1.25rem);
  }

  .public-wiki-page .wiki-reader-scroll > header h1 {
    color: #4a2038;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .public-wiki-page .wiki-reader-scroll > header > p {
    color: rgba(74, 32, 56, 0.7);
    line-height: 1.7;
  }

  .public-wiki-page .wiki-reader-scroll .tag-badge {
    border: 1px solid rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.42);
    color: #9c426f;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.7);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .public-wiki-page .wiki-reader-scroll .tag-badge:hover,
  .public-wiki-page .wiki-reader-scroll .tag-badge:focus-visible,
  .public-wiki-page .wiki-reader-scroll .tag-badge:active {
    background: linear-gradient(120deg, rgba(255, 206, 226, 0.42), rgba(218, 205, 255, 0.38));
    transform: translateY(-0.1rem);
  }

  .public-wiki-page .wiki-reader-scroll > .wiki-content {
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 1.65rem;
    background: rgba(255, 255, 255, 0.52);
    box-shadow:
      0 18px 48px rgba(103, 59, 94, 0.08),
      inset 0 1px rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(18px) saturate(1.2);
  }

  .public-wiki-page .wiki-page > section > h2 {
    color: #4a2038;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    letter-spacing: -0.035em;
  }

  .public-wiki-page .wiki-page > section .glass-card-hover {
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.42);
    box-shadow:
      0 16px 42px rgba(103, 59, 94, 0.09),
      inset 0 1px rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(18px) saturate(1.2);
  }

  .public-wiki-page .wiki-page > section .glass-card-hover:hover,
  .public-wiki-page .wiki-page > section .glass-card-hover:focus-visible,
  .public-wiki-page .wiki-page > section .glass-card-hover:active {
    border-color: rgba(255, 255, 255, 0.94);
    background: linear-gradient(125deg, rgba(255, 206, 226, 0.3), rgba(218, 205, 255, 0.28));
    box-shadow:
      0 24px 58px rgba(103, 59, 94, 0.14),
      inset 0 1px rgba(255, 255, 255, 0.82);
  }

  .public-wiki-page .wiki-page > div:last-child .btn-ghost {
    min-height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.44);
    box-shadow:
      0 12px 32px rgba(103, 59, 94, 0.09),
      inset 0 1px rgba(255, 255, 255, 0.72);
  }

  .public-wiki-page .wiki-page > div:last-child .btn-ghost:hover,
  .public-wiki-page .wiki-page > div:last-child .btn-ghost:focus-visible {
    background: linear-gradient(120deg, rgba(255, 206, 226, 0.38), rgba(218, 205, 255, 0.34));
  }

  @media (max-width: 640px) {
    .wiki-page .wiki-reader {
      border-radius: 1.55rem;
    }

    .wiki-page .wiki-reader-scroll {
      padding: 0.8rem;
    }

    .public-wiki-page .wiki-reader-scroll > .wiki-content {
      border-radius: 1.25rem;
      padding: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wiki-page .wiki-fs-btn,
    .public-wiki-page .wiki-reader-scroll .tag-badge,
    .public-wiki-page .wiki-page > section .glass-card-hover {
      transition-duration: 0.001ms !important;
    }
  }
</style>
