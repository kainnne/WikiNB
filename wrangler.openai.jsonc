{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kainnne-openai",
  "main": "worker/openai.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://wikinb.kainnne.com,https://kainnne.github.io,http://localhost:4321",
    "WIKI_SEARCH_URL": "https://wikinb.kainnne.com/search/",
    "DEMO_ENABLED": "true",
    "DEMO_BUDGET_MICROUSD": "10000000"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "wikinb-guest-ai",
    "database_id": "54ba9cb8-d32d-4259-a626-284b93d53283"
  }]
}
